["events"] = "CLEU:SPELL_CAST_SUCCESS BLP_ECHOED_ARCANE_EXPLOSION BLP_ORB_BARRAGE BLP_ENERGY_RECONSTITUTION BLP_INTUITION_AURA_APPLIED BLP_INTUITION_AURA_REMOVED BLP_INTUITION_RESET BLP_INIT",
