["events"] = "",
["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        for i = 1, 3 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 10,\n                expirationTime = GetTime() + 7 + i,\n                num = i,\n                autoHide = true\n            }\n        end\n    elseif event == \"STATUS\" then\n        if AuraUpdater then AuraUpdater:UpdateAnchorSettings(\"Bars\") end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 0.1,\n            expirationTime = GetTime() + 0.1,\n            autoHide = true\n        }\n        \n        return true\n    end\nend",
