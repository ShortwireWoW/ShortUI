["DnD - LootGoblin"] = {
["parent"] = "Drunk 'n Disorderly - WA Group",
["customText"] = "function()\n    local now = GetTime()\n    local total = GetNumGroupMembers()\n    if total == 0 then\n        return \"|cffffcc00Not in raid...|r\"\n    end\n    \n    local scanned = 0\n    \n    for i = 1, total do\n        local unit = \"raid\"..i\n        local guid = UnitGUID(unit)\n        \n        if guid and aura_env.lastScan[guid] then\n            local timeSince = now - aura_env.lastScan[guid].timeStamp\n            if timeSince < aura_env.scanInterval then\n                scanned = scanned + 1\n            end\n        end\n    end\n    \n    local colorScanned = (scanned == total) and \"|cff00ff00\" or \"|cffff0000\"\n    local colorLabel = \"|cffffff00\"\n    \n    return string.format(\"%sPlayers Scanned: %s%d/%d|r\", colorLabel, colorScanned, scanned, total)\nend",
["yOffset"] = 258.9996948242188,
["anchorPoint"] = "CENTER",
["url"] = "https://wago.io/FcvL5Z4Nn",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "--aura_env.scanSessionGUIDs = aura_env.scanSessionGUIDs or {}\naura_env.lastScan = aura_env.lastScan or {}\naura_env.scanInterval = (aura_env.config.scanDelay * 60) or 300\naura_env.maxRange = 29\n\naura_env.shouldScanUnit = function(unit)\n    if not UnitExists(unit) or not UnitIsConnected(unit) or UnitIsDeadOrGhost(unit) then\n        if aura_env.config and aura_env.config.debug then\n            local name = UnitName(unit) or unit\n            print(\"|cffff8800[LootGoblin Debug]|r Player: \" .. name .. \" is invalid (offline, dead, or non-existent).\")\n        end\n        return false\n    end\n    \n    if not CanInspect(unit) or not CheckInteractDistance(unit, 1) then\n        if aura_env.config and aura_env.config.debug then\n            local name = UnitName(unit) or unit\n            print(\"|cffff8800[LootGoblin Debug]|r Player: \" .. name .. \" is out of range or cannot be inspected.\")\n        end\n        return false\n    end\n    \n    local guid = UnitGUID(unit)\n    if not guid then return false end\n    \n    local last = aura_env.lastScan[guid]\n    if last and (GetTime() - last.timeStamp) < aura_env.scanInterval then\n        if aura_env.config and aura_env.config.debug then\n            local name = UnitName(unit) or unit\n            local remaining = aura_env.scanInterval - (GetTime() - last.timeStamp)\n            print(\"|cffff8800[LootGoblin Debug]|r Player: \" .. name .. \" was recently scanned. Re-scan in \" .. math.ceil(remaining) .. \"s.\")\n        end\n        return false\n    end\n    \n    if aura_env.config and aura_env.config.debug then\n        local name = UnitName(unit) or unit\n        print(\"|cff00ff00[LootGoblin Debug]|r Player: \" .. name .. \" added to scan queue.\")\n    end\n    \n    return true\nend\n\n\naura_env.inspectQueue = aura_env.inspectQueue or {}\naura_env.inspecting = aura_env.inspecting or nil\naura_env.scanStartTime = nil\naura_env.totalPlayersToScan = 0",
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "unit",
["use_alwaystrue"] = true,
["subeventSuffix"] = "_CAST_START",
["use_absorbMode"] = true,
["event"] = "Conditions",
["unit"] = "player",
["spellIds"] = {
},
["use_absorbHealMode"] = true,
["use_unit"] = true,
["names"] = {
},
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["duration"] = "0.5",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "timed",
["events"] = "GROUP_ROSTER_UPDATE,PLAYER_REGEN_ENABLED,INSPECT_READY",
["custom"] = "function(event, ...)\n    -- Init dynamic scan scheduler\n    aura_env.scheduleNextScan = aura_env.scheduleNextScan or function()\n        local total = GetNumGroupMembers()\n        local delay = 0.4\n        if total <= 5 then delay = 0.1\n        elseif total <= 10 then delay = 0.2\n        elseif total <= 20 then delay = 0.3 end\n        \n        C_Timer.After(delay, function()\n                WeakAuras.ScanEvents(\"RAID_GEAR_SCAN_UPDATE\")\n        end)\n    end\n    \n    if event == \"INSPECT_READY\" and aura_env.inspecting then\n        local unit = aura_env.inspecting\n        local guid = UnitGUID(unit)\n        if guid then\n            local entry = {\n                name = UnitName(unit),\n                timeStamp = GetTime()\n            }\n            \n            local validSlots = 0\n            for slot = 1, 18 do\n                local link = GetInventoryItemLink(unit, slot)\n                if not link then\n                    local tooltip = C_TooltipInfo.GetInventoryItem(unit, slot)\n                    if tooltip and tooltip.lines and tooltip.lines[1] and tooltip.lines[1].leftText then\n                        local raw = tooltip.lines[1].leftText\n                        if raw:find(\"|Hitem:\") then\n                            link = raw\n                        end\n                    end\n                end\n                if link then validSlots = validSlots + 1 end\n                entry[\"slot_\"..slot] = link or \"None\"\n            end\n            \n            if validSlots >= 15 then\n                aura_env.lastScan[guid] = entry\n                \n                if aura_env.config and aura_env.config.debug then\n                    print(\"|cff00ff00[LootGoblin Debug]|r Successfully scanned \" .. (entry.name or unit) .. \" with \" .. validSlots .. \" equipped items:\")\n                    local slotNames = {\n                        [1] = \"Head\", [2] = \"Neck\", [3] = \"Shoulder\", [4] = \"Shirt\", [5] = \"Chest\",\n                        [6] = \"Waist\", [7] = \"Legs\", [8] = \"Feet\", [9] = \"Wrist\", [10] = \"Hands\",\n                        [11] = \"Finger 1\", [12] = \"Finger 2\", [13] = \"Trinket 1\", [14] = \"Trinket 2\",\n                        [15] = \"Back\", [16] = \"Main Hand\", [17] = \"Off Hand\", [18] = \"Ranged\"\n                    }\n                    for slot = 1, 18 do\n                        print(\"    \" .. (slotNames[slot] or (\"Slot \" .. slot)) .. \": \" .. entry[\"slot_\" .. slot])\n                    end\n                end\n                \n                -- Check for full scan complete\n                if aura_env.totalPlayersToScan and aura_env.scanStartTime then\n                    local now = GetTime()\n                    local fullyScanned = 0\n                    for i = 1, GetNumGroupMembers() do\n                        local g = UnitGUID(\"raid\"..i)\n                        local e = g and aura_env.lastScan[g]\n                        if e and (now - e.timeStamp < aura_env.scanInterval) then\n                            local count = 0\n                            for s = 1, 18 do\n                                if e[\"slot_\"..s] and e[\"slot_\"..s] ~= \"None\" then count = count + 1 end\n                            end\n                            if count >= 15 then\n                                fullyScanned = fullyScanned + 1\n                            end\n                        end\n                    end\n                    if fullyScanned >= aura_env.totalPlayersToScan then\n                        local duration = math.floor(now - aura_env.scanStartTime)\n                        print(string.format(\"|cffffff00[LootGoblin]:|r Full scan complete (%ds)\", duration))\n                        aura_env.scanStartTime = nil\n                        aura_env.totalPlayersToScan = 0\n                    end\n                end\n            else\n                aura_env.failedQueue = aura_env.failedQueue or {}\n                table.insert(aura_env.failedQueue, unit)\n                \n                if aura_env.config and aura_env.config.debug then\n                    print(\"|cffff0000[LootGoblin Debug]|r Scan incomplete for \" .. (UnitName(unit) or unit) ..\n                    \" (\" .. validSlots .. \"/18). Added to retry queue.\")\n                end\n            end\n        end\n        \n        ClearInspectPlayer()\n        aura_env.inspecting = nil\n        WeakAuras.ScanEvents(\"RAID_GEAR_SCAN_UPDATE\")\n        return true\n    end\n    \n    -- Skip in combat\n    if InCombatLockdown() then return false end\n    \n    -- Add fresh units to scan queue\n    local pending = 0\n    for i = 1, GetNumGroupMembers() do\n        local unit = \"raid\"..i\n        if aura_env.shouldScanUnit(unit) then\n            table.insert(aura_env.inspectQueue, unit)\n            pending = pending + 1\n        end\n    end\n    \n    if pending > 0 then\n        aura_env.scanStartTime = GetTime()\n        aura_env.totalPlayersToScan = pending\n    end\n    \n    -- Retry failed scans if main queue is empty\n    if #aura_env.inspectQueue == 0 and aura_env.failedQueue and #aura_env.failedQueue > 0 then\n        for _, unit in ipairs(aura_env.failedQueue) do\n            table.insert(aura_env.inspectQueue, unit)\n        end\n        aura_env.failedQueue = {}\n    end\n    \n    -- Process next scan if not cooling down\n    if not aura_env.inspecting and #aura_env.inspectQueue > 0 and not aura_env.inspectCooldown then\n        local unit = table.remove(aura_env.inspectQueue, 1)\n        if UnitExists(unit) and CanInspect(unit) and CheckInteractDistance(unit, 1) then\n            aura_env.inspecting = unit\n            aura_env.inspectCooldown = true\n            \n            if aura_env.config and aura_env.config.debug then\n                print(string.format(\"|cffffff00[LootGoblin]:|r Now scanning %s.\", UnitName(unit) or unit))\n            end\n            \n            NotifyInspect(unit)\n            \n            aura_env.scheduleNextScan()\n            aura_env.inspectCooldown = false\n        end\n    end\n    \n    WeakAuras.ScanEvents(\"RAID_GEAR_SCAN_UPDATE\")\n    return true\nend",
["custom_type"] = "event",
["spellIds"] = {
},
["subeventPrefix"] = "SPELL",
["names"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["debuffType"] = "HELPFUL",
["type"] = "custom",
["events"] = "CHAT_MSG_LOOT",
["custom_type"] = "event",
["custom_hide"] = "timed",
["duration"] = "0.5",
["custom"] = "function(event, msg, playerName, ...)\n    if not msg or not playerName then return false end\n    if not msg:find(\"Need for:\") then return false end\n    \n    -- Extract item link from message\n    local itemLink = msg:match(\"|Hitem:.-|h.-|h\")\n    if not itemLink then return false end\n    \n    -- Extract just the name (no realm)\n    local cleanName = Ambiguate(playerName, \"short\")\n    \n    -- Find unit in raid\n    local unit = nil\n    for i = 1, GetNumGroupMembers() do\n        local candidate = \"raid\" .. i\n        if UnitName(candidate) == cleanName then\n            unit = candidate\n            break\n        end\n    end\n    if not unit then return false end\n    \n    local guid = UnitGUID(unit)\n    if not guid or not aura_env.lastScan[guid] then return false end\n    \n    -- Get slot from item\n    local itemID = GetItemInfoInstant(itemLink)\n    if not itemID then return false end\n    \n    local slotID = select(9, GetItemInfo(itemID)) -- InventoryType\n    if not slotID then return false end\n    \n    local slotMap = {\n        [1] = \"slot_1\",  -- Head\n        [2] = \"slot_2\",  -- Neck\n        [3] = \"slot_3\",  -- Shoulder\n        [4] = \"slot_4\",  -- Shirt\n        [5] = \"slot_5\",  -- Chest\n        [6] = \"slot_6\",  -- Waist\n        [7] = \"slot_7\",  -- Legs\n        [8] = \"slot_8\",  -- Feet\n        [9] = \"slot_9\",  -- Wrist\n        [10] = \"slot_10\",-- Hands\n        [15] = \"slot_15\",-- Back\n        [16] = \"slot_16\",-- Main Hand\n        [17] = \"slot_17\",-- Off Hand\n        [18] = \"slot_18\" -- Ranged\n    }\n    \n    local compareSlot = slotMap[slotID]\n    if not compareSlot then return false end\n    \n    local currentItemLink = aura_env.lastScan[guid][compareSlot]\n    if not currentItemLink or currentItemLink == \"None\" then return false end\n    \n    -- Get item levels\n    local function getIlvl(link)\n        local ilvl = select(4, GetItemInfo(link))\n        return ilvl or 0\n    end\n    \n    local rolledIlvl = getIlvl(itemLink)\n    local equippedIlvl = getIlvl(currentItemLink)\n    \n    if rolledIlvl < equippedIlvl then\n        print(string.format(\"|cffff0000LootGoblin Found:|r %s rolled Need on %s while wearing %s\", cleanName, itemLink, currentItemLink))\n    end\n    \n    return false\nend",
["unit"] = "player",
