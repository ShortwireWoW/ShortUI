["spellIds"] = {
},
["names"] = {
},
["check"] = "event",
["custom"] = "function(allstates, event, ...)\n    local keystone = aura_env:GetKeystone()\n    if event == \"OPTIONS\" then\n        allstates[1] = {\n            show = true,\n            changed = true,\n            name = keystone or \"Placeholder\",\n        }\n        return true\n    end\n\n    if keystone == nil then return false end\n\n    local _, level, _, onTime, _, _, _, _, _, _, _, _, _ = C_ChallengeMode.GetCompletionInfo();\n    if onTime == false or aura_env:GetKeystoneLevel() > tonumber(level)  then\n        return false\n    end\n\n    allstates[1] = {\n        show = true,\n        changed = true,\n        progressType = \"timed\",\n        duration = 10,\n        expirationTime = GetTime() + 10,\n        autoHide = true,\n        name = keystone,\n    }\n    return true\nend",
["events"] = "CHALLENGE_MODE_COMPLETED",
["debuffType"] = "HELPFUL",
