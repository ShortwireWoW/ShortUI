["Can't soak Oil Canister /say"] = {
["outline"] = "OUTLINE",
["wagoID"] = "Jvpud9Ahy",
["authorOptions"] = {
},
["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "function()\n    if WeakAuras.IsOptionsOpen() then return end\n    \n    if not aura_env.last or aura_env.last < GetTime() - 1 then\n        aura_env.last = GetTime()\n        \n        SendChatMessage(\"Can't soak\")\n    end\nend",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "update",
["url"] = "https://wago.io/LiquidUndermine/4",
