["custom"] = "function(s, e, ...)\n    if e == \"OPTIONS\" then\n        CauseseAPI:AnchorSettings(\"Affix Timer Bars\")\n        s[\"\"] = {\n            show = true,\n            changed = true,\n            duration = 6,\n            expirationTime = GetTime()+6,\n            stacks = i,\n            progressType = \"timed\",\n            autoHide = true,\n        }\n    elseif e == \"STATUS\" then\n        CauseseAPI:AnchorSettings(\"Affix Timer Bars\")\n        s[\"\"] = {\n            show = true,\n            changed = true,\n            hide = true,\n            duration = 0.1,\n            expirationTime = GetTime()+0.1,\n            progressType = \"timed\",\n            autoHide = true,\n        }\n        return true\n    end\nend",
