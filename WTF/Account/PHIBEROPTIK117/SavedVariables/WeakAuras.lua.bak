["custom_hide"] = "timed",
["duration"] = "0.1",
["custom"] = "function(event, prefix, msg, channel, sender)    \n    if event ~= \"CHAT_MSG_ADDON\" then\n        return false\n    end\n    \n    if prefix ~= \"EXRTADD\" then\n        return false\n    end\n    \n    if not msg:find(\"^multiline\") then\n        return false\n    end\n    \n    local noteText = _G.VExRT and _G.VExRT.Note and _G.VExRT.Note.Text1\n    if not noteText then\n        return false\n    end\n    \n    if noteText == aura_env.lastNoteText then\n        return false\n    end\n    \n    aura_env.lastNoteText = noteText\n    \n    local swbody = noteText:match(\"swminestart%s*([%s%S]-)%s*swmineend\")\n    if not swbody then\n        return false\n    end\n    \n    local function cleanName(raw, trunc)\n        local trimmed = raw:match(\"^%s*(.-)%s*$\") or \"\"\n        if trimmed:match(\"^%b{}$\") then return trimmed, trimmed end\n        \n        local color = trimmed:match(\"|c%x%x%x%x%x%x%x%x\") or \"|cFFFFFFFF\"\n        local stripped = trimmed\n        :gsub(\"|c%x%x%x%x%x%x%x%x\", \"\")\n        :gsub(\"|r\", \"\")\n        :gsub(\"-.+\", \"\")\n        :gsub(\"[|]\", \"\")\n        :gsub(\"%s+\", \"\")\n        \n        local truncLen = trunc or 7\n        local cleaned = stripped:sub(1, 12)\n        local display = color .. stripped:sub(1, truncLen)  -- ← no \"|r\" added here\n        \n        return cleaned, display\n    end\n    \n    local count = 0\n    for raw in swbody:gmatch(\"(|c%x%x%x%x%x%x%x%x.-|r)\") do\n        --print(\"[DEBUG] Found raw name:\", raw)\n        local cleaned, display = cleanName(raw, 7)\n        if cleaned and display then\n            --print(\"C: \" .. cleaned)\n            --print(\"D: \" .. display)\n            \n            aura_env[\"swma_p\" .. (count + 1)] = display .. \"|r\"\n            count = count + 1\n            if count >= 10 then break end\n        end\n    end\n    \n    return true\nend",
["unit"] = "player",
},
