["custom"] = "function(event, arg1, arg2)\n    local throttle = 0\n    local sf = _G[\"ccs_sf\"]\n    aura_env.initializescore()\n    \n    if sf and sf.throttle then throttle = sf.throttle end\n    \n    if (GetTime() - throttle) >= .3 then -- throttle to 1 update every 0.3s (at most).\n        C_Timer.After(2, function() aura_env.updatesideframe(); end)\n    end\n    \n    if sf then sf.throttle = GetTime() end\n    \nend\n\n\n",
