["customText"] = "function()\n    local damage = aura_env.state and aura_env.state.tooltip1 and aura_env.state.tooltip2 and aura_env.state.tooltip1 + aura_env.state.tooltip2 or math.random(50000, 1500000)\n    local interval = aura_env.state and aura_env.state.tooltip3 or 2\n    \n    if interval == 1 then interval = \"\" end\n    \n    if damage and interval then\n        return damage, interval, damage < 10 and \"M\" or \"\"\n    end\nend",
