["use_unit"] = true,
["event"] = "Conditions",
["custom"] = "\n\n",
["customDuration"] = "function()\n    if not aura_env.last or aura_env.last < GetTime() - 1 then\n        aura_env.last = GetTime()\n        local _, _, _, startTime, endTime = UnitChannelInfo(\"player\")\n        \n        local maxTime\n        \n        if startTime and endTime then\n            maxTime = endTime - startTime\n        else\n            maxTime = 0\n        end\n        \n        local _,_, home, world = GetNetStats()\n        \n        aura_env.lat_max = maxTime\n        aura_env.lat_world = world\n    end\n    \n    return aura_env.lat_world, aura_env.lat_max, true\nend\n\n\n\n\n",
