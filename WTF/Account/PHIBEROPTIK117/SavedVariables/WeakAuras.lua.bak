["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.spell_ids = {\n    [110909] = true, -- Alter Time\n    [342246] = true, -- Alter Time (Arcane)\n}\n\naura_env.abbreviate = function(n)\n    local T = {}\n    T[1] = {1000000, \"M\"}\n    T[2] = {1000, \"K\"}\n    T[3] = {1, \"\"}\n    for _, v in ipairs(T) do\n        if aura_env.health >= v[1] * 100 then\n            return format(\"%d %s\", n / v[1], v[2])\n        end\n    end\nend\n\naura_env.health = UnitHealth(\"player\") \n\n",
["do_custom"] = true,
},
