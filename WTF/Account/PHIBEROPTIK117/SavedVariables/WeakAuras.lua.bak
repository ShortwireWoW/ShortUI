["actions"] = {
["start"] = {
["custom"] = "-- Throttle so we don't double-post if macro is spammed\nlocal now = GetTime()\nif (now - aura_env.lastRun) < aura_env.rearm then return end\naura_env.lastRun = now\n\n-- Ordered guild announcements with spacing\naura_env:PostDelayedMessage(\"GUILD\", \"####################\", 0)\naura_env:PostDelayedMessage(\"GUILD\", \"RAID INVITES OUT!\", 1)\naura_env:PostDelayedMessage(\"GUILD\", \"WHISPER inv FOR INVITE\", 1.5)\naura_env:PostDelayedMessage(\"GUILD\", \"####################\", 2)",
["do_custom"] = true,
},
["finish"] = {
},
["init"] = {
["custom"] = "-- Ensure we receive WA_TRIGGER addon messages\nC_ChatInfo.RegisterAddonMessagePrefix(\"WA_TRIGGER\")\n\n-- Simple helper to post with delay\nfunction aura_env:PostDelayedMessage(channel, msg, delay)\n    C_Timer.After(delay, function()\n            if IsInGuild() then\n                SendChatMessage(msg, channel)\n            end\n    end)\nend\n\n-- Anti-spam guard (seconds)\naura_env.rearm = 8\naura_env.lastRun = 0",
["do_custom"] = true,
},
},
