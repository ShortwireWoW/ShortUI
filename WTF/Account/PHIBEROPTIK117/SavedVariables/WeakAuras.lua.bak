["event"] = "Combat Log",
["match_count"] = "0",
["type"] = "custom",
["use_spellName"] = true,
["custom"] = "function(allstates, event, ...)\n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local timestamp, subEvent, hideCaster, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, destGUID, destName, destFlags, destRaidFlags, spellID, _,_, auraType = ...\n        if subEvent == \"SPELL_CAST_SUCCESS\"\n        and spellID == 323107\n        and aura_env.timers then\n            aura_env.timers[sourceGUID] = GetTime()\n            local unit = UnitTokenFromGUID(sourceGUID)\n            if unit then\n                local exists = C_NamePlate.GetNamePlateForUnit(unit)\n                if exists then\n                    allstates[sourceGUID] = {\n                        show = true,\n                        changed = true,\n                        progressType = \"timed\",\n                        duration = 6,\n                        expirationTime = 6 + GetTime(),\n                        unit = unit,\n                    }\n                    return true\n                end\n            end\n        end\n    elseif event == \"NAME_PLATE_UNIT_ADDED\" then\n        local guid = UnitGUID(...)\n        if guid and aura_env.timers and aura_env.timers[guid] then\n            local passedTime = GetTime() - aura_env.timers[guid]\n            allstates[guid] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = (passedTime < 6 and 6-passedTime) or 0,\n                expirationTime =(passedTime < 6 and 6-passedTime + GetTime()) or 0,\n                unit = ...,\n            }    \n            return true\n        end\n    elseif event == \"NAME_PLATE_UNIT_REMOVED\" then\n        local state = allstates[UnitGUID(...)]\n        if state then\n            state.show = false\n            state.changed = true\n            return true\n        end\n    elseif event == \"ENCOUNTER_START\" then\n        aura_env.timers = {}\n    end\nend",
["auraspellids"] = {
"256493",
},
