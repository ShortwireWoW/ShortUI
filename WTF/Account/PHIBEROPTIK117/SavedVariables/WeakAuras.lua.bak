["value"] = {
["custom"] = "local hasAddOn = C_AddOns.IsAddOnLoaded(\"SharedMedia_Causese\")\nif hasAddOn and aura_env.state and aura_env.state.stacks then\n    local voiceID\n    for _, voice in pairs(C_VoiceChat.GetTtsVoices()) do\n        if string.match(voice.name, \"Zira\") then\n            voiceID = voice.voiceID\n            break\n        end\n    end\n    if voiceID then\n        local stacks = aura_env.state.stacks\n        C_VoiceChat.SpeakText(voiceID, \"Stars\", 1, 0.5, GetCVar(\"Sound_MasterVolume\")*100)\n    end\nend",
