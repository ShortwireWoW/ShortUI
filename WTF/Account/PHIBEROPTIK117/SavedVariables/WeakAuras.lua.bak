},
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["duration"] = "0",
["unit"] = "player",
["events"] = "CHAT_MSG_ADDON,ENCOUNTER_END,PLAYER_ENTERING_WORLD",
["check"] = "event",
["debuffType"] = "HELPFUL",
["custom"] = "function(event, ...)\n    \n    local function raidDiff()\n        if IsInRaid() and GetRaidDifficultyID then\n            return GetRaidDifficultyID()\n        end\n    end\n    \n    \n    if event == \"ENCOUNTER_END\" or event == \"PLAYER_ENTERING_WORLD\" then\n        \n        channel = nil\n        if (raidDiff() == 17) then\n            channel = \"INSTANCE_CHAT\"\n        else\n            channel = \"RAID\"\n        end        \n        \n        -- Request tier updates from the group\n        C_Timer.After(5, function()\n                C_ChatInfo.SendAddonMessage(\"LE_TIER\", \"le_update_tier_request\", channel)\n        end)\n        \n    end\n    \n    if event == \"CHAT_MSG_ADDON\" then\n        local prefix, message, channel, sender = select(1, ...)\n        if prefix == \"LE_TIER_MAIN\" then\n            \n            -- Ensure receivedResponses table exists before use\n            if not aura_env.receivedResponses then\n                aura_env.receivedResponses = {}\n            end\n            \n            -- Remove realm name if present (e.g., \"PlayerName-Realm\" -> \"PlayerName\")\n            local senderName = strsplit(\"-\", sender)\n            \n            \n            local function Explode(str, delimiter)\n                local result = {}\n                for match in string.gmatch(str, \"([^\"..delimiter..\"]+)\") do\n                    table.insert(result, match)\n                end\n                return result\n            end\n            \n            -- Parse the incoming message\n            local data = Explode(message, \":\")\n            if #data < 6 then return false end  -- Ensure valid data\n            \n            local playerName = data[1]\n            local itemIDs = {unpack(data, 2, 6)}\n            \n            -- Initialize tierList if needed\n            if not aura_env.tierList then\n                aura_env.tierList = {}\n            end\n            \n            -- Store the response\n            aura_env.tierList[playerName] = itemIDs\n            \n            -- Store sender in receivedResponses without realm\n            if not aura_env.receivedResponses then\n                aura_env.receivedResponses = {}\n            end\n            aura_env.receivedResponses[senderName] = true\n            \n            return true\n        end\n        \n        if prefix == \"LE_TIER\" then\n            -- Initialize both tables to prevent nil errors\n            aura_env.raidMembers = {}\n            aura_env.raidClasses = {}            \n            aura_env.receivedResponses = {}\n            \n            -- Collect all raid members\n            if IsInRaid() then\n                for i = 1, GetNumGroupMembers() do\n                    local name, _, _, _, _, class, _, _, _, _, _ = GetRaidRosterInfo(i)\n                    -- Remove realm name if present (e.g., \"PlayerName-Realm\" -> \"PlayerName\")\n                    local name = strsplit(\"-\", name)\n                    \n                    if name and class then\n                        aura_env.raidMembers[name] = true\n                        aura_env.raidClasses[name] = class                        \n                    end\n                end\n            end\n        end\n    end\n    return false\nend",
["custom_hide"] = "timed",
},
