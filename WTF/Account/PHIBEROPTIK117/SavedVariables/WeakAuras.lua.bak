},
["triggers"] = {
{
["trigger"] = {
["type"] = "unit",
["use_alwaystrue"] = true,
["subeventSuffix"] = "_CAST_START",
["use_absorbMode"] = true,
["event"] = "Conditions",
["unit"] = "player",
["spellIds"] = {
},
["use_absorbHealMode"] = true,
["use_unit"] = true,
["names"] = {
},
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["duration"] = "0",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["spellIds"] = {
},
["custom"] = "function(event, ...)\n    local slotIDs = {1, 3, 5, 7, 10} -- Head, Shoulder, Chest, Legs, Hands\n    \n    local function updateTier()\n        local playerName = GetUnitName(\"player\") or \"Unknown\"\n        local _, class = UnitClass(\"player\")\n        local colors = (CUSTOM_CLASS_COLORS or RAID_CLASS_COLORS)[class]\n        local formattedName = colors and colors.colorStr and string.format(\"|c%s%s|r\", colors.colorStr, playerName) or playerName\n        \n        local tierItems = {} -- Store item IDs in a table\n        \n        for _, slotID in ipairs(slotIDs) do \n            local itemID = GetInventoryItemID(\"player\", slotID)\n            table.insert(tierItems, itemID or \"None\") -- Add item ID (or \"None\") to the list\n        end\n        \n        local tierList = formattedName .. \":\" .. table.concat(tierItems, \":\") -- Concatenate without trailing \":\"\n        aura_env.le_tier = tierList\n    end    \n    \n    if event == \"CHAT_MSG_ADDON\" then\n        local prefix, message, channel, sender = select(1, ...)        \n        if prefix == \"LE_TIER\" then\n            if (message == \"le_update_tier_request\") then\n                updateTier()\n                \n                if aura_env.le_tier ~= nil then\n                    C_ChatInfo.SendAddonMessage(\"LE_TIER_MAIN\", aura_env.le_tier, channel)\n                else\n                    print(\"Error! Contact Shortwire.\")                \n                end\n                \n                WeakAuras.ScanEvents(\"CUSTOM_MESSAGE_RECEIVED\")\n            end\n        end\n        return false\n    elseif event == \"PLAYER_EQUIPMENT_CHANGED\" or event == \"ENCOUNTER_END\" or event == \"PLAYER_ENTERING_WORLD\" then\n        updateTier()\n    end\n    \n    return false\nend",
["events"] = "CHAT_MSG_ADDON,PLAYER_EQUIPMENT_CHANGED,ENCOUNTER_END,PLAYER_ENTERING_WORLD",
