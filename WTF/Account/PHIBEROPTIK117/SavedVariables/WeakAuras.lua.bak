["source"] = "import",
["authorOptions"] = {
{
["min"] = 0,
["type"] = "number",
["default"] = 0,
["desc"] = "Defines the maximum time (in seconds) for which upcoming spells are displayed on the timeline. Spells cast by the boss that are outside this time window won't appear. A value of 0 removes any time limit, showing all spells regardless of their cast time.",
["useDesc"] = true,
["key"] = "timeLimitForSpells",
["name"] = "Time Limit for Spells",
["width"] = 1,
},
{
["min"] = 0,
["type"] = "number",
["default"] = 10,
["desc"] = "Sets the time (in seconds) before the spell is moved from the pre-timeline area to the timeline. When the time left for a spell's cast reaches this value, the spell icon transitions into the timeline and begins counting down to 0. For example, a value of 10 means the spell icon will move into the timeline when 10 seconds are left before the spell is cast.",
["key"] = "timelineEntryTime",
["useDesc"] = true,
["name"] = "Timeline Entry Time",
["width"] = 1,
},
{
["type"] = "toggle",
["key"] = "reverse",
["default"] = false,
["useDesc"] = false,
["name"] = "Reverse",
["width"] = 1,
},
{
["type"] = "toggle",
["key"] = "hideBossModBars",
["default"] = true,
["useDesc"] = false,
["name"] = "Hide BossMod Bars",
["width"] = 1,
},
},
["information"] = {
["forceEvents"] = true,
["ignoreOptionsEventErrors"] = true,
},
["displayIcon"] = "132305",
["alpha"] = 1,
["useAdjustededMin"] = false,
["regionType"] = "icon",
["icon"] = true,
["config"] = {
["hideBossModBars"] = true,
["timelineEntryTime"] = 10,
["timeLimitForSpells"] = 0,
["reverse"] = false,
},
["customText"] = "function()\n    if not aura_env.state then\n        return\n    end\n    \n    if not aura_env.state.name then\n        return\n    end\n    \n    local text = aura_env.state.name\n    \n    if aura_env.state.colorTable then\n        local colorTable = aura_env.state.colorTable\n        local alpha = 255 * (colorTable[4] or 1)\n        local red = 255 * (colorTable[1] or 0)\n        local green = 255 * (colorTable[2] or 0)\n        local blue = 255 * (colorTable[3] or 0)\n        \n        text = string.format(\"\\124c%02x%02x%02x%02x%s\\124r\", alpha, red, green, blue, text)\n    end\n    \n    return text\nend",
["width"] = 25,
["zoom"] = 0.3,
["semver"] = "1.1.1",
["cooldownTextDisabled"] = false,
["auto"] = true,
["tocversion"] = 110002,
["id"] = "BossMod - Timeline - Icon",
