["displayText_format_p_time_dynamic_threshold"] = 60,
["customText"] = "function()\n    local spellID = aura_env.states[2] and aura_env.states[2].spellId\n    local power = aura_env.states[1] and aura_env.states[1].power\n    \n    if WeakAuras.IsOptionsOpen() then\n        spellID = math.random(2) == 1 and 466459 or 466460\n        power = math.random(90, 100)\n    end\n    \n    if spellID == 466459 then -- Mug (go to Zee)\n        return \"|cff5c707aMetal|r\", power\n    elseif spellID == 466460 then -- Zee (go to Mug)\n        return \"|cffd99b38Dirt|r\", power\n    end\nend",
