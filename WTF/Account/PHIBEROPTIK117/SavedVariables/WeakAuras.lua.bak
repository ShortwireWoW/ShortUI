["outline"] = "OUTLINE",
["sparkOffsetX"] = 0,
["wagoID"] = "zkhTYrEsG",
["parent"] = "M+ Dynamic Group",
["adjustedMin"] = "",
["shadowYOffset"] = -1,
["displayText_format_formating2_format"] = "none",
