},
["use_maxhealth"] = false,
["subeventSuffix"] = "_CAST_START",
["custom"] = "function(allstates, event, unit)\n    if event == \"UNIT_ABSORB_AMOUNT_CHANGED\" then\n        local absorb = UnitGetTotalAbsorbs(unit)\n        local state = allstates[\"shield\"]\n        if state then\n            if absorb <= 0 then\n                state.show = false\n            else\n                state.value = absorb\n            end\n            state.changed = true\n        else\n            if absorb and absorb > 0 then\n                allstates[\"shield\"] = {\n                    show = true,\n                    changed = true,\n                    progressType = \"static\",\n                    total = absorb,\n                    value = absorb,\n                }\n            end\n        end\n        return true\n    end\nend",
