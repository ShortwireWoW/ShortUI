["id"] = "Lingering Voltage",
["customText"] = "function()\n    if WeakAuras.IsOptionsOpen() then\n        return math.random(10) * 75\n    end\n    \n    local difficultyID = select(3, GetInstanceInfo())\n    local perStack = difficultyID == 15 and 50 or difficultyID == 16 and 75\n    \n    if perStack and aura_env.state and aura_env.state.stacks then\n        return aura_env.state.stacks * perStack\n    end\nend",
