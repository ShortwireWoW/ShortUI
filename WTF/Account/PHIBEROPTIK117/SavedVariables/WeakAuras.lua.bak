["How to: TWW Season 2"] = {
["outline"] = "OUTLINE",
["color"] = {
1,
1,
1,
1,
},
["displayText"] = "Sending out Raid Instructions!",
["yOffset"] = 250,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "C_ChatInfo.RegisterAddonMessagePrefix(\"WA_TRIGGER\")\n\n\n",
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["duration"] = "1",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["custom_hide"] = "timed",
["custom"] = "-- MACRO: /run if UnitExists(\"target\") then C_ChatInfo.SendAddonMessage(\"WA_TRIGGER\", UnitName(\"target\"), \"WHISPER\", UnitName(\"player\")) end\n\n\nfunction(event, prefix, msg, channel, sender)\n    if prefix == \"WA_TRIGGER\" and msg ~= nil then\n        \n        -- Add a placeholder for vexie in the bosses table\n        local vexie = {\n            \"## HOW TO: VEXIE ##\",  \n            \"TANKS: BIG BUSTER—TAUNT SWAP AFTER KNOCKBACK.\",  \n            \"P1: TANK BOSS AT WALL, AVOID OIL. DROP OIL BOMBS AWAY FROM GROUP.\",  \n            \"BIKE TARGET? RUN TO BOSS, AOE VEHICLES, HOP IN, SLAM INTO BOSS—THIS IS OUR DAMAGE!\",  \n            \"P2: LUST! BOSS TAKES DOUBLE DAMAGE. ADDS SPAWN TO REPAIR—INTERRUPT/CC, NO CASTS!\",  \n            \"SOFT ENRAGE: 100% ENERGY = BIG BOOM (MISSED TOO MANY VEHICLE SLAMS!).\"  \n            \n        }\n        \n        local cauldronofcarnage = {\n            \"## HOW TO: CAULDRON OF CARNAGE ##\",\n            \"\",\n            \"EVEN → RIGHT (MONKEY) // ODDS → LEFT (DINO)\",\n            \"\",\n            \"MONKEY: MINIMAL MOVEMENT OR STUN. DODGE BLUE RINGS.\",\n            \"DINO: STAND STILL W/ RED LASER, MOVE LAST SECOND. GROUP SOAK BIG BOMB.\",\n            \"\",\n            \"KILL TOGETHER OR SOFT-ENRAGE → WIPE.\"\n        }\n        \n        local rikreverb = {\n            \"## HOW TO: RIK REVERB ##\",\n            \"\",\n            \"TANKS: SWAP @10 TINNITUS // STAY AWAY FROM AMPLIFIERS // FRONTAL CONE SMASH\",\n            \"\",\n            \"PHASE ONE: AVOID WHITE CIRCLES. RIGHT CLICK AMPLIFIERS TO DRAIN ENERGY\",\n            \"\",\n            \"INTERMISSION (100% ENERGY): FIND AND STAND IN BIG BLUE.\",\n            \"CLICK BUTTON TO JUMP OVER RING (THINK QUEEN)\"\n        }\n        \n        local stixbunkjunker = {\n            \"## HOW TO: STIX ##\",  \n            \"TANKS: SWAP ON DEMOLISH, USE DR FOR MELTDOWN, ALWAYS TAKE ROLLING RUBBISH.\",  \n            \"RAID: RED RINGS = DON'T TOUCH FRIENDS OR TRASH PILES.\",  \n            \"YELLOW ARROW: YOU'RE ROLLING RUBBISH—EAT TRASH PILES TO LEVEL UP, THEN EAT BIGGER TRASH.\",  \n            \"TWO BIG BOMBS SPAWN—TANK TAKES ONE, ANOTHER PLAYER TAKES THE OTHER.\",  \n            \"100% ENERGY: BOSS FLIES UP, SHOOTS BLUE CIRCLES—DODGE. BOSS LANDS WITH ONE-SHOT SLAM—AVOID.\"  \n            \n        }\n        \n        local sprocket = {\n            \"## HOW TO: STIX ##\",  \n            \"TANKS: SWAP ON DEMOLISH, USE DR FOR MELTDOWN, ALWAYS TAKE ROLLING RUBBISH.\",  \n            \"RAID: RED RINGS = DON'T TOUCH FRIENDS OR TRASH PILES.\",  \n            \"YELLOW ARROW: YOU'RE ROLLING RUBBISH—EAT TRASH PILES TO LEVEL UP, THEN EAT BIGGER TRASH.\",  \n            \"TWO BIG BOMBS SPAWN—TANK TAKES ONE, ANOTHER PLAYER TAKES THE OTHER.\",  \n            \"100% ENERGY: BOSS FLIES UP, SHOOTS BLUE CIRCLES—DODGE. BOSS LANDS WITH ONE-SHOT SLAM—AVOID.\"  \n            \n        }\n        \n        -- Create the bosses table\n        local bosses = {\n            [1] = vexie,\n            [2] = cauldronofcarnage,\n            [3] = rikreverb,\n            [4] = stixbunkjunker,\n            [5] = sprocket\n        }\n        \n        local delay = 0.5 -- Seconds between messages\n        local currentIndex = 1  -- Keeps track of the current message to send\n        \n        -- Function to send the boss instructions\n        local function sendBossInstructions(bossIndex)\n            -- Get the instructions for the given boss\n            local boss = bosses[bossIndex]\n            if boss then\n                -- Send each message in the boss guide\n                SendChatMessage(boss[currentIndex], \"RAID\")\n                currentIndex = currentIndex + 1\n                -- If there are more messages, schedule the next one\n                if currentIndex <= #boss then\n                    C_Timer.After(delay, function() sendBossInstructions(bossIndex) end)\n                end\n            end\n        end\n        \n        -- Call the function to send instructions for a specific boss\n        if msg == \"The Geargrinder\" then\n            currentIndex = 1  -- Reset the index for the The Geargrinder boss\n            sendBossInstructions(1) -- Sends the \"The Geargrinder\" instructions\n        elseif msg == \"Torq\" or msg == \"Flarendo\" then\n            currentIndex = 1  -- Reset the index for the Rik boss\n            sendBossInstructions(2) -- Sends the \"Cauldron of Carnage\" instructions\n        elseif msg == \"Rik Reverb\" then\n            currentIndex = 1  -- Reset the index for the Vexie boss\n            sendBossInstructions(3) -- Sends the \"Rik Reverb\" instructions\n        end\n        \n        return true\n    end\nend",
