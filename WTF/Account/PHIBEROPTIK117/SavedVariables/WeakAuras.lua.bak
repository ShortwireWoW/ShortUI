["uid"] = "LfGjuHPjCQg",
["justify"] = "LEFT",
["tocversion"] = 110100,
["id"] = "How to: TWW Season 2",
["displayText"] = "Sending out Raid Instructions!",
["frameStrata"] = 1,
["anchorFrameType"] = "SCREEN",
["preferToUpdate"] = false,
["config"] = {
["vexie_ri"] = "## HOW TO: VEXIE ##\nTANKS: Tank the boss at the wall. Taunt swap after knockback. Move boss frequently.\nP1: Purple Circles run out. Fire bombs run out. (HEROIC: Use fire bomb to clear oil)\nBIKES: Bait bikes to front of boss. Kill goblins, hop in bike and fire bike at boss.\nP2: After boss drops armor stacks, lust. Boss takes double damage. Interrupt the adds casting repair.\nSOFT ENRAGE: 100% Energy = Wipe (Bikes didn't hit boss!)",
["gallywix_ri"] = "## HOW TO: CHROME KING GALLYWIX ##\n\nP1: PLATFORM PHASE\n- STACK: Stay stacked to manage AoE and cleave adds.\n- DEBUFF SWAP: Players get Chromatic Overload (colored debuff). Swap if overlapping colors are near each other.\n- ADD CONTROL: Gallybots spawn with dangerous casts. Interrupt/stun/kick them fast.\n- BEAM BAIT: Chromatic Beam fixates a player. Kite it safely across unused space.\n\nINTERMISSION (70% & 40%):\n- MOVE TO NEW PLATFORM: Use portals fast or be left behind.\n- DODGE: Big AoE and swirlies as you move.\n- MAJOR DAMAGE: Use defensives/healing cooldowns — he hits hard during transitions.\n\nP2: FINAL PLATFORM\n- COLOR MANAGEMENT: Debuffs are now random and swap more frequently. Stay alert.\n- BEAM OVERLAPS: Beam targets two players at once. Bait directions to avoid overlap.\n- STACK & BURST: Stack for healing. Kill Gallybots ASAP.\n- SOFT ENRAGE: Frequent overlaps of mechanics. High raid damage. Use LUST here and finish strong.",
["rikreverb_ri"] = "## HOW TO: RIK REVERB ##\nTANKS: Don’t stack. Swap at 5 Tinnitus. Move boss away from Amplifiers.\nP1: \n - Blue Circles = Spread  \n - White Circles = Dodge  \n - Blue Rectangle = Target stand still\nAMPLIFIERS: Click at 85–90% energy with a defensive. At 100% = massive raid damage!\nINTERMISSION: Find and stand in big blue. Avoid white death ring, or die.\nSOFT ENRAGE: After 3 intermissions, boss becomes unkillable.",
["stix_ri"] = "## HOW TO: STIX ##\nTANKS: Swap on DEMOLISH, use defensive for MELTDOWN. You’ll always become a ball.\nP1: Avoid red rings, trash, and all colored circles. Kite adds into boss, cleave both.\nROLLING RUBBISH: Yellow arrow = ball. Roll over trash: Small > Medium > Large. Slam into Bomb or Boss before time runs out.\nHEROIC: Avoid Bombshells with the ball. Non-ball players: burn them to 75%, then kill once off trash.\nINTERMISSION: At 100% energy boss flies up. 15s later: run out of big blue or die.",
["coc_ri"] = "## HOW TO: CAULDRON OF CARNAGE ##\nODDS LEFT (DINO) // EVENS RIGHT (MONKEY)\nMONKEY: Minimal movement or stun, dodge blue rings. (HEROIC: Trap/Stun/Kite Images)\nDINO: Group soak big bomb, stand on LEFT side of bomb. Laser beam goes RIGHT of bomb, dodge at last second.\nINTERMISSION: Run to middle of room, cleave. Dodge red/blue. Swap sides (Monkey team go to Dino, Dino team go to Monkey)\nSOFT-ENRAGE: Kill both bosses within same time, Romeo and Juliet style.",
["oab_ri"] = "## HOW TO: ONE-ARMED BANDIT ##\nTANKS: Swap on The Big Hit. Run out and drop zone denial after. Stack Hyper Coils to save space.\nCASINO CHIP: Stand beside blue line to get buff. When it lands, run to it and use Extra Action Button to roll it again through raid.\nADDS: 3 spawn. Kill the 2 called out, pick up dropped tokens, run to boss, and deposit with Extra Button. Kill third after.\nADD SPECIALS:\n - Fire Add: Debuff > run out > get dispelled > tornados launch from you and return.  \n - Bomb Add: Spawns bombs. CC and AoE. (HEROIC: turns into big bomb on death)  \n - Lightning Add: Heal absorb debuff — heal it off.  \n - Coin Add: Big AOE from boss — use defensives.\nFRAUD DETECTED: If < 2 tokens deposited > boss gains 500% damage = wipe.\nP1: Get casino buffs, roll chips ASAP. Boss gains damage for each chip out. Dodge tornados. Use defensives for coin AoE.\nP2: Starts at 25% — race to kill!\n - 20%: Boss drops Hyper Coil with laser link — don’t touch.\n - 15%: Hot Hot Heat: 2 players get red arrows > stand still, others move away.\n - 10%: Scattered Payout: Big raid AoE. Use raid defensives.\n - 5%: Explosive Jackpot cast. Kill him or wipe.\nSOFT ENRAGE: Don’t fail tokens. Deposit fast!",
["sprocket_ri"] = "## HOW TO: SPROCKET ##\nTANKS: Gravi-Gunk stacks = damage + slow. Swap. Pyro Pack: lowest stacks tank takes bomb.\nCONVEYORS: (Facing boss) Lasers left, Magnets middle, Rockets right.\nZONES: 4 quadrants > 2 denied with lightning. Pattern is fixed and repeats.\nP1: Dodge red lasers, magnet pulls, and rockets. Players with brown rings: run OUT & AWAY from boss to bait drills.\nHEROIC: Mines spawn. Assigned players pop slowly. Unstable Shrapnel = instant death if you pop a mine. Don’t chain pop during raid-wide.\nINTERMISSION: 100% energy > Knockback. Stay on platform! \n - NORMAL: Boss ports center. Follow.\n - HEROIC: Boss ports top-left > bottom-right. Survive cast.\nP2: Mechanics overlap: Lasers + Rockets, Magnets + Lasers, etc. Lasers now triple-wide and blue — AVOID!\nSOFT ENRAGE: Each intermission empowers boss. Kill before the 3rd.",
["mugzee_ri"] = "## HOW TO: MUG'ZEE ##\nTANKS: Swap on Mug after Golden Drip. Swap on Zee after Double Whammy Shot.\n\nP1:\n- Mug (Brown floor):\n  - PRISONS: Kill goons fast. Assign 2 prison healers, rest stay out. Stack on one wall after to limit breakage.\n  - FINGER GUN: Target stands still, others run out. Swap sides after.\n  - GOLDEN DRIP: Tank drops stacks along outside wall.\n  - HEROIC: Frostshatter Boots — use prison walls to LoS arrow. Don’t hit others.\n\n- Zee (Metal floor):\n  - Kill both Shockers. Hug mines to detonate. Move to wall with Rocket. 5+ soak or wipe.\n  - DOUBLE WHAMMY: Target stands still, tank soaks. You become a bomb — others run out.\n  - SPRAY & PRAY: Target stands still, others move. Swap sides after.\n  - HEROIC: Debuffs on mine/rocket soakers. Split raid and rotate. Stand in red circles for ground soaks.\n\n- SIDE SWAP before 100% energy or wipe.\n\nINTERMISSION @ 40%: Boss charges, then T-pose + 360 spin. Follow after each charge (3 total). LUST after final T-pose.\n\nP2:\nAll P1 mechanics can overlap. Watch for deadly combos like Prisons + Rocket. Survive that and it’s a kill.",
["debug_ri"] = false,
},
