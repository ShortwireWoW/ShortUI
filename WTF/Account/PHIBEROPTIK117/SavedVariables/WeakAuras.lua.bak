["customSort"] = "function(a, b)\n    local roleA = a.region.state.role or \"\"\n    local roleB = b.region.state.role or \"\"\n    \n    local nameA = a.region.state.unitName or \"\"\n    local nameB = b.region.state.unitName or \"\"\n    \n    if roleA ~= roleB then\n        return roleA > roleB\n    elseif nameA ~= nameB then\n        return nameA < nameB\n    end\nend",
