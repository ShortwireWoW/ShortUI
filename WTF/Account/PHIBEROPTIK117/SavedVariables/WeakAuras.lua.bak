["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "do\n    \n    if not RaiderIO then\n        print(\"|cffff4444[DnD]|r Raider.IO addon is not loaded. 'DnD - Newb Finder' is disabled.\")\n        WeakAuras.ScanEvents(\"DND_NEWBF_DISABLED\")\n        return\n    end\n    \n    local FACTIONS = { Alliance = 1, Horde = 2, Neutral = 3 }\n    \n    local function rgbToHex(r, g, b)\n        return string.format(\"%02x%02x%02x\", math.floor(r * 255), math.floor(g * 255), math.floor(b * 255))\n    end\n    \n    local COLORS = {\n        NEW = \"00ff00\",   -- Green\n        N   = \"ffff00\",   -- Yellow\n        H   = \"ff9900\",   -- Orange\n        M   = \"ff0000\",   -- Red\n        Fallback = \"ffffff\"\n    }\n    \n    local function getRaidProgress(fullname)\n        if not fullname or not RaiderIO then\n            --print(\"[DnD] Skipping: RaiderIO or name missing for\", fullname)\n            return nil, true\n        end\n        \n        if not fullname:find(\"-\") then\n            fullname = fullname .. \"-\" .. gsub(GetRealmName(), \" \", \"\")\n        end\n        \n        local factionID = FACTIONS[UnitFactionGroup(\"player\")]\n        local profile = RaiderIO.GetProfile(fullname, factionID)\n        if not profile or not profile.raidProfile or not profile.raidProfile.sortedProgress then\n            --print(\"[DnD] No RaiderIO profile data found for:\", fullname)\n            return nil, true\n        end\n        \n        local progress, difficulty, bossCount = 0, 0, 0\n        for _, entry in ipairs(profile.raidProfile.sortedProgress) do\n            local prog = entry.progress\n            if not entry.obsolete and prog then\n                local isSameDiff = prog.difficulty == difficulty\n                local isProgUpgrade = prog.progressCount > progress and isSameDiff\n                local isDiffUpgrade = prog.difficulty > difficulty\n                \n                if (isProgUpgrade or isDiffUpgrade) then\n                    progress = prog.progressCount or 0\n                    bossCount = prog.raid and prog.raid.bossCount or 0\n                    difficulty = prog.difficulty or 1\n                end\n            end\n        end\n        \n        if progress > 0 then\n            --print(string.format(\"[DnD] %s has %d/%d @ difficulty %d\", fullname, progress, bossCount, difficulty))\n            return { progressCount = progress, raid = { bossCount = bossCount }, difficulty = difficulty }, not (profile.mains and profile.mains[1])\n        else\n            --print(\"[DnD] No raid progress found for:\", fullname)\n            return nil, not (profile.mains and profile.mains[1])\n        end\n    end\n    \n    \n    local function formatProgressTag(progress)\n        if not progress or (progress.progressCount or 0) == 0 then return nil end\n        local diffShort = ({ [1] = \"N\", [2] = \"H\", [3] = \"M\" })[progress.difficulty] or \"?\"\n        local color = COLORS[diffShort] or COLORS.Fallback\n        return string.format(\"|cff%s[%d/%d%s]|r\", color, progress.progressCount, progress.raid.bossCount or 0, diffShort)\n    end\n    \n    local function shouldMarkNew(progress, noMain, noData)\n        if noData then\n            --print(\"[DnD] Marking NEW: no RaiderIO data.\")\n            return true\n        end\n        if not progress then\n            --print(\"[DnD] Marking NEW: no progress found.\")\n            return true\n        end\n        if (progress.progressCount or 0) == 0 and noMain then\n            --print(\"[DnD] Marking NEW: 0/8 and no main.\")\n            return true\n        end\n        return false\n    end\n    \n    hooksecurefunc(\"LFGListApplicationViewer_UpdateApplicantMember\", function(member, id, idx)\n            local fullname = C_LFGList.GetApplicantMemberInfo(id, idx)\n            if not fullname or not member.Name then return end\n            \n            local nameOnly = fullname:gsub(\"-%S+\", \"\") -- strip server\n            local progress, noMain = getRaidProgress(fullname)\n            local isNew = shouldMarkNew(progress, noMain, not progress)\n            \n            local prefix, trimmedName\n            if isNew then\n                prefix = \"|cff\" .. COLORS.NEW .. \"NEW|r\"\n                trimmedName = nameOnly -- no truncation for NEW\n            else\n                prefix = formatProgressTag(progress)\n                -- Truncate to 10 characters if progress shown\n                trimmedName = nameOnly:sub(1, 10)\n            end\n            \n            if prefix then\n                member.Name:SetText(prefix .. \" \" .. trimmedName)\n            else\n                member.Name:SetText(trimmedName)\n            end\n            \n            --print(\"[DnD] Displayed:\", member.Name:GetText())\n    end)\nend",
},
["finish"] = {
