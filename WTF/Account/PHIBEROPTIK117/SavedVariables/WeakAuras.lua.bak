["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 5,\n            expirationTime = GetTime() + 5,\n            autoHide = true\n        }\n    elseif event == \"STATUS\" then\n        if AuraUpdater then AuraUpdater:UpdateAnchorSettings(\"Circles\") end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 0.1,\n            expirationTime = GetTime() + 0.1,\n            autoHide = true\n        }\n        \n        return true\n    end\nend",
