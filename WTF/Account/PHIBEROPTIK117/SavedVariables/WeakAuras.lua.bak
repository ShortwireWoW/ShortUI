["type"] = "custom",
["match_countOperator"] = ">",
["auraspellids"] = {
},
["events"] = "UNIT_TARGET:nameplate, UNIT_SPELLCAST_STOP:nameplate, UNIT_SPELLCAST_START:nameplate, CAUSESE_SPLICER_DELAY",
["custom"] = "function(allstates, event, unit, _, spellID)\n    if event == \"UNIT_TARGET\" or event == \"CAUSESE_SPLICER_DELAY\" then\n        local _,_,_,_,expirationTime,_,_,_,spellId = UnitCastingInfo(unit)\n        local guid = UnitGUID(unit)\n        if guid and spellId == 356001 and not allstates[guid] then\n            local npcID = select(6, strsplit(\"-\", guid))\n            if npcID == \"179837\" then return end\n            local _, _, _, startC, endC  = UnitCastingInfo(unit)\n            local duration = (endC - startC) / 1000\n            local expirationTime = endC / 1000\n            local _, _, position = WeakAuras.SpecRolePositionForUnit(unit..\"target\")\n            if position then\n                allstates:Update(UnitGUID(unit), {\n                        progressType = \"timed\",\n                        duration = duration,\n                        expirationTime = expirationTime,\n                        position = position,\n                        unit = WA_ClassColorName(unit..\"target\"),\n                        autoHide = true,\n                })\n            end\n        end\n    elseif event == \"UNIT_SPELLCAST_START\" and spellID == 356001 then\n        C_Timer.After(0.15, function() WeakAuras.ScanEvents(\"CAUSESE_SPLICER_DELAY\", unit) end)\n        \n    elseif event == \"UNIT_SPELLCAST_STOP\" and spellID == 356001 then\n        allstates:Remove(UnitGUID(unit))\n    end\nend\n\n\n",
["matchesShowOn"] = "showOnActive",
