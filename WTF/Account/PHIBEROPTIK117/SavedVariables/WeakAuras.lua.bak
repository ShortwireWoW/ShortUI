["anchorFrameParent"] = false,
["sparkHeight"] = 30,
["sparkRotation"] = 0,
["displayText_format_max_format"] = "none",
["customTextUpdate"] = "event",
["semver"] = "1.3.44",
["displayText_format_15_format"] = "none",
["id"] = "M+ Bosses",
["displayText_format_name_format"] = "none",
["frameStrata"] = 4,
["width"] = 330,
["actions"] = {
["start"] = {
["custom"] = "",
["do_custom"] = false,
},
["finish"] = {
