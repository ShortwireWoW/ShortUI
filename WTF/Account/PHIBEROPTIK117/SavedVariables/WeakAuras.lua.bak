["init"] = {
["custom"] = "aura_env.mapIDtoSpellID = {\n  [2]   = 131204, -- Jade Serpent\n  [165] = 159899, -- SBG\n  [168] = 159901, -- Everbloom\n  [198] = 424163, -- DHT\n  [199] = 424153, -- BRH\n  [200] = 393764, -- HoV\n  [206] = 410078, -- Nelths Lair\n  [210] = 393766, -- CoS\n  [244] = 424187, -- Atal'Dazar\n  [245] = 410071, -- Freehold\n  [247] = -1, -- Motherlode\n  -- 467553 (Alliance)\n  -- 467555 (Horde)\n  [248] = 424167, -- Waycrest\n  [251] = 410074, -- Underrot\n  [353] = -1,     -- Siege of Boralus\n  -- This is actually 2 Spells (of course)\n  -- 445418 (Alliance)\n  -- 464256 (Horde)\n  [370] = 373274, -- Mechagon Workshop\n  [375] = 354464, -- Mists\n  [376] = 354462, -- Necrotic Wake\n  [382] = 354467, -- Theater of Pain\n  [399] = 393256, -- Ruby Life Pools\n  [400] = 393262, -- Nokhud Offensive\n  [401] = 393279, -- Azure Vault\n  [402] = 393273, -- Algethar Academy\n  [403] = 393222, -- Uldaman\n  [404] = 393276, -- Neltharus\n  [405] = 393267, -- Brackenhide Hollow\n  [406] = 393283, -- Halls of Infusion\n  [438] = 410080, -- Vortex Pinnacle\n  [456] = 424142, -- THOT\n  [463] = 424197, -- DOTI LOWER\n  [464] = 424197, -- DOTI UPPER\n  [499] = 445444, -- Priory\n  [500] = 445443, -- The Rookery\n  [501] = 445269, -- Stonevault\n  [502] = 445416, -- City of Threads\n  [503] = 445417, -- Ara Ara\n  [504] = 445441, -- Darkflame Cleft\n  [505] = 445414, -- The Dawnbreaker\n  [506] = 445440, -- Cinderbrew Meadery\n  [507] = 445424, -- Grim Batol\n  [525] = 1216786, -- Operation Floodgate\n  -- These are all \"Hero's Path\" but NYE\n  -- 445429\n  -- 445430\n  -- 445432\n  -- 445433\n  -- 445437\n  -- 445438\n  -- 445446\n  -- 445447\n  -- 445448\n  -- 445449\n}\n\naura_env.mapIDtoName = {\n  [2]   = \"Jade Snek\",        -- Jade Serpent\n  [56]  = \"\",                 -- Stormstout Brewery\n  [57]  = \"\",                 -- Gate of the Setting Sun\n  [58]  = \"\",                 -- Shado-Pan Monastery\n  [59]  = \"\",                 -- Siege of Niuzao Temple\n  [60]  = \"\",                 -- Mogu'shan Palace\n  [76]  = \"\",                 -- Scholomance\n  [77]  = \"\",                 -- Scarlet Halls\n  [78]  = \"\",                 -- Scarlet Monastery\n  [161] = \"\",                 -- Skyreach\n  [163] = \"\",                 -- Bloodmaul Slag Mines\n  [164] = \"\",                 -- Auchindoun\n  [165] = \"Free Key\",         -- SBG\n  [166] = \"\",                 -- Grimrail Depot\n  [167] = \"\",                 -- Upper Blackrock Spire\n  [168] = \"Everbloom\",        -- Everbloom\n  [169] = \"\",                 -- Iron Docks\n  [197] = \"\",                 -- Eye of Azshara\n  [198] = \"DHT\",              -- Darkheart Thicket\n  [199] = \"BRH\",              -- Black Rook Hold\n  [200] = \"HoV\",              -- Halls of Valor\n  [206] = \"NL\",               -- Nelths Lair\n  [207] = \"\",                 -- Vault of the Wardens\n  [208] = \"\",                 -- Maw of Souls\n  [209] = \"\",                 -- The Arcway\n  [210] = \"CoS\",              -- Court of Stars \n  [227] = \"\",                 -- Return to Karazhan: Lower\n  [233] = \"\",                 -- Cathedral of Eternal Night\n  [234] = \"\",                 -- Return to Karazhan: Upper\n  [239] = \"\",                 -- Seat of the Triumvirate\n  [244] = \"AD\",               -- Atal\n  [245] = \"FH\",               -- Freehold\n  [246] = \"\",                 -- Tol Dagor\n  [247] = \"ML\",                 -- The MOTHERLODE!!\n  [248] = \"Waycrest\",         -- Waycrest Manor\n  [249] = \"\",                 -- Kings' Rest\n  [250] = \"\",                 -- Temple of Sethraliss\n  [251] = \"UR\",               -- Underrot\n  [252] = \"\",                 -- Shrine of the Storm\n  [353] = \"Siege\",            -- Siege of Boralus\n  [369] = \"Mechagon\",         -- Operation: Mechagon - Junkyard\n  [370] = \"Mechagon\",         -- Operation: Mechagon - Workshop\n  [375] = \"Mists\",            -- Mists\n  [376] = \"Kyrian Weapon\",    -- Necrotic Wake\n  [377] = \"DOS\",              -- De Other Side\n  [378] = \"HoA\",              -- Halls of Atonement\n  [379] = \"PF\",               -- Plaguefall\n  [380] = \"SD\",               -- Sanguine Depths\n  [381] = \"SoA\",              -- Spires of Ascension\n  [382] = \"ToP\",              -- Theater of Pain\n  [391] = \"Tazavesh\",         -- Tazavesh: Streets of Wonder\n  [392] = \"Tazavesh\",         -- Tazavesh: So'leah's Gambit\n  [399] = \"RLP\",              -- Ruby Life Pools\n  [400] = \"NO\",               -- Nokhud Offensive\n  [401] = \"AV\",               -- Azure Vault\n  [402] = \"AA\",               -- Algethar Academy\n  [403] = \"Uldaman\",          -- Uldaman\n  [404] = \"Neltharus\",        -- Neltharus\n  [405] = \"Brokeback Hollow\", -- Brackenhide Hollow\n  [406] = \"HoI\",              -- Halls of Infusion\n  [438] = \"Vortex Pineapple\", -- Vortex Pinnacle\n  [456] = \"THOT\",             -- Throne of the Tides\n  [463] = \"DOTI\",             -- DOTI Upper\n  [464] = \"DOTI\",             -- DOTI LOWER\n  [499] = \"Priory\",           -- Priory of the Sacred Flame\n  [500] = \"Rookery\",          -- The Rookery\n  [501] = \"SV\",               -- Stonevault\n  [502] = \"Threads\",          -- City of Threads\n  [503] = \"Ara Ara~\",         -- Ara Ara\n  [504] = \"DFC\",              -- Darkflame Cleft\n  [505] = \"Dawnbreaker\",      -- The Dawnbreaker\n  [506] = \"Meadery\",          -- Cinderbrew Meadery\n  [507] = \"GB\",               -- Grim Batol\n  [525] = \"Flood\",            -- Operation Floodgate\n}\n\n\naura_env.createdButtons = {}\n\naura_env.handleSpecialMaps = function(mapID)\n  local spellID = -1\n  -- Siege of Boralus\n  if mapID == 353 then\n    local playerFaction = UnitFactionGroup(\"player\")\n    if playerFaction == \"Alliance\" then\n      spellID = 445418\n    else\n      spellID = 464256\n    end\n  end\n  -- MOTHERLODE\n  if mapID == 247 then\n    local playerFaction = UnitFactionGroup(\"player\")\n    if playerFaction == \"Alliance\" then\n      spellID = 467553\n    else\n      spellID = 467555\n    end\n  end\n  return spellID\nend\n\naura_env.init = function()\n  if InCombatLockdown() then\n    return\n  end\n  \n  local shownButtons = 0\n  \n  for i, mapID in ipairs(C_ChallengeMode.GetMapTable()) do\n    \n    local mapName = aura_env.mapIDtoName[mapID]\n    local spellID = aura_env.mapIDtoSpellID[mapID]\n    \n    if spellID == -1 then\n      spellID = aura_env.handleSpecialMaps(mapID)\n    end\n    \n    \n    if (mapName and spellID and IsSpellKnown(spellID) and not aura_env.createdButtons[spellID]) then\n      local frameName = aura_env.id .. mapID\n      \n      if not _G[frameName] then\n        CreateFrame(\"Button\", frameName, aura_env.region, \"SecureActionButtonTemplate\")\n      end\n      \n      local button = _G[frameName]\n      button:SetAttribute(\"type\", \"spell\")\n      button:SetAttribute(\"spell\", spellID)\n      button:SetAttribute(\"unit\", \"player\")\n      button:RegisterForClicks(\"LeftButtonUp\", \"LeftButtonDown\")\n      button:SetPoint(\"CENTER\", aura_env.region, \"CENTER\", 0, -shownButtons * (aura_env.region:GetHeight()+2))\n      button:SetWidth(aura_env.region:GetWidth())\n      button:SetHeight(aura_env.region:GetHeight())\n      button:Show()\n      \n      if not button.tex then\n        button.tex = button:CreateTexture()\n      end\n      button.tex:SetAllPoints(button)\n      button.tex:SetTexture(C_Spell.GetSpellTexture(spellID))\n      button.tex:Show()\n      \n      if not button.cd then\n        button.cd = CreateFrame(\"Cooldown\", frameName .. \"cd\", button, \"CooldownFrameTemplate\")\n      end\n      button.cd:SetAllPoints(button)\n      \n      if not button.text then\n        button.text = button:CreateFontString()\n      end\n      button.text:ClearAllPoints()\n      if aura_env.config[\"textanchor\"] == 1 then\n        button.text:SetPoint(\"RIGHT\", button, \"LEFT\", -5, 0)\n      else\n        button.text:SetPoint(\"LEFT\", button, \"RIGHT\", 5, 0)\n      end\n      button.text:SetFont(\"Fonts\\\\FRIZQT__.TTF\", 12, \"OUTLINE\")\n      button.text:SetText(mapName)\n      button.text:Show()\n      aura_env.createdButtons[spellID] = true\n      shownButtons = shownButtons + 1\n    end\n    \n  end\nend\n\naura_env.updateCooldowns = function()\n  for i, mapID in ipairs(C_ChallengeMode.GetMapTable()) do\n    local spellID = aura_env.mapIDtoSpellID[mapID]\n    \n    if spellID == -1 then\n      spellID = aura_env.handleSpecialMaps(mapID)\n    end\n    \n    local frameName = aura_env.id .. mapID \n    local button = _G[frameName]\n    if button then\n      local cooldownInfo = C_Spell.GetSpellCooldown(spellID)\n      if cooldownInfo.duration ~= nil and cooldownInfo.duration > 2 then\n        button.cd:SetCooldown(cooldownInfo.startTime, cooldownInfo.duration)\n      else\n        button.cd:SetCooldown(0, 0)\n      end\n    end\n  end\nend\n\n\naura_env.init()\naura_env.updateCooldowns()",
["do_custom"] = true,
},
["finish"] = {
["do_custom"] = false,
},
},
},
