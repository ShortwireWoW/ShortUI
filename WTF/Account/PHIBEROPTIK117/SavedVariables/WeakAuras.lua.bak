["event"] = "Health",
["unit"] = "player",
["events"] = "UNIT_SPELLCAST_START:boss",
["custom"] = "function(allstates, event, ...)\n    if event == \"UNIT_SPELLCAST_START\" then\n        local unit, castGUID, spellID = ...\n        \n        if not castGUID then return end\n        \n        if spellID == 466178 then -- Lightning Bash\n            local targetUnit = unit .. \"target\"\n            \n            if not UnitExists(targetUnit) then return end\n            \n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 4,\n                expirationTime = GetTime() + 4,\n                unit = targetUnit,\n                autoHide = true\n            }\n            \n            return true\n        end\n    end\nend",
