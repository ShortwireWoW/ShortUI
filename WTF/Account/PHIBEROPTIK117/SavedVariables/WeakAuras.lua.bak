["customText"] = "function()\n    if aura_env.state and aura_env.state.unit then\n        local unit = aura_env.state.unit\n        if UnitExists(unit) and UnitIsDead(unit) and aura_env.config.use_dead_color then \n            local color = CreateColor(unpack(aura_env.config.color))\n            return color:WrapTextInColorCode(UnitName(unit))\n        else\n            return WA_ClassColorName(unit)\n        end\n        \n    end\nend\n\n\n",
