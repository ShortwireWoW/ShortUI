["Wrong Spec Dummy!"] = {
["outline"] = "OUTLINE",
["authorOptions"] = {
{
["fontSize"] = "large",
["type"] = "description",
["text"] = "Wrong Spec Dummy!",
["width"] = 2,
},
{
["type"] = "description",
["fontSize"] = "small",
["text"] = "Enter the exact names of your Spec Loadouts for each content type below. You can locate them in your Talent Tree selection menu. These appear at the bottom left and should be typed *EXACTLY* as they appear.",
["width"] = 2,
},
{
["type"] = "header",
["useName"] = true,
["text"] = "Seriously, check your typing.",
["width"] = 1,
},
{
["type"] = "input",
["useDesc"] = true,
["width"] = 2,
["desc"] = "This is the spec loadout you want to use in PVE Raids.",
["default"] = "",
["multiline"] = false,
["name"] = "Raids",
["length"] = 10,
["key"] = "wrong_spec_dummy_raids",
["useLength"] = false,
},
{
["type"] = "input",
["useDesc"] = true,
["width"] = 2,
["desc"] = "This is the spec loadout you want to use in Mythic+",
["name"] = "Mythic+",
["key"] = "wrong_spec_dummy_mplus",
["default"] = "",
["length"] = 10,
["multiline"] = false,
["useLength"] = false,
},
{
["type"] = "input",
["useDesc"] = true,
["width"] = 2,
["desc"] = "This is the spec loadout you want to use in Delves",
["key"] = "wrong_spec_dummy_delves",
["multiline"] = false,
["name"] = "Delves",
["length"] = 10,
["default"] = "",
