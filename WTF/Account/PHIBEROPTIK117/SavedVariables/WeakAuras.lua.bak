["triggers"] = {
{
["trigger"] = {
["type"] = "unit",
["use_absorbHealMode"] = true,
["subeventSuffix"] = "_CAST_START",
["use_absorbMode"] = true,
["event"] = "Conditions",
["unit"] = "player",
["spellIds"] = {
},
["use_alwaystrue"] = true,
