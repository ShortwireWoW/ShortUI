},
["internalVersion"] = 84,
["keepAspectRatio"] = false,
["selfPoint"] = "CENTER",
["desc"] = "Created by Bloom\n\nInspired by Fail's Oribos WA\n\nRequires you to be in Timeways to work",
["version"] = 7,
["subRegions"] = {
{
["type"] = "subbackground",
},
},
["height"] = 64,
