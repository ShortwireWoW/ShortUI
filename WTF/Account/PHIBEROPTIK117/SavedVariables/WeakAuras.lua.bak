["shadowXOffset"] = 1,
["displayText_format_p_format"] = "timed",
["displayText"] = "Triple (%p)",
["conditions"] = {
{
["check"] = {
["trigger"] = 1,
["variable"] = "show",
["value"] = 1,
},
["changes"] = {
{
["value"] = "Single (%p)",
["property"] = "displayText",
},
{
["value"] = {
["custom"] = "local hasAddOn = C_AddOns.IsAddOnLoaded(\"SharedMedia_Causese\")\nif hasAddOn then\n    local voiceID\n    for _, voice in pairs(C_VoiceChat.GetTtsVoices()) do\n        if string.match(voice.name, \"Zira\") then\n            voiceID = voice.voiceID\n            break\n        end\n    end\n    if voiceID then\n        local stacks = aura_env.state.stacks\n        C_VoiceChat.SpeakText(voiceID, \"Single\", 1, 0.5, GetCVar(\"Sound_MasterVolume\")*100)\n    end\nend",
},
["property"] = "customcode",
},
},
},
{
