["Gallywix - Soak Positions"] = {
["authorOptions"] = {
},
["yOffset"] = -225.6409606933594,
["anchorPoint"] = "CENTER",
["actions"] = {
["start"] = {
["do_custom"] = false,
["custom"] = "aura_env.playerHasDebuff = true\naura_env.UpdateCircleColor()",
["do_sound"] = false,
},
["finish"] = {
["do_custom"] = false,
["custom"] = "aura_env.playerHasDebuff = false\naura_env.UpdateCircleColor()\n\n-- Schedule a full reset in 2 seconds to catch end of debuff globally\nC_Timer.After(2, function()\n        local anyoneHasDebuff = false\n        for i = 1, GetNumGroupMembers() do\n            if UnitDebuff(\"raid\" .. i, \"Fused Canisters\") then\n                anyoneHasDebuff = true\n                break\n            end\n        end\n        \n        if not anyoneHasDebuff then\n            aura_env.bossCasting = false\n            aura_env.UpdateCircleColor()\n        end\nend)\n\n\n",
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.debug = false  -- toggle to true for debug prints\n\nif not aura_env.region.customObjects then\n    aura_env.region.customObjects = {}\nend\n\naura_env.playerHasDebuff = false\nlocal obj = aura_env.region.customObjects\n\n-- Skull Icon (create only once)\nif not obj.skull then\n    obj.skull = aura_env.region:CreateTexture(nil, \"ARTWORK\")\n    obj.skull:SetTexture(\"Interface\\\\TargetingFrame\\\\UI-RaidTargetingIcon_8\")\n    obj.skull:SetSize(40, 40)\n    obj.skull:SetPoint(\"CENTER\", aura_env.region, \"CENTER\", 0, 100)  -- Moved up\nend\n\n-- Circle layout config\nlocal radius = 40\nlocal spacing = radius\nlocal up = spacing * 0.866\n\n-- Top-left Circle\nif not obj.circle1 then\n    obj.circle1 = aura_env.region:CreateTexture(nil, \"ARTWORK\")\n    obj.circle1:SetTexture(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Circle_White\")\n    obj.circle1:SetSize(radius * 2, radius * 2)\n    obj.circle1:SetPoint(\"CENTER\", aura_env.region, \"CENTER\", -spacing, up)\nend\n\n-- Top-right Circle\nif not obj.circle2 then\n    obj.circle2 = aura_env.region:CreateTexture(nil, \"ARTWORK\")\n    obj.circle2:SetTexture(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Circle_White\")\n    obj.circle2:SetSize(radius * 2, radius * 2)\n    obj.circle2:SetPoint(\"CENTER\", aura_env.region, \"CENTER\", spacing, up)\nend\n\n-- Bottom Circle\nif not obj.circle3 then\n    obj.circle3 = aura_env.region:CreateTexture(nil, \"ARTWORK\")\n    obj.circle3:SetTexture(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Circle_White\")\n    obj.circle3:SetSize(radius * 2, radius * 2)\n    obj.circle3:SetPoint(\"CENTER\", aura_env.region, \"CENTER\", 0, -up)\nend\n\nfunction aura_env.UpdateCircleColor()\n    local id = aura_env.assignedCircle\n    if not id then return end\n    \n    local obj = aura_env.region.customObjects\n    local circle = obj and obj[\"circle\" .. id]\n    if not circle then return end\n    \n    local color = \"white\"\n    if aura_env.bossCasting then\n        if aura_env.playerHasDebuff then\n            color = \"yellow\"\n        else\n            color = \"green\"\n        end\n    end\n    \n    local r, g, b = 1, 1, 1\n    if color == \"green\" then r, g, b = 0, 1, 0 end\n    if color == \"yellow\" then r, g, b = 1, 1, 0 end\n    \n    circle:SetVertexColor(r, g, b, 1)\n    \n    if aura_env.debug then\n        print(\"Circle updated to\", color)\n    end\nend",
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "unit",
["use_absorbHealMode"] = true,
["subeventSuffix"] = "_CAST_START",
["use_absorbMode"] = true,
