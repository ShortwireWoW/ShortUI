["use_absorbHealMode"] = true,
["subeventSuffix"] = "_CAST_START",
["unit"] = "player",
["event"] = "Boss Mod Timer",
["type"] = "addons",
["spellIds"] = {
},
["use_spellId"] = true,
["count"] = "",
["names"] = {
