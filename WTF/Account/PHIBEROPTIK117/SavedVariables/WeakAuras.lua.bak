["customTextUpdate"] = "event",
["actions"] = {
["start"] = {
["do_custom"] = false,
["custom"] = "",
["sound"] = "Interface\\Addons\\WeakAuras\\PowerAurasMedia\\Sounds\\chant4.ogg",
["do_sound"] = false,
},
