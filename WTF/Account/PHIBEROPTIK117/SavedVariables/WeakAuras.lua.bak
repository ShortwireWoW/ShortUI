["custom"] = "-- MACRO: /run if UnitExists(\"target\") then C_ChatInfo.SendAddonMessage(\"SHORT_RI\", UnitName(\"target\"), \"WHISPER\", UnitName(\"player\")) end\n\nfunction(event, prefix, msg, channel, sender)\n    if prefix ~= \"SHORT_RI\" or not msg then return end\n    \n    -- Boss instruction strings (plain text, no formatting)\n    local bosses = {\n        [1] = aura_env.config.vexie_ri,\n        [2] = aura_env.config.coc_ri,\n        [3] = aura_env.config.rikreverb_ri,\n        [4] = aura_env.config.stix_ri,\n        [5] = aura_env.config.sprocket_ri,\n        [6] = aura_env.config.oab_ri,\n        [7] = aura_env.config.mugzee_ri,\n        [8] = aura_env.config.gallywix_ri,\n    }\n    \n    local bossMap = {\n        [\"The Geargrinder\"] = 1,\n        [\"Torq\"] = 2,\n        [\"Flarendo\"] = 2,\n        [\"Rik Reverb\"] = 3,\n        [\"Sprocketmonger Lockenstock\"] = 4,\n        [\"Stix Bunkjunker\"] = 5,\n        [\"One-Armed Bandit\"] = 6,\n        [\"Mug'Zee\"] = 7,\n        [\"Chrome King Gallywix\"] = 8,\n        [\"Custodian Khubon\"] = 7, -- debug\n    }\n    \n    local bossIndex = bossMap[msg]\n    if not bossIndex then return end\n    \n    local instructions = bosses[bossIndex]\n    if type(instructions) ~= \"string\" then return end\n    \n    -- Strip formatting tags like $TAG$\n    instructions = instructions:gsub(\"%$(.-)%$\", \"\")\n    \n    -- Split into lines\n    local lines = {}\n    for line in instructions:gmatch(\"([^\\r\\n]+)\") do\n        table.insert(lines, line)\n    end\n    \n    -- Send one line at a time with delay\n    local i = 1\n    local delay = 0.5\n    local function sendLines()\n        if i <= #lines then\n            if aura_env.config.debug_ri then\n                print(lines[i])\n            else\n                SendChatMessage(lines[i], \"RAID\")\n            end\n            i = i + 1\n            C_Timer.After(delay, sendLines)\n        end\n    end\n    \n    sendLines()\n    return true\nend\n\n\n",
