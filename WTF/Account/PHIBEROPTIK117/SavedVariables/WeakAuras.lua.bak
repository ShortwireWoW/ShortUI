["Gateway Control Shard"] = {
["outline"] = "OUTLINE",
["authorOptions"] = {
},
["displayText"] = "Gateway Usable",
["shadowYOffset"] = -1,
["anchorPoint"] = "TOP",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "function aura_env.getGatewayID()\n    local id\n    for i=1,200 do\n        id = select(2,GetActionInfo(i))\n        if id == 188152 then --Gateway Control Shard\n            aura_env.actionId = i\n            break\n        end\n    end\nend\n\naura_env.getGatewayID()",
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["custom_hide"] = "custom",
["type"] = "custom",
["custom_type"] = "event",
["subeventSuffix"] = "_CAST_START",
["names"] = {
},
["use_genericShowOn"] = true,
["event"] = "Cooldown Ready (Item)",
["unit"] = "player",
["custom"] = "function(event)\n    if event == \"ACTIONBAR_UPDATE_USABLE\" then\n        if IsUsableAction(aura_env.actionId) then\n            return true\n        end\n    elseif event == \"ACTIONBAR_SLOT_CHANGED\" then\n        aura_env.getGatewayID()\n    end\nend",
["events"] = "ACTIONBAR_UPDATE_USABLE ACTIONBAR_SLOT_CHANGED",
["spellIds"] = {
},
["subeventPrefix"] = "SPELL",
["itemName"] = 188152,
["genericShowOn"] = "showOnCooldown",
["use_itemName"] = true,
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
["custom"] = "function(event)\n    local actionSlot = aura_env.actionId  -- Ensure this is the action slot number (1-120)\n    \n    -- Check if the action is usable in the action slot\n    if actionSlot and not IsUsableAction(actionSlot) then\n        return true\n    end\nend",
},
},
