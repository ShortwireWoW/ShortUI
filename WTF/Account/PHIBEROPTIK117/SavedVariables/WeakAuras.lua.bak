["event"] = "Health",
["subeventPrefix"] = "SPELL",
["custom"] = "function()\n    -- Only meaningful in raid groups\n    if not IsInRaid() then\n        return false\n    end\n    \n    -- Get the player's subgroup (1-8)\n    local _, _, subgroup = GetRaidRosterInfo(UnitInRaid(\"player\") + 1)\n    if not subgroup then\n        return false\n    end\n    \n    -- Return true if subgroup is odd (1,3,5,7)\n    return subgroup % 2 == 1\nend",
