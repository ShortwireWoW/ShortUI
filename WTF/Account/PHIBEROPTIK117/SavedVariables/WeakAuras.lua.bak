["[Shortwire] TWW - PVE Stats"] = {
["outline"] = "OUTLINE",
["wagoID"] = "AOOx9RaVV",
["color"] = {
1,
1,
1,
1,
},
["preferToUpdate"] = true,
["customText"] = "function()\n    \n    \n    -- [[ ################################ DISCLAIMER! ################################ ]]\n    --\n    --     ** SIMMING YOUR CHARACTER WILL ALWAYS GIVE YOU THE BEST RESULTS. **\n    --\n    --     NOTE: All data is gathered from archon.gg and wowhead to supplement.\n    --\n    --     EXAMPLE: As of TWW S1, Frost DK both Raids and Mythic+ as Deathbring.\n    --     Archon.gg only shows the stat prio of that one spec. I have used wowhead\n    --     to supplement the stat prio for those who wish to play Riders of the Apocalypse.\n    --\n    --\n    --     https://www.archon.gg/wow/articles/help/archon-disclaimers-and-faq\n    --\n    --     LAST UPDATED: 2/7/2025 - Archon.gg // wowhead.com\n    --\n    -- [[ ############################################################################# ]]\n    \n    \n    local _,myclass,_= UnitClass(\"player\");\n    local currentSpec = GetSpecialization()\n    local currentSpecName = currentSpec and select(2, GetSpecializationInfo(currentSpec)) or \"None\"\n    local spec = (string.upper(currentSpecName))\n    local heroId = C_ClassTalents.GetActiveHeroTalentSpec()\n    local config = aura_env.config\n    if config.sui_playerstats_custom_enable then\n        return config.sui_playerstats_custom_prio\n    end\n    \n    local t = \"|c00FFFF00Stat Prio: |r\"\n    local r = \"|c00FFFFFF[R] |r\"\n    local m = \"|c00FFFFFF[M] |r\"\n    local b = \"|c00FFFFFF[R/M] |r\"\n    local s = \"|c00FFFFFF[S] |r\"\n    local e = \"|c00C41E3AERROR: This Spec does not support this hero talent.|r\"\n    \n    if config.sui_playerstats_debug then\n        print(\"\\n\\n\\n\\n\\n\")\n        print(\"####################\")        \n        print(\"[Shortwire] TWW - PVE Stats DEBUGGER\")        \n        print(\"CLASS: \" .. myclass)\n        print(\"SPEC: \" .. spec)        \n        if heroId ~= nil then\n            print(\"HEROID: \" .. heroId)\n        end\n        print(\"####################\")        \n    end\n    \n    local stats = -- [1] = Raid Stats, [2] = Mythic+ stats. Adjust accordingly.\n    {\n        DEATHKNIGHT = \n        {\n            FROST = \n            {\n                [31] = e, -- San'layn\n                [32] = t .. s .. aura_env.suitwwpvestats_dk_frost_rota, -- Riders of the Apocalypse (wowhead.com / supplement)\n                [33] = t .. b .. aura_env.suitwwpvestats_dk_frost_db, -- Deathbringer (archon.gg / raid & m+)\n            },\n            UNHOLY = \n            {\n                [31] = t .. s .. aura_env.suitwwpvestats_dk_unholy_sl, -- San'layn (wowhead.com / supplement)\n                [32] = t .. b .. aura_env.suitwwpvestats_dk_unholy_rota, -- Riders of the Apocalypse (archon.gg / raid & m+)\n                [33] = e, -- Deathbringer\n            },\n            BLOOD = \n            {\n                [31] = t .. r .. aura_env.suitwwpvestats_dk_blood_sl, -- San'layn (archon.gg / raid)\n                [32] = e, -- Riders of the Apocalypse\n                [33] = t .. m .. aura_env.suitwwpvestats_dk_blood_db, -- Deathbringer (archon.gg / m+)\n            },\n        },\n        DEMONHUNTER = \n        {\n            HAVOC = \n            {\n                [34] = t .. b .. aura_env.suitwwpvestats_dh_havoc_fs, -- Fel-Scarred (archon.gg / raid & m+)\n                [35] = t .. s .. aura_env.suitwwpvestats_dh_havoc_ar, -- Aldrachi Reaver (wowhead.com / supplement)\n            },\n            \n            VENGEANCE = \n            {\n                [34] = t .. b .. aura_env.suitwwpvestats_dh_vengeance_fs, -- Fel-Scarred (archon.gg / raid & m+)\n                [35] = t .. s .. aura_env.suitwwpvestats_dh_vengeance_ar,-- Aldrachi Reaver (wowhead.com / supplement)\n            },\n            \n            -- Coming in Midnight Expansion\n            --             DEVOURER = \n            --            {\n            --                [34] = t .. b .. aura_env.suitwwpvestats_dh_devourer_fs, -- Fel-Scarred (archon.gg / raid & m+)\n            --                [35] = t .. s .. aura_env.suitwwpvestats_dh_devourer_ar,-- Aldrachi Reaver (wowhead.com / supplement)\n            --            },\n            --\n        },\n        DRUID = \n        {\n            BALANCE = \n            {\n                [21] = e, -- Druid of the Claw\n                [22] = e, -- Wildstalker\n                [23] = t .. r .. aura_env.suitwwpvestats_druid_balance_kotg, -- Keeper of the Grove (archon.gg / raid)\n                [24] = t .. m .. aura_env.suitwwpvestats_druid_balance_ec, -- Elune's Chosen (archon.gg / m+)\n            },\n            \n            FERAL = \n            {\n                [21] = t .. b .. aura_env.suitwwpvestats_druid_feral_dotc, -- Druid of the Claw (archon.gg / raid & m+)\n                [22] = t .. s .. aura_env.suitwwpvestats_druid_feral_ws, -- Wildstalker (wowhead.com / supplement)\n                [23] = e, -- Keeper of the Grove\n                [24] = e, -- Elune's Chosen \n            },\n            GUARDIAN = \n            {\n                [21] = t .. r .. aura_env.suitwwpvestats_druid_guardian_dotc, -- Druid of the Claw (archon.gg / raid)\n                [22] = e, -- Wildstalker\n                [23] = e, -- Keeper of the Grove\n                [24] = t .. m .. aura_env.suitwwpvestats_druid_guardian_ec, -- Elune's Chosen (archon.gg / m+)\n            },\n            \n            RESTORATION = \n            {\n                [21] = e, -- Druid of the Claw\n                [22] = t .. m .. aura_env.suitwwpvestats_druid_restoration_ws, -- Wildstalker (archon.gg / m+)\n                [23] = t .. r .. aura_env.suitwwpvestats_druid_restoration_kotg, -- Keeper of the Grove (archon.gg / raid)\n                [24] = e, -- Elune's Chosen\n            },\n        },\n        EVOKER = \n        {\n            DEVASTATION = \n            {\n                [36] = t .. b .. aura_env.suitwwpvestats_evoker_dev_sc, -- Scalecommander (archon.gg / raid & m+)\n                [37] = t .. s .. aura_env.suitwwpvestats_evoker_dev_fs, -- Flameshaper (wowhead.com / supplement)\n                [38] = e, -- Chronowarden\n            },\n            PRESERVATION = \n            {\n                [36] = e, -- Scalecommander\n                [37] = t .. r .. aura_env.suitwwpvestats_evoker_pres_fs, -- Flameshaper (archon.gg / raid)\n                [38] = t .. m .. aura_env.suitwwpvestats_evoker_pres_cw, -- Chronowarden (archon.gg / m+)\n            },\n            AUGMENTATION = \n            {\n                [36] = t .. b .. aura_env.suitwwpvestats_evoker_aug_sc, -- Scalecommander (archon.gg / raid & m+)\n                [37] = e, -- Flameshaper\n                [38] = t .. s .. aura_env.suitwwpvestats_evoker_aug_cw, -- Chronowarden (wowhead.com / supplement)\n            },\n        },\n        HUNTER = \n        {\n            [\"BEAST MASTERY\"] = \n            {\n                [42] = e, -- Sentinel\n                [43] = t .. r .. aura_env.suitwwpvestats_hunter_bm_pl, -- Pack Leader (archon.gg / raid)\n                [44] = t .. m .. aura_env.suitwwpvestats_hunter_bm_dr, -- Dark Ranger (archon.gg / m+)\n            },\n            MARKSMANSHIP = \n            {\n                [42] = t .. m .. aura_env.suitwwpvestats_hunter_mm_st, -- Sentinel (archon.gg / m+)\n                [43] = e, -- Pack Leader\n                [44] = t .. r .. aura_env.suitwwpvestats_hunter_mm_dr, -- Dark Ranger (archon.gg / raid)\n            },\n            SURVIVAL = \n            {\n                [42] = t .. m .. aura_env.suitwwpvestats_hunter_surv_st, -- Sentinel (archon.gg / m+)\n                [43] = t .. r .. aura_env.suitwwpvestats_hunter_surv_pl, -- Pack Leader (archon.gg / raid)\n                [44] = e, -- Dark Ranger\n            },\n        },\n        MAGE = \n        {\n            ARCANE = \n            {\n                [39] = t .. s .. aura_env.suitwwpvestats_mage_arcane_sf, -- Sunfury (wowhead.com / supplement)\n                [40] = t .. b .. aura_env.suitwwpvestats_mage_arcane_ss, -- Spellslinger (archon.gg / raid & m+)\n                [41] = e, -- Frostfire\n            },\n            FIRE = \n            {\n                [39] = t .. s .. aura_env.suitwwpvestats_mage_fire_sf, -- Sunfury (wowhead.com / supplement)\n                [40] = e, -- Spellslinger\n                [41] = t .. b .. aura_env.suitwwpvestats_mage_fire_ff, -- Frostfire (archon.gg / raid & m+)\n            },\n            FROST = \n            {\n                [39] = e, -- Sunfury\n                [40] = t .. r .. aura_env.suitwwpvestats_mage_frost_ss, -- Spellslinger (archon.gg / raid)\n                [41] = t .. m .. aura_env.suitwwpvestats_mage_frost_fr, -- Frostfire (archon.gg / m+)\n            },\n        },\n        MONK = \n        {            \n            WINDWALKER = \n            {\n                [64] = t .. s .. aura_env.suitwwpvestats_monk_ww_cotc, -- Conduit of the Celestials (wowhead.com / supplement)\n                [65] = t .. b .. aura_env.suitwwpvestats_monk_ww_sp, -- Shado-pan (archon.gg / raid & m+)\n                [66] = e, -- Master of Harmony\n            },\n            BREWMASTER = \n            {\n                [64] = e, -- Conduit of the Celestials\n                [65] = t .. b .. aura_env.suitwwpvestats_monk_bm_sp, -- Shado-pan (archon.gg / raid & m+)\n                [66] = t .. s .. aura_env.suitwwpvestats_monk_bm_moh, -- Master of Harmony (wowhead.com / supplement)\n            },\n            MISTWEAVER = \n            {\n                [64] = t .. r .. aura_env.suitwwpvestats_monk_mw_cotc, -- Conduit of the Celestials (archon.gg / raid)\n                [65] = e, -- Shado-pan\n                [66] = t .. m .. aura_env.suitwwpvestats_monk_mw_moh, -- Master of Harmony (archon.gg / m+)\n            },\n        },\n        PALADIN = \n        {\n            RETRIBUTION = \n            {\n                [48] = t .. b .. aura_env.suitwwpvestats_paladin_ret_tmp, -- Templar (archon.gg / raid & m+)\n                [49] = e, -- Lightsmith\n                [50] = t .. s .. aura_env.suitwwpvestats_paladin_ret_hots, -- Herald of the Sun (wowhead.com / supplement)\n            },\n            PROTECTION = \n            {\n                [48] = t .. s .. aura_env.suitwwpvestats_paladin_prot_tmp, -- Templar (wowhead.com / supplement)\n                [49] = t .. b .. aura_env.suitwwpvestats_paladin_prot_ls, -- Lightsmith (archon.gg / raid & m+)\n                [50] = e, -- Herald of the Sun\n            },\n            HOLY = \n            {\n                [48] = e, -- Templar\n                [49] = t .. b .. aura_env.suitwwpvestats_paladin_holy_ls, -- Lightsmith (archon.gg / raid & m+)\n                [50] = t .. s .. aura_env.suitwwpvestats_paladin_holy_hots, -- Herald of the Sun (wowhead.com / supplement)\n            },\n        },\n        PRIEST = \n        {\n            SHADOW = \n            {\n                [18] = t .. s .. aura_env.suitwwpvestats_priest_shadow_vw, -- Voidweaver (wowhead.com / supplement)\n                [19] = t .. r .. aura_env.suitwwpvestats_priest_shadow_arc, -- Archon (archon.gg / raid & m+)\n                [20] = e, -- Oracle\n            },\n            DISCIPLINE = \n            {\n                [18] = t .. r .. aura_env.suitwwpvestats_priest_disc_vw, -- Voidweaver (archon.gg / raid & m+)\n                [19] = e, -- Archon\n                [20] = t .. r .. aura_env.suitwwpvestats_priest_disc_ora, -- Oracle (wowhead.com / supplement)\n            },\n            HOLY = \n            {\n                [18] = e, -- Voidweaver\n                [19] = t .. r .. aura_env.suitwwpvestats_priest_holy_arc, -- Archon (archon.gg / raid)\n                [20] = t .. m .. aura_env.suitwwpvestats_priest_holy_ora, -- Oracle (archon.gg / m+)\n            },\n        },\n        ROGUE = \n        {\n            ASSASSINATION = \n            {\n                [51] = e, -- Trickster\n                [52] = t .. s .. aura_env.suitwwpvestats_rogue_assn_fb, -- Fatebound (wowhead.com / supplement)\n                [53] = t .. b .. aura_env.suitwwpvestats_rogue_assn_ds, -- Deathstalker (archon.gg / raid & m+)\n            },\n            OUTLAW = \n            {\n                [51] = t .. s .. aura_env.suitwwpvestats_rogue_outlaw_tr, -- Trickster (wowhead.com / supplement)\n                [52] = t .. b .. aura_env.suitwwpvestats_rogue_outlaw_fr, -- Fatebound (archon.gg / raid & m+)\n                [53] = e, -- Deathstalker\n            },\n            SUBTLETY = \n            {\n                [51] = t .. m .. aura_env.suitwwpvestats_rogue_sub_tr, -- Trickster (archon.gg / m+)\n                [52] = e, -- Fatebound\n                [53] = t .. r .. aura_env.suitwwpvestats_rogue_sub_ds, -- Deathstalker (archon.gg / raid)\n            },\n        },\n        SHAMAN = \n        {\n            ELEMENTAL = \n            {\n                [54] = e, -- Totemic\n                [55] = t .. m .. aura_env.suitwwpvestats_shaman_ele_sb, -- Stormbringer (archon.gg / m+)\n                [56] = t .. r .. aura_env.suitwwpvestats_shaman_ele_fs, -- Farseer (archon.gg / raid)\n            },\n            ENHANCEMENT = \n            {\n                [54] = t .. r .. aura_env.suitwwpvestats_shaman_enh_tot, -- Totemic (archon.gg / raid)\n                [55] = t .. m .. aura_env.suitwwpvestats_shaman_enh_sb, -- Stormbringer (archon.gg / m+)\n                [56] = e, -- Farseer\n            },\n            RESTORATION = \n            {\n                [54] = t .. b .. aura_env.suitwwpvestats_shaman_resto_tot, -- Totemic (archon.gg / raid & m+)\n                [55] = e, -- Stormbringer\n                [56] = t .. s .. aura_env.suitwwpvestats_shaman_resto_fs, -- Farseer (wowhead.com / supplement)\n            },\n        },\n        WARLOCK = \n        {\n            AFFLICTION = \n            {\n                [57] = t .. r .. aura_env.suitwwpvestats_warlock_aff_sh, -- Soul Harvester (archon.gg / raid & m+)\n                [58] = t .. s .. aura_env.suitwwpvestats_warlock_aff_hc, -- Hellcaller (wowhead.com / supplement)\n                [59] = e, -- Diabolist\n            },\n            DEMONOLOGY = \n            {\n                [57] = t .. s .. aura_env.suitwwpvestats_warlock_demo_sh, -- Soul Harvester (wowhead.com / supplement)\n                [58] = e, -- Hellcaller\n                [59] = t .. b .. aura_env.suitwwpvestats_warlock_demo_dia, -- Diabolist (archon.gg / raid & m+)\n            },\n            DESTRUCTION = \n            {\n                [57] = e, -- Soul Harvester\n                [58] = t .. m .. aura_env.suitwwpvestats_warlock_dest_hc, -- Hellcaller (archon.gg / m+)\n                [59] = t .. r .. aura_env.suitwwpvestats_warlock_dest_dia, -- Diabolist (archon.gg / raid)\n            },\n        },\n        WARRIOR = \n        {\n            ARMS = \n            {\n                [60] = t .. r .. aura_env.suitwwpvestats_warrior_arms_sl, -- Slayer (archon.gg / raid)\n                [61] = e, -- Mountain Thane\n                [62] = t .. m .. aura_env.suitwwpvestats_warrior_arms_col, -- Colossus (archon.gg / m+)\n            },\n            FURY = \n            {\n                [60] = t .. r .. aura_env.suitwwpvestats_warrior_fury_sl, -- Slayer (archon.gg / raid)\n                [61] = t .. m .. aura_env.suitwwpvestats_warrior_fury_mt, -- Mountain Thane (archon.gg / m+)\n                [62] = e, -- Colossus\n            },\n            PROTECTION = \n            {\n                [60] = e, -- Slayer\n                [61] = t .. r .. aura_env.suitwwpvestats_warrior_prot_mt, -- Mountain Thane (archon.gg / raid & m+)\n                [62] = t .. s .. aura_env.suitwwpvestats_warrior_prot_col, -- Colossus (wowhead.com / supplement)\n            },\n        },\n    }\n    \n    -- Return custom priority if enabled, otherwise return the stat priority for the spec.\n    return enableCustomPrio and customPrio or (stats[myclass] and stats[myclass][spec] and stats[myclass][spec][heroId]) or e\nend",
["yOffset"] = -5,
["anchorPoint"] = "TOPRIGHT",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/AOOx9RaVV/10",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "-- SOURCES: WoWHead.com Guides.\n\n-- Death Knight.  Riders of the Apocalypse (rota), Deathbringer (db), San'layn (sl)\naura_env.suitwwpvestats_dk_frost_rota = \"ILVL>MAST>CRIT>HASTE>VERS\"\naura_env.suitwwpvestats_dk_frost_db = \"ILVL>MAST>CRIT>HASTE>VERS\"\naura_env.suitwwpvestats_dk_unholy_sl = \"ILVL>HASTE>MAST>CRIT>VERS\"\naura_env.suitwwpvestats_dk_unholy_rota = \"ILVL>HASTE>MAST>CRIT>VERS\"\naura_env.suitwwpvestats_dk_blood_sl = \"ILVL>HASTE>MAST=CRIT=VERS\"\naura_env.suitwwpvestats_dk_blood_db = \"ILVL>MAST=CRIT=VERS>HASTE\"\n\n-- Demon Hunter.  Fel-scarred (fs), Aldrachi Reaver (ar)\naura_env.suitwwpvestats_dh_havoc_fs = \"CRIT>MAST>HASTE>VERS>ILVL\"\naura_env.suitwwpvestats_dh_havoc_ar = \"CRIT>MAST>HASTE>VERS>ILVL\"\naura_env.suitwwpvestats_dh_vengeance_fs = \"ILVL>HASTE>CRIT>VERS>MAST\"\naura_env.suitwwpvestats_dh_vengeance_ar = \"ILVL>HASTE>CRIT>VERS>MAST\"\n--aura_env.suitwwpvestats_dh_devourer_fs = \"ILVL>HASTE>CRIT>VERS>MAST\"  COMING SOON\n--aura_env.suitwwpvestats_dh_devourer_ar = \"ILVL>HASTE>CRIT>VERS>MAST\"  COMING SOON\n\n-- Druid.  Keeper of the Grove (kotg), Elune's Chosen (ec), Druid of the Claw (dotc), Wildstalker (ws)\naura_env.suitwwpvestats_druid_balance_kotg = \"ILVL>MAST>CRIT>VERS>HASTE\"\naura_env.suitwwpvestats_druid_balance_ec = \"ILVL>MAST>HASTE>CRIT>VERS\"\naura_env.suitwwpvestats_druid_feral_dotc = \"ILVL>MAST>CRIT>HASTE>VERS\"\naura_env.suitwwpvestats_druid_feral_ws = \"ILVL>MAST>CRIT>HASTE>VERS\"\naura_env.suitwwpvestats_druid_guardian_dotc = \"ILVL>HASTE>VERS>MAST>CRIT\"\naura_env.suitwwpvestats_druid_guardian_ec = \"ILVL>HASTE>VERS>MAST>CRIT\"\naura_env.suitwwpvestats_druid_restoration_ws = \"ILVL>HASTE>MAST>VERS>CRIT\"\naura_env.suitwwpvestats_druid_restoration_kotg = \"ILVL>HASTE>MAST>VERS>CRIT\"\n\n-- Evoker.  Scalecommander (sc), Flameshaper (fs), Chronowarden (cw)\naura_env.suitwwpvestats_evoker_dev_sc = \"ILVL>CRIT>HASTE>VERS>MAST\"\naura_env.suitwwpvestats_evoker_dev_fs = \"ILVL>HASTE>CRRIT>VERS>MAST\"\naura_env.suitwwpvestats_evoker_pres_fs = \"ILVL>MAST>HASTE(15%)>CRIT>VERS>HASTE(15%+)\"\naura_env.suitwwpvestats_evoker_pres_cw = \"ILVL>MAST>CRIT>VERS>HASTE\"\naura_env.suitwwpvestats_evoker_aug_sc = \"ILVL>CRIT>HASTE>MAST>VERS\"\naura_env.suitwwpvestats_evoker_aug_cw = \"ILVL>MAST>CRIT>HASTE>VERS\"\n\n-- Hunter.  Pack Leader (pl), Dark Ranger (dr), Sentinel (st)\naura_env.suitwwpvestats_hunter_bm_pl = \"WEAP>HASTE>MAST=CRIT>VERS>ILVL\"\naura_env.suitwwpvestats_hunter_bm_dr = \"WEAP>HASTE>CRIT>VERS>MAST>ILVL\"\naura_env.suitwwpvestats_hunter_mm_st = \"ILVL>CRIT>MAST>VERS>HASTE\"\naura_env.suitwwpvestats_hunter_mm_dr = \"ILVL>CRIT>MAST>VERS>HASTE\"\naura_env.suitwwpvestats_hunter_surv_st = \"ILVL>MAST>HASTE>CRIT>VERS\"\naura_env.suitwwpvestats_hunter_surv_pl = \"ILVL>MAST>CRIT>HASTE>VERS\"\n\n-- Mage.  Sunfury (sf), Frostfire (ff), Spellslinger (ss)\naura_env.suitwwpvestats_mage_arcane_sf = \"ILVL>HASTE>VERS>MAST>CRIT\"\naura_env.suitwwpvestats_mage_arcane_ss = \"ILVL>HASTE>VERS>MAST>CRIT\"\naura_env.suitwwpvestats_mage_fire_sf = \"ILVL>HASTE>VERS>MAST>CRIT\"\naura_env.suitwwpvestats_mage_fire_ff = \"ILVL>HASTE>CRIT>VERS>MAST\"\naura_env.suitwwpvestats_mage_frost_ss = \"ILVL>HASTE>MAST>CRIT>VERS\"\naura_env.suitwwpvestats_mage_frost_fr = \"ILVL>HASTE>CRIT>VERS>MAST\"\n\n-- Monk.  Conduit of the Celestials (cotc), Shado-pan (sp), Master of Harmony (moh)\naura_env.suitwwpvestats_monk_ww_cotc = \"ILVL>MAST=HASTE>VERS=CRIT\"\naura_env.suitwwpvestats_monk_ww_sp = \"ILVL>MAST=HASTE>VERS=CRIT\"\naura_env.suitwwpvestats_monk_bm_sp = \"ILVL>VERS=CRIT=MAST>HASTE\"\naura_env.suitwwpvestats_monk_bm_moh = \"ILVL>VERS=CRIT=MAST>HASTE\"\naura_env.suitwwpvestats_monk_mw_cotc = \"ILVL>HASTE>VERS>CRIT>MAST\"\naura_env.suitwwpvestats_monk_mw_moh = \"ILVL>HASTE>CRIT>MAST>VERS\"\n\n-- Paladin.  Templar (tmp), Herald of the Sun (hots), Lightsmith (ls)\naura_env.suitwwpvestats_paladin_ret_tmp = \"ILVL>MAST>CRIT>HASTE>VERS\"\naura_env.suitwwpvestats_paladin_ret_hots = \"ILVL>MAST>CRIT>HASTE>VERS\"\naura_env.suitwwpvestats_paladin_prot_tmp = \"ILVL>HASTE>MAST>CRIT=VERS\"\naura_env.suitwwpvestats_paladin_prot_ls = \"ILVL>HASTE>CRIT>MAST=VERS\"\naura_env.suitwwpvestats_paladin_holy_ls = \"ILVL>HASTE=CRIT>MAST>VERS\"\naura_env.suitwwpvestats_paladin_holy_hots = \"ILVL>HASTE=MAST>CRIT>VERS\"\n\n-- Priest.  Voidweaver (vw), Archon (arc), Oracle (ora)\naura_env.suitwwpvestats_priest_shadow_vw = \"ILVL>HASTE(20-25%)>MAST(21%)>CRIT>VERS\"\naura_env.suitwwpvestats_priest_shadow_arc = \"ILVL>HASTE(30%)>MAST(21%)>CRIT>VERS\"\naura_env.suitwwpvestats_priest_disc_vw = \"ILVL>HASTE>CRIT=MAST>VERS\"\naura_env.suitwwpvestats_priest_disc_ora = \"ILVL>HASTE(20%)>CRIT=MAST>HASTE(20%+)>VERS\"\naura_env.suitwwpvestats_priest_holy_arc = \"ILVL>CRIT>MAST>VERS>HASTE\"\naura_env.suitwwpvestats_priest_holy_ora = \"ILVL>CRIT>MAST>VERS>HASTE\"\n\n-- Rogue.  Fatebound (fb), Deathstalker (ds), Trickster (tr)\naura_env.suitwwpvestats_rogue_assn_fb = \"ILVL>MAST>CRIT>HASTE>VERS\"\naura_env.suitwwpvestats_rogue_assn_ds = \"ILVL>MAST>CRIT>HASTE>VERS\"\naura_env.suitwwpvestats_rogue_outlaw_tr = \"ILVL>VERS>HASTE>CRIT>MAST\"\naura_env.suitwwpvestats_rogue_outlaw_fr = \"ILVL>VERS>HASTE>CRIT>MAST\"\naura_env.suitwwpvestats_rogue_sub_tr = \"ILVL>MAST>VERS>CRIT>HASTE\"\naura_env.suitwwpvestats_rogue_sub_ds = \"ILVL>MAST>VERS>CRIT>HASTE\"\n\n-- Shaman.  Stormbringer (sb), Farseer (fs), Totemic (tot)\naura_env.suitwwpvestats_shaman_ele_sb = \"MAST>HASTE>VERS>CRIT>ILVL\"\naura_env.suitwwpvestats_shaman_ele_fs = \"MAST>HASTE>VERS>CRIT>ILVL\"\naura_env.suitwwpvestats_shaman_enh_tot = \"HASTE>MAST>CRIT>VERS>ILVL\"\naura_env.suitwwpvestats_shaman_enh_sb = \"HASTE>MAST>CRIT>VERS>ILVL\"\naura_env.suitwwpvestats_shaman_resto_tot = \"ILVL>CRIT>VERS>HASTE>MAST\"\naura_env.suitwwpvestats_shaman_resto_fs = \"ILVL>CRIT>HASTE>VERS>MAST\"\n\n-- Warlock.  Soul Harvester (sh), Hellcaller (hc), Diabolist (dia)\naura_env.suitwwpvestats_warlock_aff_sh = \"ILVL>CRIT>MAST>HASTE>VERS\"\naura_env.suitwwpvestats_warlock_aff_hc = \"ILVL>CRIT>MAST>HASTE>VERS\"\naura_env.suitwwpvestats_warlock_demo_sh = \"ILVL>HASTE=CRIT>MAST>VERS\"\naura_env.suitwwpvestats_warlock_demo_dia = \"ILVL>HASTE=CRIT>MAST>VERS\"\naura_env.suitwwpvestats_warlock_dest_hc = \"HASTE>ILVL>CRIT>=MAST>VERS\"\naura_env.suitwwpvestats_warlock_dest_dia = \"HASTE>ILVL>CRIT>=MAST>VERS\"\n\n-- Warrior.  Slayer (sl), colossus (col), Mountain Thane (mt)\naura_env.suitwwpvestats_warrior_arms_sl = \"ILVL>CRIT>HASTE>MAST>VERS\"\naura_env.suitwwpvestats_warrior_arms_col = \"ILVL>CRIT>HASTE>MAST>VERS\"\naura_env.suitwwpvestats_warrior_fury_sl = \"ILVL>MAST>HASTE>VERS>CRIT\"\naura_env.suitwwpvestats_warrior_fury_mt = \"ILVL>MAST>HASTE>VERS>CRIT\"\naura_env.suitwwpvestats_warrior_prot_mt = \"ILVL>HASTE>CRIT>VERS>MAST\"\naura_env.suitwwpvestats_warrior_prot_col = \"ILVL>HASTE>CRIT>VERS>MAST\"",
