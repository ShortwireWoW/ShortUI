["use_absorbHealMode"] = true,
["custom_type"] = "stateupdate",
["use_absorbMode"] = true,
["event"] = "Health",
["unit"] = "player",
["custom"] = "function(allstates, event, unit, _, spellID)\n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        if spellID == 1224793 then\n            aura_env.counter = aura_env.counter + 1\n            allstates:Update(\"\", {\n                    even = aura_env.counter % 2 == 0\n            })\n        elseif spellID == 1236703 then\n            aura_env.counter = 1\n            allstates:Update(\"\", {\n                    even = aura_env.counter % 2 == 0\n            })\n        end\n    elseif event == \"ENCOUNTER_START\" then\n        aura_env.counter = 1\n        allstates:Update(\"\", {\n                even = aura_env.counter % 2 == 0\n        })\n    end\nend",
["debuffType"] = "HELPFUL",
["check"] = "event",
["use_unit"] = true,
["events"] = "UNIT_SPELLCAST_SUCCEEDED:boss1, ENCOUNTER_START",
["customVariables"] = "{even = \"bool\"}",
