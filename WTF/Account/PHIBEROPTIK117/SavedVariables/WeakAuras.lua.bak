["use_absorbHealMode"] = true,
["subeventSuffix"] = "_CAST_SUCCESS",
["spellName"] = {
"Arcane Surge",
},
["use_absorbMode"] = true,
["event"] = "Combat Log",
["customStacks"] = "function()\n    return 11 - aura_env.blp_count\nend\n\n\n\n",
