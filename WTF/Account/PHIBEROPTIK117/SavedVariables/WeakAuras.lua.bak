["AM - Darkflame Cleft"] = {
["iconSource"] = -1,
["wagoID"] = "3bViaBtT1",
["xOffset"] = 0,
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["cooldownSwipe"] = true,
["url"] = "https://wago.io/3bViaBtT1/75",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "--checks if the unit is a valid target to be marked\naura_env.isUnitValidAndGetOrder = function (unit)\n    local guid = UnitGUID(unit)    \n    if not guid then return end\n    local npcId = select(6, strsplit(\"-\", guid))\n    if npcId and UnitExists(unit) and not GetRaidTargetIndex(unit) and not UnitIsDead(unit) then\n        --if it isn't in the custom marker list then we check the regular one and simply return true--if it isn't in the custom marker list then we check the regular one and simply return true\n        local multiUnit = aura_env.npcWithMultipleIds(npcId)\n        return aura_env.checkCustomNpc(npcId) or aura_env.config[multiUnit or \"npc\".. npcId]     \n    end\nend\n\n--special case for nameplate marking, but same as the function above. Should merge them in the future\naura_env.isUnitValidNameplate = function (unit)\n    --todo\nend\n\n--takes in a unit and the order to mark it with. function checks the marks in the order to find the first availible marker from that order\naura_env.markUnit = function (unit, order)\n    WeakAuras.ScanEvents(\"AUTOMARK_REQUEST_MARK_MOB\",UnitGUID(\"player\"), unit, order)\nend\n\n\naura_env.checkCustomNpc = function (npcId)\n    for k,v in pairs(aura_env.config.npcCustom) do \n        if v.npc == npcId then \n            return {v.mark1-1 , v.mark2-1, v.mark3-1, v.mark4-1}\n        end\n    end\n    return false\nend\n\n\n\nlocal bf = {\n    [\"223773\"] = true,\n    [\"220815\"] = true,\n    [\"223776\"] = true,\n    [\"211228\"] = true,\n    [\"223777\"] = true,\n    [\"223770\"] = true,\n    [\"223772\"] = true,\n    [\"223774\"] = true,\n}\n\n\naura_env.npcWithMultipleIds = function(npcId)\n    if bf[npcId] then\n        return \"npcBf\"\n    end     \nend",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["unit"] = "player",
["custom_hide"] = "custom",
["events"] = "UNIT_COMBAT, UPDATE_MOUSEOVER_UNIT,  MODIFIER_STATE_CHANGED, NAME_PLATE_UNIT_ADDED, ",
["custom"] = "function(event, ...)\n    --mouseover functionality\n    if (event == \"UPDATE_MOUSEOVER_UNIT\" or event == \"MODIFIER_STATE_CHANGED\") then\n        local guid = UnitGUID(\"mouseover\")\n        if not guid then return end\n        local npcId = select(6, strsplit(\"-\", guid))\n        local order = aura_env.isUnitValidAndGetOrder(\"mouseover\")\n        if not npcId or not order then return end\n        aura_env.markUnit(\"mouseover\", order)\n    end\n    \n    ---------------------------------------------------------------------------------------\n    --combat marking\n    if event == \"UNIT_COMBAT\" then\n        local unit = select(1, ...)\n        local guid = UnitGUID(unit)\n        if not guid then return end\n        local npcId = select(6, strsplit(\"-\", guid))\n        local order = aura_env.isUnitValidAndGetOrder(unit)\n        if not npcId or not order or not UnitAffectingCombat(unit) or not UnitCanAttack(\"player\", unit) then return end\n        aura_env.markUnit(unit, order)\n    end \n    \n    ---------------------------------------------------------------------------------------\n    --nameplate marking\n    if event == \"NAME_PLATE_UNIT_ADDED\" then return\n        --todo\n    end\n    \n    --local unit = select(1, ...)\n    --if not aura_env.isUnitValidAndGetOrderNameplate(unit) then return end\n    --local npcId = select(6, strsplit(\"-\",UnitGUID(unit)))\n    --aura_env.markUnit(unit, aura_env.getOrder(npcId, true))\nend  \n\n\n\n",
["subeventPrefix"] = "SPELL",
