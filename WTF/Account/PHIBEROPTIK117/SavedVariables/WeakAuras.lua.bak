["actions"] = {
["start"] = {
["sound"] = "Interface\\AddOns\\WeakAuras\\Media\\Sounds\\SynthChord.ogg",
["do_sound"] = false,
},
["init"] = {
["custom"] = "aura_env.spells = {}\n\nlocal spellNameColorRGB = aura_env.config.display.spellNameColor\nlocal r, g, b = spellNameColorRGB[1], spellNameColorRGB[2], spellNameColorRGB[3]\naura_env.spellNameColorHEX = (\"ff%.2x%.2x%.2x\"):format(r*255, g*255, b*255)\n\n-- Grabbing all enabled spells. \nfor _,t in pairs(aura_env.config.spells) do \n    if t.enable then \n        aura_env.spells[t.id] = {\n            [\"name\"] = t.name,\n            [\"duration\"] = t.duration,\n            [\"target\"] = t.target,\n            [\"channeled\"] = t.channeled,\n        }\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
["selfPoint"] = "CENTER",
["fontSize"] = 29,
["source"] = "import",
["displayText_format_n_format"] = "none",
["shadowXOffset"] = 1,
["displayText_format_sourceName_format"] = "none",
["displayText_format_p_time_dynamic_threshold"] = 60,
["conditions"] = {
},
["regionType"] = "text",
["xOffset"] = 0,
["desc"] = "Add Bloodlust\n- Time Warp\n- Heroism\n- Bloodlust\n- Primal Rage\n- Fury of the Aspects\n\nAdd Battle Ress \n- Soulstone\n- Raise Ally\n- Rebirth\n- Intercession\n- Arclight Vital Correctors\n\nAdd Evoker\n- Emerald Communion\n\nRemove\n- Ashen Hallow\n\nEdit Power Infusion.\n---------------\n\n\n\n--------------------------------\nthanks to Tocbar from RVD who helped me to fix this.\n\nEverything works again without errors. \n\nNew instance type added.\n-----------------------------\n\nThank you for that suggestion!\nKatalyst,Ika,Tocbar,Tyranus \n\nAn Thanks to Guild\nNox Infesta (The Council of Dalaran)",
["auto"] = true,
