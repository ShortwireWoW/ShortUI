["custom"] = "function()\n    local loaded = C_AddOns.IsAddOnLoaded(\"CauseseDB\")\n    if not loaded and not aura_env.fired then\n        StaticPopupDialogs[\"CAUSESEDB_CHECK\"] = {\n            text = \"\\124cFFFF0000CauseseDB AddOn missing|nInstall or enable it!|r|n|nLink:\",\n            button1 = \"ok\",\n            showAlert = true,\n            hasEditBox = true,\n            editBoxWidth = 250,\n            \n            OnShow = function (self, data)\n                local url = \"https://www.curseforge.com/wow/addons/causesedb\"\n                self.EditBox:SetText(url)\n                self.EditBox:HighlightText()\n                self.EditBox:SetScript(\"OnTextChanged\", function(EditBox)\n                        EditBox:SetText(url)\n                        EditBox:HighlightText()\n                end)\n            end,\n            OnHide = function(self, data)\n                self.EditBox:SetScript(\"OnTextChanged\", nil)\n            end,\n            whileDead = true,\n            hideOnEscape = false,\n            preferredIndex = 3,\n        }\n        StaticPopup_Show(\"CAUSESEDB_CHECK\")\n        aura_env.fired = true\n    end\nend",
