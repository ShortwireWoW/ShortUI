nt(\"BOTTOMLEFT\", _G[\"ccsm_b5\"], \"TOPLEFT\", 0, 2)\n        _G[\"ccsm_b3\"]:SetPoint(\"BOTTOMLEFT\", _G[\"ccsm_b4\"], \"TOPLEFT\", 0, 2)\n        _G[\"ccsm_b2\"]:SetPoint(\"BOTTOMLEFT\", _G[\"ccsm_b3\"], \"TOPLEFT\", 0, 2)\n        _G[\"ccsm_b1\"]:SetPoint(\"BOTTOMLEFT\", _G[\"ccsm_b2\"], \"TOPLEFT\", 0, 2)\n        \n        -- This is where the column header items are made\n        -- Fortified\n        \n        local ccsm_fortlvl_fs = _G[\"ccsm_fortlvl_fs\"] or  ccsm_sf:CreateFontString(\"ccsm_fortlvl_fs\")\n        ccsm_fortlvl_fs:SetPoint(\"BOTTOMRIGHT\", ccsm_b1_fs3, \"TOPRIGHT\", 0 ,15)\n        ccsm_fortlvl_fs:SetFont(WA_Font, (c.fontsize or 14), textoptions)\n        ccsm_fortlvl_fs:SetText(\"|cFF2afab5\"..LEVEL..\"|r\")\n        ccsm_fortlvl_fs:Show()        \n        \n        local ccsm_fort_fs = _G[\"ccsm_fort_fs\"] or  ccsm_sf:CreateFontString(\"ccsm_fort_fs\")\n        ccsm_fort_fs:SetPoint(\"BOTTOMRIGHT\", ccsm_b1_fs4, \"TOPRIGHT\", 0 ,15)\n        ccsm_fort_fs:SetFont(WA_Font, (c.fontsize or 14), textoptions)\n        ccsm_fort_fs:SetText(\"|cFF2afab5\"..PVP_RATING_HEADER..\"|r\")\n        ccsm_fort_fs:Show()\n        \n        local ccsm_fbt_fs = _G[\"ccsm_fbt_fs\"] or  ccsm_sf:CreateFontString(\"ccsm_fbt_fs\")\n        ccsm_fbt_fs:SetPoint(\"BOTTOMLEFT\", ccsm_b1_fs7, \"TOPLEFT\", 0 ,15)\n        ccsm_fbt_fs:SetFont(WA_Font, (c.fontsize or 14), textoptions)\n        ccsm_fbt_fs:SetText(\"|cFF2afab5\"..BEST..\"|r\")\n        ccsm_fbt_fs:Show()\n        \n        local ccsm_tp_fs = _G[\"ccsm_tp_fs\"] or  ccsm_sf:CreateFontString(\"ccsm_tp_fs\")\n        ccsm_tp_fs:SetPoint(\"BOTTOMLEFT\", ccsm_b1_btn1, \"TOPLEFT\", 0 , 15)\n        ccsm_tp_fs:SetFont(WA_Font, (c.fontsize or 10), textoptions)\n        ccsm_tp_fs:SetText(\"|cFF2afab5\"..TELEPORT_TO_DUNGEON..\"|r\")\n        ccsm_tp_fs:Show()\n        \n    end\n    _G[\"ccsm_sf_bg\"]:SetColorTexture(bgr,bgg,bgb,bgalpha)\nend\naura_env.initializeframes();\naura_env.initializescore();\nC_Timer.Afte