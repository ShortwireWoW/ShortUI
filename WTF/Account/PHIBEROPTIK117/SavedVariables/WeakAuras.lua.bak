["Engine - Automark"] = {
["outline"] = "OUTLINE",
["iconSource"] = 0,
["wagoID"] = "1ctv3b91K",
["authorOptions"] = {
{
["subOptions"] = {
{
["type"] = "description",
["text"] = "|cFFD19A66M+ AUTO MARK|r",
["fontSize"] = "large",
["width"] = 2,
},
{
["type"] = "description",
["text"] = "This WeakAura comes loaded with all mobs in the dungeon and it's up to you the user to configure it to fit your best needs. There's plenty of options that can help you out to set it up to perfection. There's general settings that affect how the WeakAura behaves but you have the tools to also make adjustments on a mob-level. \n\n",
["fontSize"] = "small",
["width"] = 2,
},
{
["type"] = "description",
["text"] = "For an more in-depth walkthrough how to use this WeakAura see:",
["fontSize"] = "medium",
["width"] = 2,
},
{
["type"] = "description",
["text"] = "|cFF4FAFE3wago.io/1ctv3b91K|r\n\n",
["fontSize"] = "large",
["width"] = 2,
},
{
["type"] = "description",
["text"] = "Discord channel for help/new features/etc",
["fontSize"] = "medium",
["width"] = 2,
},
{
["type"] = "description",
["text"] = "|cFF4FAFE3discord.gg/uZdPK2SPNG|r\n\n",
["fontSize"] = "large",
["width"] = 2,
},
