["Lunar Effect - MRT Helper"] = {
["width"] = 200,
["wagoID"] = "wxmTS5FG8",
["xOffset"] = 0,
["preferToUpdate"] = false,
["authorOptions"] = {
{
["fontSize"] = "large",
["text"] = "Debug Statements?",
["type"] = "description",
["width"] = 2,
},
},
["yOffset"] = 0,
["regionType"] = "empty",
["information"] = {
},
["anchorPoint"] = "CENTER",
["parent"] = "Lunar Effect - MRT Hook",
["selfPoint"] = "CENTER",
["url"] = "https://wago.io/wxmTS5FG8/1",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "-- Init our MRT Note helper global\n_G[\"SW_MRT_Note\"] = _G[\"SW_MRT_Note\"] or \"\"",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["custom_hide"] = "timed",
["duration"] = "0.1",
["event"] = "Health",
["unit"] = "player",
["subeventSuffix"] = "_CAST_START",
["subeventPrefix"] = "SPELL",
["custom"] = "function(event)\n    local function cleanName(raw, trunc)\n        local trimmed = raw:match(\"^%s*(.-)%s*$\") or \"\"\n        \n        -- Preserve {raidIcon} markers\n        if trimmed:match(\"^%b{}$\") then\n            return trimmed, trimmed  -- No cleaning or truncation\n        end\n        \n        local color = trimmed:match(\"|c%x%x%x%x%x%x%x%x\") or \"|cFFFFFFFF\"\n        local stripped = trimmed\n        :gsub(\"|c%x%x%x%x%x%x%x%x\", \"\")\n        :gsub(\"|r\", \"\")\n        :gsub(\"%-.*\", \"\")\n        :gsub(\"[|]\", \"\")\n        :gsub(\"%s+\", \"\")\n        \n        local truncLen = tonumber(trunc) or 7\n        \n        local cleaned = stripped:sub(1, 12)\n        local display = color .. stripped:sub(1, truncLen) .. \"|r\"\n        \n        if aura_env and aura_env.config and aura_env.config.smls_utils_debug then\n            print(\"DEBUG: cleanName returning cleaned =\", cleaned, \"display =\", display)\n        end\n        \n        return cleaned, display\n    end\n    \n    \n    local note = _G.VExRT and _G.VExRT.Note and _G.VExRT.Note.Text1\n    \n    if note then\n        function _G.swGetMRTNote(startMarker, endMarker, trunc)\n            -- Validate startMarker\n            if type(startMarker) ~= \"string\" or startMarker == \"\" then\n                print(\"[MRT Helper] Error: startMarker is nil or not a string\")\n                return false\n            end\n            \n            -- Validate endMarker\n            if type(endMarker) ~= \"string\" or endMarker == \"\" then\n                print(\"[MRT Helper] Error: endMarker is nil or not a string\")\n                return false\n            end\n            \n            -- Validate trunc\n            if type(trunc) ~= \"number\" or math.floor(trunc) ~= trunc then\n                print(\"[MRT Helper] Error: trunc must be an integer\")\n                return false\n            end\n            \n            if trunc < 1 or trunc > 12 then\n                print(\"[MRT Helper] Error: trunc must be between 1 and 12\")\n                return false\n            end\n            \n            -- print(\"Start: \" .. startMarker .. \" End: \" .. endMarker .. \" Trunc: \" .. trunc)\n            \n            local mrtBody = note:match(startMarker .. \"%s*([%s%S]-)%s*\" .. endMarker)\n            \n            -- Parse names\n            local cleanedNames, rawNames = {}, {}\n            for word in string.gmatch(mrtBody, \"[^,%s]+\") do\n                local cleaned, display = cleanName(word)\n                table.insert(cleanedNames, cleaned)\n                table.insert(rawNames, display)\n            end\n            \n            return cleanedNames, rawNames\n        end\n    end    \nend",
["events"] = "SW_MRT_HELPER",
["check"] = "event",
["spellIds"] = {
},
["names"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
["activeTriggerMode"] = -10,
},
["tocversion"] = 110100,
["internalVersion"] = 85,
["semver"] = "1.0.0",
["animation"] = {
["start"] = {
["type"] = "none",
["easeStrength"] = 3,
["duration_type"] = "seconds",
["easeType"] = "none",
},
["main"] = {
["type"] = "none",
["easeStrength"] = 3,
["duration_type"] = "seconds",
["easeType"] = "none",
},
["finish"] = {
["type"] = "none",
["easeStrength"] = 3,
["duration_type"] = "seconds",
["easeType"] = "none",
},
},
["id"] = "Lunar Effect - MRT Helper",
["uid"] = "W4Vu3bXByw7",
["alpha"] = 1,
["desc"] = "-- ============================================================================\n-- Lunar Effect - MRT Helper\n-- This always-active weakaura provides a global utility for MRT note handling.\n--\n-- It exposes the function:\n--    local cleanNote, displayNote = leGetMRTNote(\"leminestart\", \"lemineend\")\n--\n-- Which does the following:\n--   1. Looks for the note body between the provided start and end markers.\n--   2. Splits the note into words (using comma and/or whitespace as delimiters).\n--   3. Processes each word with 'cleanName', returning both cleaned and display\n--      versions (for example, short versions and color-coded output).\n--\n-- Additionally, it listens for CHAT_MSG_ADDON events with prefix \"MRT\" to update\n-- the global note variable.\n-- ============================================================================",
