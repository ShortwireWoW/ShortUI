["Lunar Effect - MRT Helper Example"] = {
["outline"] = "OUTLINE",
["wagoID"] = "wxmTS5FG8",
["parent"] = "Lunar Effect - MRT Hook",
["displayText_format_p_time_dynamic_threshold"] = 60,
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/wxmTS5FG8/1",
["actions"] = {
["start"] = {
["custom"] = "-- You must always call the WeakAuras.ScanEvents first to ensure you're getting the latest note.\nWeakAuras.ScanEvents(\"SW_MRT_HELPER\")\n\n-- We set \"cleanedNames, display\" local variables to the function\n-- leGetMRTNote \n-- We have three arguements that must be passed:   startMarker, endMarker, Int\n-- startMarker and endMarker must wrap your MRT note. \n-- Int must be 1-12 and truncates the player name. This prevents overly long names from showing up.\n-- Default int is 12 to \nlocal cleanedNames, display = leGetMRTNote(\"swminestart\", \"swmineend\", 7)\n\nif #cleanedNames > 0 then\n    for i, v in ipairs(cleanedNames) do\n        print(\"Name: \" .. tostring(v))        \n    end\nend\n\nif #display > 0 then\n    for i, v in ipairs(display) do\n        print(\"Name: \" .. tostring(v))        \n    end\nend\n\n\n",
["do_custom"] = true,
},
["init"] = {
["custom"] = "\n\n",
["do_custom"] = false,
},
["finish"] = {
},
},
