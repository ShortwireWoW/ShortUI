["init"] = {
["do_custom"] = true,
["custom"] = "-- Death Knight.  Riders of the Apocalypse (rota), Deathbringer (db), San'layn (sl)\naura_env.suitwwpvestats_dk_frost_rota = \"ILVL>CRIT>MAST>HASTE>VERS\"\naura_env.suitwwpvestats_dk_frost_db = \"ILVL>CRIT>MAST>HASTE>VERS\"\naura_env.suitwwpvestats_dk_unholy_sl = \"ILVL>HASTE>MAST>VERS>CRIT\"\naura_env.suitwwpvestats_dk_unholy_rota = \"ILVL>HASTE>MAST>VERS>CRIT\"\naura_env.suitwwpvestats_dk_blood_sl = \"ILVL>HASTE>MAST=CRIT=VERS\"\naura_env.suitwwpvestats_dk_blood_db = \"ILVL>MAST=CRIT=VERS=HASTE\"\n\n-- Demon Hunter.  Fel-scarred (fs), Aldrachi Reaver (ar)\naura_env.suitwwpvestats_dh_havoc_fs = \"CRIT>MAST>HASTE>VERS>ILVL\"\naura_env.suitwwpvestats_dh_havoc_ar = \"CRIT>MAST>HASTE>VERS>ILVL\"\naura_env.suitwwpvestats_dh_vengeance_fs = \"ILVL>HASTE>CRIT>VERS>MAST\"\naura_env.suitwwpvestats_dh_vengeance_ar = \"ILVL>HASTE>CRIT>VERS>MAST\"\n\n-- Druid.  Keeper of the Grove (kotg), Elune's Chosen (ec), Druid of the Claw (dotc), Wildstalker (ws)\naura_env.suitwwpvestats_druid_balance_kotg = \"ILVL>MAST>HASTE>CRIT>VERS\"\naura_env.suitwwpvestats_druid_balance_ec = \"ILVL>HASTE>MAST>CRIT>VERS\"\naura_env.suitwwpvestats_druid_feral_dotc = \"ILVL>CRIT>MAST>VERS>HASTE\"\naura_env.suitwwpvestats_druid_feral_ws = \"ILVL>CRIT>MAST>HASTE>VERS\"\naura_env.suitwwpvestats_druid_guardian_dotc = \"ILVL>HASTE>VERS>MAST>CRIT\"\naura_env.suitwwpvestats_druid_guardian_ec = \"ILVL>HASTE>VERS>MAST>CRIT\"\naura_env.suitwwpvestats_druid_restoration_ws = \"ILVL>HASTE>MAST>VERS>CRIT\"\naura_env.suitwwpvestats_druid_restoration_kotg = \"ILVL>HASTE>MAST>VERS=CRIT\"\n\n-- Evoker.  Scalecommander (sc), Flameshaper (fs), Chronowarden (cw)\naura_env.suitwwpvestats_evoker_dev_sc = \"ILVL>CRIT>MAST>VERS>HASTE\"\naura_env.suitwwpvestats_evoker_dev_fs = \"ILVL>CRIT>MAST>HASTE>VERS\"\naura_env.suitwwpvestats_evoker_pres_fs = \"ILVL>HASTE>VERS>MAST>CRIT\"\naura_env.suitwwpvestats_evoker_pres_cw = \"ILVL>HASTE>VERS>MAST>CRIT\"\naura_env.suitwwpvestats_evoker_aug_sc = \"ILVL>HASTE>MAST>VERS>CRIT\"\naura_env.suitwwpvestats_evoker_aug_cw = \"ILVL>HASTE>MAST>VERS=CRIT\"\n\n-- Hunter.  Pack Leader (pl), Dark Ranger (dr), Sentinel (st)\naura_env.suitwwpvestats_hunter_bm_pl = \"WEAP>HASTE>CRIT>MAST>VERS>ILVL\"\naura_env.suitwwpvestats_hunter_bm_dr = \"WEAP>HASTE>CRIT>MAST>VERS>ILVL\"\naura_env.suitwwpvestats_hunter_mm_st = \"CRIT>MAST>ILVL>VERS>HASTE\"\naura_env.suitwwpvestats_hunter_mm_dr = \"CRIT>MAST=HASTE>ILVL>VERS\"\naura_env.suitwwpvestats_hunter_surv_st = \"ILVL>MAST>CRIT>HASTE>VERS\"\naura_env.suitwwpvestats_hunter_surv_pl = \"ILVL>MAST>CRIT=HASTE>VERS\"\n\n-- Mage.  Sunfury (sf), Frostfire (ff), Spellslinger (ss)\naura_env.suitwwpvestats_mage_arcane_sf = \"ILVL>HASTE>VERS>CRIT>MAST\"\naura_env.suitwwpvestats_mage_arcane_ss = \"ILVL>HASTE>VERS>CRIT>MAST\"\naura_env.suitwwpvestats_mage_fire_sf = \"ILVL>HASTE>MAST>VERS>CRIT\"\naura_env.suitwwpvestats_mage_fire_ff = \"ILVL>HASTE>VERS>MAST>CRIT\"\naura_env.suitwwpvestats_mage_frost_ss = \"ILVL>HASTE>CRIT>MAST>VERS\"\naura_env.suitwwpvestats_mage_frost_fr = \"ILVL>HASTE>CRIT>MAST>VERS\"\n\n-- Monk.  Conduit of the Celestials (cotc), Shado-pan (sp), Master of Harmony (moh)\naura_env.suitwwpvestats_monk_ww_cotc = \"ILVL>MAST=HASTE>VERS=CRIT\"\naura_env.suitwwpvestats_monk_ww_sp = \"ILVL>MAST=HASTE>VERS=CRIT\"\naura_env.suitwwpvestats_monk_bm_sp = \"ILVL>VERS=CRIT=MAST>HASTE\"\naura_env.suitwwpvestats_monk_bm_moh = \"ILVL>VERS=CRIT=MAST>HASTE\"\naura_env.suitwwpvestats_monk_mw_cotc = \"ILVL>HASTE>VERS>CRIT>MAST\"\naura_env.suitwwpvestats_monk_mw_moh = \"ILVL>HASTE>CRIT>MAST>VERS\"\n\n-- Paladin.  Templar (tmp), Herald of the Sun (hots), Lightsmith (ls)\naura_env.suitwwpvestats_paladin_ret_tmp = \"ILVL>MAST>CRIT>HASTE>VERS\"\naura_env.suitwwpvestats_paladin_ret_hots = \"ILVL>MAST>CRIT>HASTE>VERS\"\naura_env.suitwwpvestats_paladin_prot_tmp = \"ILVL>HASTE>MAST>CRIT=VERS\"\naura_env.suitwwpvestats_paladin_prot_ls = \"ILVL>HASTE>MAST>CRIT=VERS\"\naura_env.suitwwpvestats_paladin_holy_ls = \"ILVL>HASTE=CRIT>MAST=VERS\"\naura_env.suitwwpvestats_paladin_holy_hots = \"ILVL>HASTE=MAST=>CRIT>VERS\"\n\n-- Priest.  Voidweaver (vw), Archon (arc), Oracle (ora)\naura_env.suitwwpvestats_priest_shadow_vw = \"ILVL>HASTE(20%)>MAST>CRIT>VERS\"\naura_env.suitwwpvestats_priest_shadow_arc = \"ILVL>HASTE>MAST>CRIT>VERS\"\naura_env.suitwwpvestats_priest_disc_vw = \"ILVL>HASTE>CRIT=MASTER>VERS\"\naura_env.suitwwpvestats_priest_disc_ora = \"ILVL>HASTE(25%)>CRIT=MAST>HASTE(+20%)>VERS\"\naura_env.suitwwpvestats_priest_holy_arc = \"ILVL>CRIT>MAST>VERS>HASTE\"\naura_env.suitwwpvestats_priest_holy_ora = \"ILVL>CRIT>MAST>VERS>HASTE\"\n\n-- Rogue.  Fatebound (fb), Deathstalker (ds), Trickster (tr)\naura_env.suitwwpvestats_rogue_assn_fb = \"ILVL>CRIT>MAST>HASTE>VERS\"\naura_env.suitwwpvestats_rogue_assn_ds = \"ILVL>CRIT>MAST>HASTE>VERS\"\naura_env.suitwwpvestats_rogue_outlaw_tr = \"ILVL>VERS>HASTE>CRIT>MAST\"\naura_env.suitwwpvestats_rogue_outlaw_fr = \"ILVL>VERS>HASTE>CRIT>MAST\"\naura_env.suitwwpvestats_rogue_sub_tr = \"ILVL>MAST>VERS>CRIT>HASTE\"\naura_env.suitwwpvestats_rogue_sub_ds = \"ILVL>MAST>VERS>CRIT>HASTE\"\n\n-- Shaman.  Stormbringer (sb), Farseer (fs), Totemic (tot)\naura_env.suitwwpvestats_shaman_ele_sb = \"ILVL>MAST>HASTE>CRIT>VERS\"\naura_env.suitwwpvestats_shaman_ele_fs = \"ILVL>MAST>HASTE>CRIT>VERS\"\naura_env.suitwwpvestats_shaman_enh_tot = \"MAST>HASTE>CRIT>VERS>ILVL\"\naura_env.suitwwpvestats_shaman_enh_sb = \"HASTE>MAST>CRIT>VERS>ILVL\"\naura_env.suitwwpvestats_shaman_resto_tot = \"ILVL>CRIT>VERS>MAST>HASTE\"\naura_env.suitwwpvestats_shaman_resto_fs = \"ILVL>CRIT>VERS>HASTE>MAST\"\n\n-- Warlock.  Soul Harvester (sh), Hellcaller (hc), Diabolist (dia)\naura_env.suitwwpvestats_warlock_aff_sh = \"ILVL>CRIT>MAST>HASTE>VERS\"\naura_env.suitwwpvestats_warlock_aff_hc = \"ILVL>CRIT>MAST>HASTE>VERS\"\naura_env.suitwwpvestats_warlock_demo_sh = \"ILVL>HASTE(24%)>VERS=CRIT>MAST\"\naura_env.suitwwpvestats_warlock_demo_dia = \"ILVL>HASTE(24%)>VERS=CRIT>MAST\"\naura_env.suitwwpvestats_warlock_dest_hc = 