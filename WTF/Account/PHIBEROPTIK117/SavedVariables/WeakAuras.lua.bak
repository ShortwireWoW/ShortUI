["unit"] = "player",
["custom"] = "-- Party Settings : Response\nfunction()\n    \n    local VERSION = 1;\n    local type = \"PartySettings\";\n    local settings = aura_env.config.Settings;\n    \n    local tank = settings.Tank.Enable;\n    local healer = settings.Healer.Enable;\n    local damager = settings.Damager.Enable;\n    local leader = settings.Leader.Enable;\n    \n    WeakAuras.ScanEvents(\"AutomarkSettingsResponse\", VERSION, type, tank, healer, damager, leader);\nend",
