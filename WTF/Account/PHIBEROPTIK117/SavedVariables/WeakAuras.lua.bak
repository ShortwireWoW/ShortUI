["Mythic+ !keys The War Within"] = {
["outline"] = "OUTLINE",
["xOffset"] = 0,
["displayText_format_p_time_dynamic_threshold"] = 60,
["shadowYOffset"] = 0,
["anchorPoint"] = "CENTER",
