["values"] = {
"|cFFff6150Do Nothing|r",
"Mark next from |cFF9cdcfeQueue|r",
},
["Name"] = "This setting is applied when a npc with who carried a mark is killed. |n|nMark next from |cFF9cdcfeQueue|r - Will try to automatically mark the next npc in the queue. ",
