["extend"] = "1",
["spellId"] = "460181",
["remaining_operator"] = "<",
["use_unit"] = true,
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["events"] = "UNIT_SPELLCAST_SUCCEEDED:boss, ENCOUNTER_START, LIQUID_CUSTOM_EVENT, CLEU:SPELL_AURA_REMOVED",
["custom_type"] = "stateupdate",
["check"] = "event",
["debuffType"] = "HELPFUL",
["custom"] = "function(allstates, event, ...)\n    if event == \"OPTIONS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            side = math.random(2) % 2 == 0 and \"wall\" or \"door\"\n        }\n    elseif event == \"LIQUID_CUSTOM_EVENT\" then\n        local id = ...\n        \n        if id ~= aura_env.id then return end\n        \n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            side = aura_env.count % 2 == 0 and \"wall\" or \"door\"\n        }\n        \n        return true\n    elseif event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local _, subEvent, _, _, _, _, _, _, _, _, _, spellID = ...\n        \n        if subEvent == \"SPELL_AURA_REMOVED\" and spellID == 461060 then -- Spin To Win!\n            aura_env.count = 1\n            \n            WeakAuras.ScanEvents(\"LIQUID_CUSTOM_EVENT\", aura_env.id)\n        end\n    elseif event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        local _, castGUID, spellID = ...\n        \n        if not castGUID then return end\n        \n        if spellID == 460181 then -- Pay-Line\n            aura_env.count = aura_env.count + 1\n            \n            WeakAuras.ScanEvents(\"LIQUID_CUSTOM_EVENT\", aura_env.id)\n        end\n    elseif event == \"ENCOUNTER_START\" then\n        aura_env.count = 1\n        \n        WeakAuras.ScanEvents(\"LIQUID_CUSTOM_EVENT\", aura_env.id)\n    end\nend",
["unit"] = "player",
},
["untrigger"] = {
},
},
["disjunctive"] = "custom",
["customTriggerLogic"] = "function(t)\n    return t[1] or t[2]\nend",
["activeTriggerMode"] = -10,
},
