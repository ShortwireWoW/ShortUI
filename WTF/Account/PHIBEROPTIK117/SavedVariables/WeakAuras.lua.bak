["event"] = "Health",
["unit"] = "player",
["customDuration"] = "function()\n    return aura_env.duration, aura_env.expirationTime\nend\n\n\n",
["customName"] = "",
["events"] = "UNIT_AURA:player",
["names"] = {
},
["check"] = "event",
["custom"] = "function(event, ...)\n    if ... ~= \"player\" then\n        return\n    end\n    \n    local duration, expirationTime\n    \n    for spell_id, _ in pairs(aura_env.spell_ids) do\n        _, _, _, _, duration, expirationTime = WA_GetUnitBuff(\"player\", spell_id)\n        if duration then\n            break\n        end\n    end\n    \n    if not duration then\n        return\n    end\n    \n    aura_env.duration = duration\n    aura_env.expirationTime = expirationTime\n    aura_env.health = UnitHealth(\"player\")\n    \n    return true\nend",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "custom",
},
["untrigger"] = {
["custom"] = "function(event, ...)\n    if ... ~= \"player\" then\n        return\n    end\n    \n    for spell_id, _ in pairs(aura_env.spell_ids) do\n        if WA_GetUnitBuff(\"player\", spell_id) then\n            return\n        end\n    end\n    \n    return true\nend",
},
