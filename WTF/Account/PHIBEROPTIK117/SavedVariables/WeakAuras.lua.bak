["custom"] = "function(allstates, _, ...)\n    local spellID = select(12, ...)\n    if spellID == 435797\n    and not WeakAuras.GetActiveTriggers(aura_env.id)[1] then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 3,\n            expirationTime = 3 + GetTime(),\n            autoHide = true,\n        }\n        return true\n    end\nend",
