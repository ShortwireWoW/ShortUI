["[OF-BOSS04] Gigazap (Primary target)"] = {
["iconSource"] = 0,
["wagoID"] = "tcIVwLsy9",
["parent"] = "Important Icons (bosses)",
["adjustedMax"] = "",
["adjustedMin"] = "",
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["cooldownSwipe"] = true,
["cooldownEdge"] = false,
["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["spellId"] = "",
["use_genericShowOn"] = true,
["genericShowOn"] = "showOnCooldown",
