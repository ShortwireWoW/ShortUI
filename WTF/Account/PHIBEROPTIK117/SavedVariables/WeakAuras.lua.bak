["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["custom_hide"] = "custom",
["event"] = "Health",
["customStacks"] = "function()\n    return aura_env.count or 0\nend\n    \n    ",
["subeventPrefix"] = "SPELL",
["unit"] = "player",
["custom"] = "function(event, triggerNum, triggerStates)\n    if event == \"TRIGGER\" or event == \"UNIT_THREAT_LIST_UPDATE\" then\n        aura_env.count = 0\n        for _,plate in pairs(C_NamePlate.GetNamePlates()) do\n            local unit = plate.namePlateUnitToken\n            if UnitAffectingCombat(unit) and UnitCanAttack(\"player\",unit) then\n                aura_env.count = aura_env.count + 1\n            end\n        end\n        if aura_env.count >= 0 then\n            return true\n        end\n    end\nend",
["events"] = "TRIGGER:2 UNIT_THREAT_LIST_UPDATE",
["names"] = {
},
["spellIds"] = {
},
["subeventSuffix"] = "_CAST_START",
["debuffType"] = "HELPFUL",
},
