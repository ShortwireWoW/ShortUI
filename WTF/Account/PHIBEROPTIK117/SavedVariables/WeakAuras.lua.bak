["url"] = "quazii.com",
["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["spellId"] = {
"62618",
},
["duration"] = "10",
["names"] = {
},
["use_sourceFlags"] = true,
["use_cloneId"] = true,
["debuffType"] = "HELPFUL",
["type"] = "custom",
["subeventSuffix"] = "_CAST_SUCCESS",
["customVariables"] = "{\n    expirationTime = true\n}",
["subeventPrefix"] = "SPELL",
["event"] = "Combat Log",
["custom"] = "function(allstates, event, timestamp, subEvent,  ...)\n    local _, sourceGUID, sourceName, _, _, destGUID, destName, _, _, spellID, spellName = ...\n    if subEvent == \"SPELL_CAST_SUCCESS\" then\n        -- spell cast\n        if spellID == 62618 then\n            local sourceUnit\n            for unit in WA_IterateGroupMembers() do\n                if UnitGUID(unit) == sourceGUID then\n                    sourceUnit = unit\n                end\n            end\n            -- group check\n            if not sourceUnit then return end\n            allstates[sourceGUID] = {\n                show = true,\n                changed = true,\n                unitCaster = sourceUnit,\n                progressType = \"timed\",\n                duration = 10,\n                expirationTime = GetTime() + 10,\n                autoHide = true,\n            }\n            return true\n        end\n        --[[elseif subEvent == \"UNIT_DIED\" then \n        if not destGUID or not allstates[destGUID] then return end\n        allstates[destGUID].show = false\n        allstates[destGUID].changed = true\n        return true]]\n    end\n    \nend",
["spellIds"] = {
},
["use_spellId"] = true,
["events"] = "CLEU:SPELL_CAST_SUCCESS:UNIT_DIED",
["use_sourceUnit"] = false,
["check"] = "event",
["custom_type"] = "stateupdate",
["unit"] = "player",
["sourceFlags"] = "InGroup",
},
