{
["trigger"] = {
["type"] = "unit",
["use_alwaystrue"] = true,
["unevent"] = "auto",
["duration"] = "1",
["event"] = "Conditions",
["unit"] = "player",
["realSpellName"] = 0,
["use_spellName"] = true,
["debuffType"] = "HELPFUL",
["genericShowOn"] = "showOnCooldown",
["use_genericShowOn"] = true,
["use_track"] = true,
["spellName"] = 0,
},
["untrigger"] = {
