["events"] = "CHAT_MSG_RAID CHAT_MSG_RAID_LEADER CHAT_MSG_PARTY CHAT_MSG_PARTY_LEADER CLEU:SPELL_CREATE",
["custom"] = "function(a, event, ...)\n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local timestamp, subEvent, hideCaster, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, destGUID, destName, destFlags, destRaidFlags, spellID = ...\n        if spellID ~= 61993 then return end\n        if not a[\"\"] then return end\n        a[\"\"].show = false\n        a[\"\"].changed = true\n        aura_env.last = GetTime()\n        return true\n    elseif event == \"CHAT_MSG_SAY\" or event == \"CHAT_MSG_RAID\" or  event == \"CHAT_MSG_RAID_LEADER\" or event == \"CHAT_MSG_PARTY\" or event == \"CHAT_MSG_PARTY_LEADER\" then\n        local text, playerName, _, _, _, _, _, _, _, _, _, guid = ...\n        \n        if text == \"1\" or text == \"123\" then\n            if aura_env.last and aura_env.last <= GetTime()+290 then return end\n            \n            a[\"\"] = a[\"\"] or {}\n            local s = a[\"\"]\n            s.progressType = \"timed\"\n            s.duration = 60\n            s.expirationTime = GetTime()+s.duration \n            s.autoHide = true\n            s.show = true\n            s.changed = true\n            return true\n        end\n    end\nend\n\n\n",
