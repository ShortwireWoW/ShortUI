["custom"] = "function(allstates, event, ...)\n    local timestamp, subEvent, hideCaster, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, destGUID, destName, destFlags, destRaidFlags, spellID, _,_, auraType = ...\n    if spellID == 294855 then\n        for k,v in pairs(allstates) do\n            v.show = false\n            v.changed = true\n        end\n        local unit = UnitTokenFromGUID(destGUID)\n        if unit then\n            allstates[destGUID] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 6,\n                expirationTime = 6 + GetTime(),\n                unit = unit,\n                autoHide = true,\n            }\n        end\n        return true\n    end\nend",
