},
["displayText"] = "%c",
["customText"] = "function()\n    local t_x, xp_gain, xp_per_h, ding_secs = aura_env.get_data() -- Tick\n    \n    return string.format(\n        aura_env.DISPLAY_FORMAT,\n        floor(xp_per_h / 100) / 10, -- Reduce precision\n        -- Ding time is infinite if no XP is gained, protect formatting\n        ding_secs ~=  1/0 and aura_env.format_time(math.floor(ding_secs)) or \"...\",\n        aura_env.format_time(t_x), -- Format time elapsed\n        xp_gain -- Format XP gained, if enabled\n    )\nend",
["yOffset"] = -472.4154663085938,
["anchorPoint"] = "CENTER",
["customTextUpdate"] = "update",
["url"] = "https://wago.io/QYsJ2-8cl/7",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "--[[\n--    Copyright (C) 2024  Fadestorm-Faerlina (Discord Hatefiend#7805)\n--\n--    This program is free software: you can redistribute it and/or modify\n--    it under the terms of the GNU General Public License as published by\n--    the Free Software Foundation, either version 3 of the License, or\n--    (at your option) any later version.\n--\n--    This program is distributed in the hope that it will be useful,\n--    but WITHOUT ANY WARRANTY; without even the implied warranty of\n--    MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the\n--    GNU General Public License for more details.\n--\n--    You should have received a copy of the GNU General Public License\n--    along with this program.  If not, see <https://www.gnu.org/licenses/>.\n]]--\n\nlocal xp_max = UnitXPMax(\"player\") -- Total XP needed for this entire level\nlocal xp_carry = 0 -- XP carried from previous levels this session\nlocal xp_start = UnitXP(\"player\") -- Amount of current xp\nlocal t = time() - 1 -- Timestamp in which the session was started (div/0 protected)\n\n-- Std Lib Function Cache\nlocal floor = math.floor\n\n--[[\n-- @return [number] Experience gained this session\n]]--\nlocal function xp_gained() -- Updates XP tally of how much experience we've gained this session\n    return UnitXP(\"player\") - xp_start + xp_carry\nend\n\n--[[\n-- Resets the XP totals and XP carried for this level; to-be called during level-ups\n]]--\nfunction aura_env.level_up()\n    xp_carry = xp_carry + xp_max - xp_start\n    xp_max = UnitXPMax(\"player\")\n    xp_start = 0 -- All xp from prev lvl was added to carry, so no need to track anymore\nend\n\n--[[\n-- Retrieves current data of experience gains, rates, and total\n--\n-- @return [int] Total time elapsed this session\n-- @return [int] Total XP gained during the session\n-- @return [float] Rate of experience gain, per hour\n-- @return [float] Time to ding, in seconds\n]]--\nfunction aura_env.get_data()\n    local t_x = time() - t\n    local xp_gain = xp_gained()\n    local rate = xp_gain / t_x\n    local xp_per_h =  floor(3600 * rate)\n    local ding_secs = (xp_max - UnitXP(\"player\")) / rate\n    return t_x, xp_gain, xp_per_h, ding_secs\nend\n\n--[[\n-- Parses an amount of seconds into a time-coded string\n--\n-- Times are rounded down to the nearest minute, second, hour, or day.\n-- 62 seconds --> \"1 min\"\n-- 2 seconds --> \"2 secs\"\n-- 3600 seconds --> \"1 hour\"\n--\n-- @param [string] secs Amount of time, in seconds\n-- @return [string] Time-coded string\n]]--\nfunction aura_env.format_time(secs)\n    local num, str\n    if secs < 60 then\n        num = secs\n        str = \"sec\"\n    elseif secs < 3600 then\n        num = floor(secs / 60)\n        str = \"min\"\n    elseif secs < 86400 then\n        num = floor(secs / 360) / 10 -- Decimal precision\n        str = \"hour\"\n    else\n        num = floor(secs / 8640) / 10 -- Decimal precision\n        str = \"day\"\n    end\n    return num .. \" \" .. str .. (num > 1 and \"s\" or \"\")\nend\n\nlocal Color = (function() -- Color Class\n        local instances = { }\n        local mt = {\n            __call = function (tbl, str) -- Colors the specified string\n                return \"|c\" .. instances[tbl] .. str .. \"|r\"\n            end\n        }\n        \n        --[[\n    -- @param [string] hex Hex string to denote color\n    ]]--\n        local function init(hex)\n            local self = { }\n            instances[self] = hex\n            return setmetatable(self, mt)\n        end\n        \n        return {\n            BROWN = init(\"ffb76b45\"),\n            YELLOW = init(\"ffffff00\"),\n            PURPLE = init(\"ff9292ff\"),\n        }\nend)()\n\n-- String template to format XP and time data\naura_env.DISPLAY_FORMAT = (function()\n        local FMT = Color.BROWN(\"XP/hr:\") .. \" %sk\\\n        \" .. Color.YELLOW(\"Ding:\") .. \" %s\\\n        \" .. Color.YELLOW(\"Elapsed:\") .. \" %s\"\n        \n        -- If XP total is enabled, add it to the output format\n        if aura_env.config.config_grp.total_xp_tgl then\n            FMT = FMT .. \"\\\n                \" .. Color.PURPLE(\"XP Gain:\") .. \" %s\"\n        end\n        \n        return FMT\nend)()",
["do_custom"] = true,
},
},
