},
["stickyDuration"] = false,
["version"] = 2,
["displayText_format_c_format"] = "none",
["height"] = 42,
["useAdjustededMax"] = false,
["fontSize"] = 12,
["source"] = "import",
["actions"] = {
["start"] = {
["glow_color"] = {
0,
1,
1,
1,
},
["glow_thickness"] = 2,
["glow_action"] = "show",
["do_glow"] = false,
["glow_lines"] = 10,
["glow_border"] = true,
["custom"] = "\n\n\n\n\n\n\n\n\n\n\n\n\n",
["use_glow_color"] = true,
["glow_type"] = "Pixel",
["do_custom"] = false,
["glow_frame_type"] = "UNITFRAME",
},
["init"] = {
["custom"] = "local LCG = LibStub(\"LibCustomGlow-1.0\")\nlocal glowTypes = {\"Pixel\", \"AutoCast\", \"Standard\"}\nlocal glowType = glowTypes[aura_env.config.glowType]\n\naura_env.glowFrame = function(frame, show)\n    if show then\n        if glowType == \"AutoCast\" then\n            LCG.AutoCastGlow_Start(\n                frame,\n                aura_env.config.acColor,\n                aura_env.config.acParticles,\n                aura_env.config.acFrequency,\n                aura_env.config.acScale,\n                aura_env.config.acxOffset,\n                aura_env.config.acyOffset,\n                aura_env.id\n            )\n        elseif glowType == \"Pixel\" then\n            LCG.PixelGlow_Start(\n                frame,\n                aura_env.config.pgColor,\n                aura_env.config.pgLines,\n                aura_env.config.pgFrequency,\n                aura_env.config.pgLength,\n                aura_env.config.pgThickness,\n                aura_env.config.pgxOffset,\n                aura_env.config.pgyOffset,\n                aura_env.config.pgBorder,\n                aura_env.id\n            )\n        elseif glowType == \"Standard\" then\n            LCG.ButtonGlow_Start(\n                frame,\n                not aura_env.config.bgDefault and aura_env.config.bgColor,\n                aura_env.config.bgFrequency\n            )\n        end\n    else\n        if glowType == \"AutoCast\" then\n            LCG.AutoCastGlow_Stop(frame, aura_env.id)\n        elseif glowType == \"Pixel\" then\n            LCG.PixelGlow_Stop(frame, aura_env.id)\n        elseif glowType == \"Standard\" then\n            LCG.ButtonGlow_Stop(frame)\n        end\n    end\nend",
["do_custom"] = true,
},
["finish"] = {
["glow_frame_type"] = "FRAMESELECTOR",
["hide_all_glows"] = false,
["custom"] = "if aura_env.current then\n    aura_env.glowFrame(aura_env.current)\n    aura_env.current = nil\nend",
["glow_action"] = "hide",
["do_custom"] = true,
["do_glow"] = false,
},
},
["parent"] = "Core Spells",
["xOffset"] = 0,
["preferToUpdate"] = false,
["customText"] = "function()\n    if aura_env.state.unit and aura_env.config.glow then\n        local frame = WeakAuras.GetUnitFrame(aura_env.state.unit)\n        if frame and (frame ~= aura_env.current or not aura_env.current) then\n            \n            if aura_env.current then\n                aura_env.glowFrame(aura_env.current)\n            end\n            aura_env.current = frame\n            \n            aura_env.glowFrame(frame, true)\n            \n        end\n        return WA_ClassColorName(aura_env.state.unit), aura_env.state.matchCount\n    end\nend",
