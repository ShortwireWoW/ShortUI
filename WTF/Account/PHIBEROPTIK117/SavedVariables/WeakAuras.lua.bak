["customText"] = "function()\n    if WeakAuras.IsOptionsOpen() then\n        local tokens = {\n            \"|cff7b8585Bomb|r\",\n            \"|cffffd429Coin|r\",\n            \"|cffff412aFlame|r\",\n            \"|cff226fffShock|r\"\n        }\n        \n        return tokens[math.random(4)]\n    end\n    \n    local spellID = aura_env.states and aura_env.states[2] and aura_env.states[2].spellId\n    \n    return aura_env.spellIDToToken[spellID]\nend",
