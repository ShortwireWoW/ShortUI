["names"] = {
},
["custom"] = "function(event, ...)\n    if event == \"UNIT_SPELLCAST_START\" then\n        local unit, _, spellID = ...\n        \n        return spellID == 459627 and not UnitDetailedThreatSituation(\"player\", unit) -- Tank Buster\n    end\nend",
