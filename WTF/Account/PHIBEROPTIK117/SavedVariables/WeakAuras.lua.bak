["Simple Mine Assignments"] = {
["outline"] = "OUTLINE",
["xOffset"] = 0,
["displayText"] = "%c",
["customText"] = "function()\n    local mp = aura_env.smls_mp or 0\n    \n    local function formatRow(leftIcon, rightIcon, leftPlayer, rightPlayer)\n        return string.format(\"%-8s  %-8s\\n%-8s  %-8s\", leftIcon, rightIcon, leftPlayer, rightPlayer)\n    end\n    \n    --[[    local none = \"-NONE-\"\n    \n    local p = {\n        [1] = aura_env.swma_p1 or none,\n        [2] = aura_env.swma_p2 or none,\n        [3] = aura_env.swma_p3 or none,\n        [4] = aura_env.swma_p4 or none,\n        [5] = aura_env.swma_p5 or none,\n        [6] = aura_env.swma_p6 or none,\n        [7] = aura_env.swma_p7 or none,\n        [8] = aura_env.swma_p8 or none,\n    }\n ]]--\n    \n    local classColors = RAID_CLASS_COLORS\n    \n    local function getClassColoredName(name)\n        if not name or name == \"\" then return nil end\n        name = name:match(\"^%s*(.-)%s*$\") or \"\"\n        \n        for i = 1, GetNumGroupMembers() do\n            local unit = \"raid\" .. i\n            local unitName, _ = UnitName(unit)\n            if unitName and unitName:lower() == name:lower() then\n                local _, class = UnitClass(unit)\n                local color = classColors[class] and classColors[class].colorStr or \"FFFFFFFF\"\n                local trimmed = unitName:gsub(\"-.+\", \"\"):sub(1, 7)\n                return \"|c\" .. color .. trimmed .. \"|r\"\n            end\n        end\n        \n        -- If not found in raid, fallback to white\n        local fallbackName = name:gsub(\"-.+\", \"\"):sub(1, 7)\n        return \"|cFFFFFFFF\" .. fallbackName .. \"|r\"\n    end\n    \n    local function fallback(index, configKey)\n        local val = aura_env[\"swma_p\" .. index]\n        if val and val ~= \"\" then\n            return val\n        end\n        \n        local conf = aura_env.config and aura_env.config[configKey]\n        if conf and conf ~= \"\" then\n            return getClassColoredName(conf)\n        end\n        \n        return \"-NONE-\"\n    end\n    \n    local p = {\n        [1] = fallback(1, \"confSkull\"),\n        [2] = fallback(2, \"confCirc\"),\n        [3] = fallback(3, \"confMoon\"),\n        [4] = fallback(4, \"confStar\"),\n        [5] = fallback(5, \"confCross\"),\n        [6] = fallback(6, \"confDiamond\"),\n        [7] = fallback(7, \"confSquare\"),\n        [8] = fallback(8, \"confTriangle\"),\n    }\n    \n    \n    \n    local space = \"\\n\\n\\n\"\n    local gap = \"\\n\\n\\n\\n\\n\"\n    \n    local layouts = {\n        [0] = {\n            {\"SKULL\", \"CIRCLE\", p[1], p[2]..space},\n            {\"MOON\", \"STAR\", p[3], p[4]..gap},\n            {\"CROSS\", \"DIAMOND\", \"-NONE-\", \"-NONE-\"..space},\n            {\"SQUARE\", \"TRIANGLE\", \"-NONE-\", \"-NONE-\"},\n        },\n        [1] = {\n            {\"SKULL\", \"CIRCLE\", p[1], p[2]..space},\n            {\"MOON\", \"STAR\", p[3], p[4]..gap},\n            {\"CROSS\", \"DIAMOND\", \"-NONE-\", \"-NONE-\"..space},\n            {\"SQUARE\", \"TRIANGLE\", \"-NONE-\", \"-NONE-\"},\n        },\n        [2] = {\n            {\"SKULL\", \"CIRCLE\", \"-NONE-\", \"-NONE-\"..space},\n            {\"MOON\", \"STAR\", \"-NONE-\", \"-NONE-\"..gap},\n            {\"CROSS\", \"DIAMOND\", p[5], p[6]..space},\n            {\"SQUARE\", \"TRIANGLE\", p[7], p[8]},\n        },\n        [3] = {\n            {\"SKULL\", \"CIRCLE\", \"-NONE-\", p[2]..space},\n            {\"MOON\", \"STAR\", \"-NONE-\", p[4]..gap},\n            {\"CROSS\", \"DIAMOND\", \"-NONE-\", p[1]..space},\n            {\"SQUARE\", \"TRIANGLE\", \"-NONE-\", p[3]},\n        },\n        [4] = {\n            {\"SKULL\", \"CIRCLE\", p[5],\"-NONE-\"..space},\n            {\"MOON\", \"STAR\", p[8],\"-NONE-\"..gap},\n            {\"CROSS\", \"DIAMOND\", p[6],\"-NONE-\"..space},\n            {\"SQUARE\", \"TRIANGLE\", p[7],\"-NONE-\"},\n        },\n        [5] = {\n            {\"SKULL\", \"CIRCLE\", p[1], p[2]..space},\n            {\"MOON\", \"STAR\", p[3], p[4]..gap},\n            {\"CROSS\", \"DIAMOND\", \"-NONE-\", \"-NONE-\"..space},\n            {\"SQUARE\", \"TRIANGLE\", \"-NONE-\", \"-NONE-\"},\n        },\n        [6] = {\n            {\"\\n\\nSKULL\", \"CIRCLE\", p[8], \"-NONE-\"..space},\n            {\"\\n\\nMOON\", \"STAR\", p[6], \"-NONE-\"..gap},\n            {\"\\n\\nCROSS\", \"DIAMOND\", \"-NONE-\", p[5]..space},\n            {\"\\n\\nSQUARE\", \"TRIANGLE\", \"-NONE-\", p[7]},\n        },\n    }\n    \n    local layout = layouts[mp]\n    if not layout then return end\n    \n    local output = \"\"\n    for _, row in ipairs(layout) do\n        output = output .. formatRow(unpack(row)) .. \"\\n\\n\"\n    end\n    \n    return output\nend",
["yOffset"] = 0,
["anchorPoint"] = "TOP",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["do_custom"] = true,
["custom"] = "aura_env.smls_wp = 0\naura_env.smls_mp = 0\n\naura_env.ProcessMRTNote = function(msg)\n    local function cleanName(raw)\n        -- Remove server but keep color\n        local color, name = raw:match(\"(|c%x%x%x%x%x%x%x%x)([^|]+)|r\")\n        if color and name then\n            name = name:gsub(\"-.+\", \"\") -- Remove -Server\n            name = name:sub(1, 7)        -- Truncate to 7 characters\n            return color .. name .. \"|r\"\n        end\n        return nil\n    end\n    \n    local swbody = msg:match(\"swminestart%s*([%s%S]-)%s*swmineend\")\n    if not swbody then return end\n    \n    local cleanedNames = {}\n    \n    for raw in swbody:gmatch(\"|c%x%x%x%x%x%x%x%x[^|]+|r\") do\n        local cleaned = cleanName(raw)\n        if cleaned then\n            table.insert(cleanedNames, cleaned)\n        end\n    end\n    \n    if #cleanedNames >= 8 then\n        local payload = table.concat(cleanedNames, \":\")\n        -- SEND the payload to the entire RAID\n        C_ChatInfo.SendAddonMessage(\"SW_SMLS_PA\", payload, \"RAID\")\n    end\nend",
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "unit",
["use_absorbHealMode"] = true,
["subeventSuffix"] = "_CAST_START",
["use_absorbMode"] = true,
["event"] = "Conditions",
["use_unit"] = true,
["spellIds"] = {
},
["use_alwaystrue"] = true,
["unit"] = "player",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["duration"] = "60",
["event"] = "Health",
["unit"] = "player",
["spellIds"] = {
},
["custom"] = "function(event, unit, castGUID, spellID)\n    if event == \"ENCOUNTER_START\" or event == \"ENCOUNTER_END\" then\n        aura_env.smls_wp = 0\n        aura_env.smls_mp = 0\n        return true\n    end\n    \n    if event == \"SW_SMLS_UPDATER\" then\n        if aura_env.swma_p1 == nil then\n            return true\n        end\n    end    \n    \n    if event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        if unit and (unit == \"boss1\" or unit == \"boss2\") and spellID == 1218418 then\n            -- Increment wire\n            aura_env.smls_wp = (aura_env.smls_wp or 0) + 1\n            local wire = aura_env.smls_wp\n            \n            -- Increment mine phase if needed\n            local minePhases = {\n                [1] = true, [2] = true,\n                [4] = true, [5] = true,\n                [7] = true, [8] = true,\n            }\n            \n            if minePhases[wire] then\n                aura_env.smls_mp = (aura_env.smls_mp or 0) + 1\n            end\n            \n            -- Special case Wire 8 (delayed mine phase 6)\n            if wire == 8 then\n                C_Timer.After(20, function()\n                        aura_env.smls_mp = (aura_env.smls_mp or 0) + 1\n                        \n                        if aura_env.swma_p1 == nil then\n                            WeakAuras.ScanEvents(\"SW_SMLS_UPDATER\")\n                        end\n                end)\n            end        \n            return true\n        end\n    end\n    \n    return false\nend",
["events"] = "UNIT_SPELLCAST_SUCCEEDED,ENCOUNTER_START,ENCOUNTER_END,SW_SMLS_UPDATER",
["subeventPrefix"] = "SPELL",
