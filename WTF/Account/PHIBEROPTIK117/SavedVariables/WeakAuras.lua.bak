["type"] = "custom",
["match_count"] = "0",
["custom"] = "function(allstates, event, unit, _, spellID)    \n    if event == \"UNIT_TARGET\"\n    then\n        local _,_,_,_,expirationTime,_,_,_,spellId = UnitCastingInfo(unit)\n        if spellId\n        and spellId == 271698 then\n            local guid = UnitGUID(unit..\"target\")\n            if guid then\n                local unit = UnitTokenFromGUID(guid)\n                if unit then\n                    allstates[guid] = {\n                        show = true,\n                        changed =  true,\n                        progressType = \"timed\", \n                        duration = 3,\n                        expirationTime = 3 + GetTime(),\n                        unit = unit,\n                        autoHide = true,\n                    }\n                    return true\n                end\n            end\n        end\n    end\nend",
