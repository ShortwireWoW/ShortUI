["internalVersion"] = 86,
["source"] = "import",
["customGrow"] = "function(newPositions, activeRegions)\n    -- Check if the central table and function exist\n    if QuaziiWA and QuaziiWA.GrowAbilities then\n        -- Call the centrally defined grow function\n        QuaziiWA:GrowAbilities(newPositions, activeRegions)\n    else\n        -- Fallback or error handling if the central function isn't loaded yet\n        -- Error message removed to prevent spam on first import\n        -- You could optionally provide a default static layout here as a fallback\n        for i = 1, #activeRegions do\n            newPositions[i] = {0, 0} -- Default to hiding/stacking if config isn't loaded\n            if activeRegions[i] then activeRegions[i].region:Hide() end \n        end\n    end\nend",
