["custom"] = "function(allstates, event, ...)\n    if event == \"ENCOUNTER_START\" then \n        C_Timer.After(12.5, function() WeakAuras.ScanEvents(\"CAUSESE_BUZZ_SAW\", \"nilcheck\") end)\n        return true\n    elseif event == \"CAUSESE_BUZZ_SAW\" and ... then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 2.8,\n            expirationTime = 2.8 + GetTime(),\n            autoHide = true,\n        }\n        C_Timer.After(24.3, function() WeakAuras.ScanEvents(\"CAUSESE_BUZZ_SAW\", \"nilcheck\") end)\n        return true\n    end\nend",
