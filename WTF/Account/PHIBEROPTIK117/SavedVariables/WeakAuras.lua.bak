["custom"] = "function(allstates, event, unit)\n    if event == \"UNIT_ABSORB_AMOUNT_CHANGED\" then\n        local absorb = UnitGetTotalAbsorbs(unit)\n        if absorb and absorb > 0 then\n            allstates:Update(\"shield\", {\n                    progressType = \"static\",\n                    total = allstates:Get(\"shield\", \"total\") or absorb,\n                    value = absorb\n            })\n        else\n            allstates:Remove(\"shield\")\n        end\n    end\nend",
