["events"] = "",
["custom"] = "function(allstates, event)\n    if event == \"OPTIONS\" then\n        for i = 1, 6 do\n            allstates[i] = {\n                show = true,\n                changed = true,\n                index = i,\n                autoHide = true\n            }\n        end\n        \n        allstates[math.random(6)].assigned = true\n    elseif event == \"STATUS\" then\n        allstates[\"\"] = {\n            show = true,\n            changed = true,\n            progressType = \"timed\",\n            duration = 0.1,\n            expirationTime = GetTime() + 0.1,\n            autoHide = true\n        }\n        \n        return true\n    end\nend\n\n\n\n",
