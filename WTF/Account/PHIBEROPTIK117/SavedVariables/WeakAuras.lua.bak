["subeventPrefix"] = "SPELL",
["duration"] = "35",
["spellIds"] = {
},
["events"] = "PLAYER_TOTEM_UPDATE",
["use_spellName"] = true,
["realSpellName"] = 0,
["use_unit"] = true,
["use_genericShowOn"] = true,
["spellName"] = 0,
["type"] = "custom",
