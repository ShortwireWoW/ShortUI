["Lunar Effect - Loot Master"] = {
["outline"] = "OUTLINE",
["wagoID"] = "545iusHIy",
["xOffset"] = 0,
["displayText"] = "%c",
["customText"] = "function()\n    if not aura_env.tierList then\n        return \"Tier List: (Empty)\"\n    end\n    \n    local classColors = {\n        [\"DEATHKNIGHT\"] = \"C41F3B\",\n        [\"DEMONHUNTER\"] = \"A330C9\",\n        [\"DRUID\"] = \"FF7D0A\",\n        [\"EVOKER\"] = \"33937F\",\n        [\"HUNTER\"] = \"AAD372\",\n        [\"MAGE\"] = \"3FC7EB\",\n        [\"MONK\"] = \"00FF96\",\n        [\"PALADIN\"] = \"F58CBA\",\n        [\"PRIEST\"] = \"FFFFFF\",\n        [\"ROGUE\"] = \"FFF569\",\n        [\"SHAMAN\"] = \"0070DE\",\n        [\"WARLOCK\"] = \"8787ED\",\n        [\"WARRIOR\"] = \"C79C6E\"\n    }\n    \n    local function GetClassColor(name)\n        if not aura_env.raidClasses then return name end  -- Ensure data exists\n        \n        local class = aura_env.raidClasses[name]\n        if class and classColors[class] then\n            return \"|cFF\" .. classColors[class] .. name .. \"|r\"\n        end\n        return name\n    end\n    \n    local output = \"Tier List:\\n\"\n    for player, items in pairs(aura_env.tierList) do\n        local coloredName = GetClassColor(player)\n        output = output .. coloredName .. \": \"\n        \n        local tierCount = 0\n        for _, itemID in ipairs(items) do\n            local numericID = tonumber(itemID)\n            if numericID and aura_env.tierItemIDs[numericID] then\n                tierCount = tierCount + 1\n            end\n        end\n        output = output .. tierCount .. \"/5 Tier\\n\"\n    end\n    \n    -- List players who didn't respond\n    local missingPlayers = {}\n    for player in pairs(aura_env.raidMembers or {}) do\n        if not (aura_env.receivedResponses and aura_env.receivedResponses[player]) then\n            table.insert(missingPlayers, GetClassColor(player) .. \": |cffC41E3AMissing WA|r\")\n        end\n    end\n    \n    if #missingPlayers > 0 then\n        output = output .. \"\\nMissing Responses:\\n\" .. table.concat(missingPlayers, \"\\n\")\n    end\n    \n    return output\nend",
["shadowYOffset"] = -1,
["anchorPoint"] = "TOPRIGHT",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/545iusHIy/8",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "-- Register our prefix (make sure all players use the same one)\nC_ChatInfo.RegisterAddonMessagePrefix(\"LE_TIER_MAIN\")\n\n-- Table to hold the entire tier list\naura_env.tierList = nil\n\n-- Replace with actual Tier Item IDs off WoWHead.\naura_env.tierItemIDs = {\n    -- DK - TWWS3\n    [237628] = true, -- Helm\n    [237626] = true, -- Shoulder\n    [237631] = true, -- Chest\n    [237629] = true, -- Gloves\n    [237627] = true, -- Legs\n    \n    -- DH - TWWS3\n    [237691] = true, -- Helm\n    [237689] = true, -- Shoulder\n    [237694] = true, -- Chest\n    [237692] = true, -- Gloves\n    [237690] = true, -- Legs\n    \n    -- Druid - TWWS3\n    [237682] = true, -- Helm\n    [237680] = true, -- Shoulder\n    [237685] = true, -- Chest\n    [237683] = true, -- Gloves\n    [237681] = true, -- Legs\n    \n    -- Evoker - TWWS3\n    [237655] = true, -- Helm\n    [237653] = true, -- Shoulder\n    [237658] = true, -- Chest\n    [237656] = true, -- Gloves\n    [237654] = true, -- Legs\n    \n    -- Hunter - TWWS3\n    [237646] = true, -- Helm\n    [237644] = true, -- Shoulder\n    [237649] = true, -- Chest\n    [237647] = true, -- Gloves\n    [237645] = true, -- Legs\n    \n    -- Mage - TWWS3\n    [237718] = true, -- Helm\n    [237716] = true, -- Shoulder\n    [237721] = true, -- Chest\n    [237719] = true, -- Gloves\n    [237717] = true, -- Legs\n    \n    -- Monk - TWWS3\n    [237673] = true, -- Helm\n    [237671] = true, -- Shoulder\n    [237676] = true, -- Chest\n    [237675] = true, -- Gloves\n    [237672] = true, -- Legs\n    \n    -- Paladin - TWWS3\n    [237619] = true, -- Helm\n    [237617] = true, -- Shoulder\n    [237622] = true, -- Chest\n    [237620] = true, -- Gloves\n    [237618] = true, -- Legs\n    \n    -- Priest - TWWS3\n    [237709] = true, -- Helm\n    [237707] = true, -- Shoulder\n    [237712] = true, -- Chest\n    [237710] = true, -- Gloves\n    [237708] = true, -- Legs\n    \n    -- Rogue - TWWS3\n    [237664] = true, -- Helm\n    [237662] = true, -- Shoulder\n    [237667] = true, -- Chest\n    [237665] = true, -- Gloves\n    [237663] = true, -- Legs\n    \n    -- Shaman - TWWS3\n    [237637] = true, -- Helm\n    [237635] = true, -- Shoulder\n    [237640] = true, -- Chest\n    [237638] = true, -- Gloves\n    [237636] = true, -- Legs\n    \n    -- Warlock - TWWS3\n    [237700] = true, -- Helm\n    [237698] = true, -- Shoulder\n    [237703] = true, -- Chest\n    [237701] = true, -- Gloves\n    [237699] = true, -- Legs\n    \n    -- Warrior - TWWS3\n    [237610] = true, -- Helm\n    [237608] = true, -- Shoulder\n    [237613] = true, -- Chest\n    [237611] = true, -- Gloves\n    [237609] = true -- Legs\n}",
["do_custom"] = true,
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "unit",
["use_alwaystrue"] = true,
["subeventSuffix"] = "_CAST_START",
["use_absorbMode"] = true,
["event"] = "Conditions",
["unit"] = "player",
["spellIds"] = {
},
["subeventPrefix"] = "SPELL",
["names"] = {
},
["use_unit"] = true,
["use_absorbHealMode"] = true,
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["custom_type"] = "event",
["duration"] = "0",
["unit"] = "player",
["events"] = "CHAT_MSG_ADDON,ENCOUNTER_END,PLAYER_ENTERING_WORLD",
["check"] = "event",
["debuffType"] = "HELPFUL",
["custom"] = "function(event, ...)\n    -- Helper: raid difficulty (returns number or nil)\n    local function raidDiff()\n        if IsInRaid() and GetRaidDifficultyID then\n            return GetRaidDifficultyID()\n        end\n    end\n    \n    -- Helper: safe split\n    local function explode(str, delimiter)\n        local result = {}\n        for match in string.gmatch(str, \"([^\"..delimiter..\"]+)\") do\n            table.insert(result, match)\n        end\n        return result\n    end\n    \n    if event == \"ENCOUNTER_END\" or event == \"PLAYER_ENTERING_WORLD\" then\n        -- choose chat channel locally (fixes W111/W113)\n        local chatChannel\n        if (raidDiff() == 17) then\n            chatChannel = \"INSTANCE_CHAT\"\n        else\n            chatChannel = \"RAID\"\n        end\n        \n        -- Request tier updates from the group\n        C_Timer.After(5, function()\n                C_ChatInfo.SendAddonMessage(\"LE_TIER\", \"le_update_tier_request\", chatChannel)\n        end)\n    end\n    \n    if event == \"CHAT_MSG_ADDON\" then\n        -- don't bind unused 'channel' (fixes W211)\n        local prefix, message, _, sender = ...\n        \n        if prefix == \"LE_TIER_MAIN\" then\n            -- Ensure tables exist\n            aura_env.receivedResponses = aura_env.receivedResponses or {}\n            aura_env.tierList = aura_env.tierList or {}\n            \n            -- Strip realm from sender (e.g., \"Name-Realm\" -> \"Name\")\n            local senderName = strsplit(\"-\", sender)\n            \n            -- Parse the incoming message\n            local data = explode(message, \":\")\n            if #data < 6 then return false end -- Ensure valid data\n            \n            local playerName = data[1]\n            local itemIDs = { unpack(data, 2, 6) }\n            \n            -- Store the response\n            aura_env.tierList[playerName] = itemIDs\n            \n            -- Track who responded (without realm)\n            aura_env.receivedResponses[senderName] = true\n            \n            return true\n        end\n        \n        if prefix == \"LE_TIER\" then\n            -- Initialize tables\n            aura_env.raidMembers = {}\n            aura_env.raidClasses = {}\n            aura_env.receivedResponses = {}\n            \n            -- Collect all raid members\n            if IsInRaid() then\n                for i = 1, GetNumGroupMembers() do\n                    local name, _, _, _, _, class = GetRaidRosterInfo(i)\n                    if name and class then\n                        -- reuse name; don't shadow (fixes W411)\n                        name = strsplit(\"-\", name)\n                        aura_env.raidMembers[name] = true\n                        aura_env.raidClasses[name] = class\n                    end\n                end\n            end\n        end\n    end\n    \n    return false\nend",
["custom_hide"] = "timed",
},
