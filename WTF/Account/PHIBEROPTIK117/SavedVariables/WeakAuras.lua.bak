{
["trigger"] = {
["type"] = "custom",
["use_eventtype"] = true,
["duration"] = "0.1",
["event"] = "Encounter Events",
["unit"] = "player",
["events"] = "ENCOUNTER_START",
["custom_hide"] = "timed",
["custom"] = "function()\n    aura_env.debug = true\n    aura_env.assignedCircle = 1  -- force assign circle1 for testing\n    \n    C_Timer.After(1, function()\n            print(\"Test: bossCasting = true, no debuff\")\n            aura_env.bossCasting = true\n            aura_env.playerHasDebuff = false\n            aura_env.UpdateCircleColor()\n    end)\n    \n    C_Timer.After(3, function()\n            print(\"Test: playerHasDebuff = true\")\n            aura_env.playerHasDebuff = true\n            aura_env.UpdateCircleColor()\n    end)\n    \n    C_Timer.After(5, function()\n            print(\"Test: bossCasting = false\")\n            aura_env.bossCasting = false\n            aura_env.UpdateCircleColor()\n    end)\n    \n    return true\nend",
