["Liquid Splits"] = {
["outline"] = "OUTLINE",
["wagoID"] = "GxMkCxska",
["parent"] = "Liquid Splits (group)",
["displayText_format_p_time_dynamic_threshold"] = 60,
["shadowYOffset"] = -1,
["anchorPoint"] = "CENTER",
["displayText_format_p_time_format"] = 0,
["customTextUpdate"] = "event",
["url"] = "https://wago.io/LiquidSplits/22",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
["custom"] = "local AceComm = LibStub(\"AceComm-3.0\")\nlocal WA_IterateGroupMembers = WA_IterateGroupMembers\n\nAceComm:RegisterComm(\"LIQUID_SPLIT\",\n    function()\n        local version = 6\n        \n        local instanceID = 2769 -- Liberation of Undermine\n        local numEncounters = 8\n        \n        local normalInfo = \"\"\n        local heroicInfo = \"\"\n        local chatType = IsInGroup(LE_PARTY_CATEGORY_INSTANCE) and \"INSTANCE_CHAT\" or IsInRaid() and \"RAID\" or \"PARTY\"\n        \n        for i = 1, GetNumSavedInstances() do\n            local _, _, _, difficulty, locked, _, _, _, _, _, _, _, _, id = GetSavedInstanceInfo(i)\n            \n            if locked and id == instanceID then\n                for j = 1, numEncounters do\n                    local _, _, isKilled = GetSavedInstanceEncounterInfo(i, j)\n                    \n                    if difficulty == 14 then -- Normal\n                        normalInfo = string.format(\"%s:%s\", normalInfo, isKilled and \"0\" or \"1\")\n                    elseif difficulty == 15 then -- Heroic\n                        heroicInfo = string.format(\"%s:%s\", heroicInfo, isKilled and \"0\" or \"1\")\n                    end\n                end\n            end\n        end\n        \n        if normalInfo == \"\" then\n            normalInfo = string.rep(\":1\", numEncounters)\n        end\n        \n        if heroicInfo == \"\" then\n            heroicInfo = string.rep(\":1\", numEncounters)\n        end\n        \n        local toSend = string.format(\"v%d:%d%s%s\", version, instanceID, normalInfo, heroicInfo)\n        AceComm:SendCommMessage(\"LIQUID_LOCKOUT\", toSend, chatType)\n    end\n)\n\nif not aura_env.region.liquidFrame then\n    aura_env.region.liquidFrame = CreateFrame(\"Frame\")\n    local f = aura_env.region.liquidFrame\n    \n    f:RegisterEvent(\"START_LOOT_ROLL\")\n    \n    f:SetScript(\"OnEvent\",\n        function(_, _, rollID)\n            local inLiquid = 0 -- Number of players in your group that are in <Liquid> or <Team Liquid>\n            \n            for unit in WA_IterateGroupMembers() do\n                local guildName = GetGuildInfo(unit)\n                \n                if guildName and (guildName == \"Liquid\" or guildName == \"Team Liquid\") then\n                    inLiquid = inLiquid + 1\n                end\n            end\n            \n            if inLiquid >= 3 then\n                RollOnLoot(rollID, 0)\n            end\n        end\n    )\nend",
["do_custom"] = true,
},
},
