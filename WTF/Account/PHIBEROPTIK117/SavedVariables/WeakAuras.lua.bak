["customStacks"] = "function()\n    local myGroup = nil\n    \n    if IsInRaid() then\n        for i = 1, GetNumGroupMembers() do\n            local name, _, subgroup = GetRaidRosterInfo(i)\n            if name == UnitName(\"player\") then\n                myGroup = subgroup\n                return myGroup\n            end\n        end\n    end\n    \n    return 0\nend",
