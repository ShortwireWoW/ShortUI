["init"] = {
["custom"] = "function aura_env:GetKeystoneLevel()\n    local keystoneLink = self:GetKeystone()\n    local _, _, _, level = strsplit(\":\", keystoneLink)\n    return tonumber(level)\nend\n\nfunction aura_env:GetKeystone()\n    for bag = 0, 4 do\n        local numSlots = C_Container.GetContainerNumSlots(bag)\n        for slot = 1, numSlots do\n            if (C_Container.GetContainerItemID(bag, slot) == 180653) then\n                return C_Container.GetContainerItemLink(bag, slot)\n            end\n        end\n    end\n    return nil\nend",
["do_custom"] = true,
},
["finish"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["event"] = "Health",
["unit"] = "player",
["custom_type"] = "stateupdate",
