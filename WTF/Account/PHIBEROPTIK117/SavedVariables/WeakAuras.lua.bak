["cooldownEdge"] = false,
["icon"] = true,
["triggers"] = {
{
["trigger"] = {
["type"] = "unit",
["use_absorbHealMode"] = true,
["subeventSuffix"] = "_CAST_START",
["use_absorbMode"] = true,
["event"] = "Conditions",
["unit"] = "player",
["spellIds"] = {
},
["use_alwaystrue"] = true,
["use_unit"] = true,
["names"] = {
},
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["custom_hide"] = "timed",
["duration"] = "2",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["names"] = {
},
["unit"] = "player",
["custom"] = "function(event, ...)\n    -- Define reusable icon update function\n    local function updateIcon(spellID)\n        local icon = GetSpellTexture and GetSpellTexture(spellID)\n        if not icon and C_Spell and C_Spell.GetSpellTexture then\n            icon = C_Spell.GetSpellTexture(spellID)\n        end\n        \n        if icon then\n            if aura_env.region and aura_env.region.SetIcon then\n                aura_env.region:SetIcon(icon)\n            end\n            \n            return true, true, true, {\n                icon = icon,\n            }\n        end\n    end\n    \n    aura_env.sc = aura_env.sc or 0\n    \n    -- Combat state tracking\n    if event == \"PLAYER_REGEN_ENABLED\" then\n        aura_env.swrh_combat = false\n        aura_env.swrh_opener = false\n        aura_env.sc = 0\n        \n    elseif event == \"PLAYER_REGEN_DISABLED\" then\n        aura_env.swrh_combat = true\n        aura_env.sc = 0\n        \n    elseif event == \"UNIT_SPELLCAST_SUCCEEDED\" then\n        local unit, castGUID, spellID = ...\n        if unit ~= \"player\" then return end\n        \n        aura_env.swrh_combat = aura_env.swrh_combat or false\n        \n        if aura_env.swrh_combat then\n            if not aura_env.swrh_opener then\n                print(\"DEBUG: \" .. aura_env.sc .. \" \"  .. aura_env.hunter_mm_mplus[aura_env.sc])                \n                local expectedID = tonumber(aura_env.hunter_mm_mplus[aura_env.sc])\n                if spellID == expectedID then\n                    print(\"DEBUG: Step\", aura_env.sc, \"→ matched spellID\", spellID)\n                    aura_env.sc = aura_env.sc + 1\n                    \n                    if aura_env.sc == aura_env.hunter_mm_mplus_len then\n                        aura_env.swrh_opener = true\n                        print(\"Opener complete! Go to your priority!\")\n                    else\n                        local nextID = tonumber(aura_env.hunter_mm_mplus[aura_env.sc])\n                        updateIcon(nextID)\n                    end\n                else\n                    print(\"DEBUG: Step\", aura_env.sc, \"→ expected\", expectedID, \"but casted\", spellID, \"→ no progress\")\n                end\n            else\n                print(\"Opener complete! Go to your priority!\")                \n            end\n        end\n    end\nend\n\n--updateIcon(spellID)",
["events"] = "PLAYER_REGEN_DISABLED, PLAYER_REGEN_ENABLED,UNIT_SPELLCAST_SUCCEEDED",
