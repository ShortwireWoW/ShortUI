["Scatterbomb Canisters assignment (mythic)"] = {
["outline"] = "OUTLINE",
["wagoID"] = "Jvpud9Ahy",
["authorOptions"] = {
{
["type"] = "toggle",
["default"] = false,
["width"] = 2,
