["unit"] = "player",
["custom"] = "-- Mark Order : Response\nfunction(event)\n\n    local VERSION = 1;\n    local type = \"MarkOrder\";\n    local settings = aura_env.config.Settings;\n    \n    local skull = settings[\"8\"];\n        local cross = settings[\"7\"];\n        local square = settings[\"6\"];\n        local moon = settings[\"5\"];\n        local triangle = settings[\"4\"];\n        local diamond = settings[\"3\"];\n        local circle = settings[\"2\"];\n        local star = settings[\"1\"];\n        \n        WeakAuras.ScanEvents(\"AutomarkSettingsResponse\", VERSION, type, skull, cross, square, moon, triangle, diamond, circle, star);\nend",
