},
["use_unit"] = true,
["duration"] = "4.1",
["subeventPrefix"] = "SPELL",
["use_destFlags3"] = false,
["custom"] = "function(allstates, event, ...)\n    if event == \"COMBAT_LOG_EVENT_UNFILTERED\" then\n        local timestamp, subEvent, hideCaster, sourceGUID, sourceName, sourceFlags, sourceRaidFlags, destGUID, destName, destFlags, destRaidFlags, spellID = ...\n        if spellID == 319603\n        and destGUID ~= WeakAuras.myGUID then\n            if subEvent == \"SPELL_AURA_APPLIED\" then\n                allstates:Update(destGUID, {\n                        progressType = \"timed\",\n                        duration = 4,\n                        expirationTime = 4 + GetTime(),\n                        autoHide = true,\n                })\n            elseif subEvent == \"SPELL_AURA_REMOVED\" then\n                allstates:Remove(destGUID)\n            end\n        end\n    end\nend",
["use_destName"] = false,
["events"] = "CLEU:SPELL_AURA_APPLIED:SPELL_AURA_REMOVED",
["debuffType"] = "HARMFUL",
["auraspellids"] = {
