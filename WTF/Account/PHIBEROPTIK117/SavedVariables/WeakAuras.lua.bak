["Spin To Win! combination list"] = {
["sparkWidth"] = 10,
["iconSource"] = -1,
["wagoID"] = "Jvpud9Ahy",
["authorOptions"] = {
{
["type"] = "toggle",
["key"] = "spinToWin",
["default"] = false,
["useDesc"] = false,
["name"] = "Only show during [Spin To Win!]",
["width"] = 2,
