["displayText"] = "Cloudburst Totem",
["customText"] = "\n-- Do not remove this comment, it is part of this aura: Cloudburst Totem Reminder",
["automaticWidth"] = "Auto",
["actions"] = {
["start"] = {
},
["init"] = {
["custom"] = "aura_env.counters = {}\naura_env.handled = {}\n\n-- Show at x seconds remaining\naura_env.tests = {\n    \n    -- Test (BigWigs)\n    [\"Test\"] = 10,\n    \n    -- Test (Deadly Boss Mods)\n    [\"Important Interrupt\"] = 15,\n    [\"Adds\"] = 15,\n    [\"Evil Debuff\"] = 15,\n    [\"Boom!\"] = 15,\n}\n\n-- Show at x seconds remaining\naura_env.timers = {\n    \n    -- Algeth'ar Academy\n    [388923] = 15,  -- Burst Forth (Overgrown Ancient)\n    [377004] = 15,  -- Deafening Screech (Crawth)\n    [386173] = 15,  -- Mana Bombs (Vexamus)\n    [388822] = 15,  -- Power Vacuum (The Echo of Doragosa)\n    \n    -- Brackenhide Hollow\n    [\"Gash Frenzy (1)\"] = 3,  -- Gash Frenzy #1 (Gashtooth)\n    [378029] = 10,  -- Gash Frenzy (Gashtooth)\n    [373960] = 15,  -- Decaying Strength (Decatriarch Wratheye)\n    \n    -- Halls of Infusion\n    [384014] = 15,  -- Static Surge (Watcher Irideus)\n    [385187] = 15,  -- Overpowering Croak (Gulping Goliath)\n    [388424] = 15,  -- Tempest's Fury (Primal Tsunami)\n    \n    -- Neltharus\n    [375056] = 15,  -- Fiery Focus (Chargath, Bane of Scales)\n    [374635] = 15,  -- Might of the Forge (Forgemaster Gorek)\n    [374365] = 15,  -- Volatile Mutation (Magmatusk)\n    [376780] = 15,  -- Magma Shield (Warlord Sargha)\n    \n    -- Ruby Life Pools\n    [372851] = 15,  -- Chillstorm (Melidrussa Chillworn)\n    [372863] = 15,  -- Ritual of Blazebinding (Blazebound Firestorm)\n    [381862] = 15,  -- Infernocore (Erkhart Stormvein)\n    \n    -- The Azure Vault\n    [374567] = 15,  -- Explosive Brand (Leymor)\n    [384132] = 15,  -- Overwhelming Energy (Azureblade)\n    [386781] = 10,  -- Frost Bomb (Telash Greywing)\n    \n    -- The Nokhud Offensive\n    [388817] = 10,  -- Shards of Stone (Granyth)\n    [384620] = 15,  -- Electrical Storm (The Raging Tempest)\n    [382670] = 15,  -- Gale Arrow (Teera)\n    [375943] = 15,  -- Upheaval (Balakar Khan)\n    [376892] = 15,  -- Crackling Upheaval (Balakar Khan)\n    \n    -- Uldaman: Legacy of Tyr\n    [369700] = 15,  -- Quaking Totem (Bromach)\n    [369110] = 15,  -- Unstable Embers (Emberon)\n    [376049] = 15,  -- Wing Buffet (Chrono-Lord Deios)\n    \n    -- The Stonevault\n    [424789] = 15,  -- Earth Shatter (EDNA)\n    [423200] = 15,  -- Fortified Shell (Skarmorak)\n    [428508] = 15,  -- Blazing Crescendo (Master Machinists)\n    [427329] = 15,  -- Void Corruption (Void Speaker Eirich)\n    \n    -- Ara-Kara, City of Echoes\n    [438476] = 15,  -- Alerting Shrill (Avanoxx)\n    [433740] = 15,  -- Infestation (Anub'zekt)\n    [461487] = 15,  -- Cultivated Poisons (Ki'katal the Harvester)\n    [434802] = 15,  -- Horrifying Shrill (Trash Mobs)\n    [438877] = 15,  -- Call of the Brood (Trash Mobs)\n    \n    -- Mists of Tirna Scithe\n    [323149] = 15,  -- Embrace Darkness (Ingra Maloch)\n    [336499] = 15,  -- Guessing Game (Mistcaller)\n    [322550] = 15,  -- Mind Link (Tred'ova)\n    \n    -- Grim Batol\n    [448847] = 15,  -- Commanding Roar (General Umbriss)\n    [451996] = 15,  -- Forge Axe (Forgemaster Throngus)\n    [456902] = 15,  -- Forge Swords (Forgemaster Throngus)\n    [456900] = 15,  -- Forge Mace (Forgemaster Throngus)\n    [456751] = 15,  -- Twilight Buffet (Drahga Shadowburner)\n    [450077] = 15,  -- Void Surge (Erudax)\n    \n    -- The Necrotic Wake\n    [320655] = 15,  -- Crunch (Blightbone)\n    [321226] = 15,  -- Land of the Dead (Amarth)\n    [320200] = 15,  -- Stitchneedle (Surgeon Stitchflesh)\n    [321754] = 15,  -- Icebound Aegis (Nalthor the Rimebinder)\n    \n    -- Siege of Boralus\n    [463182] = 15,  -- Fiery Ricochet (Dread Captain Lockwood)\n    [257326] = 15,  -- Gore Crash (Chopper Redhook)\n    [260924] = 15,  -- Steel Tempest (Chopper Redhook)\n    [257882] = 15,  -- Break Water (Hadal Darkfathom)\n    [269266] = 15,  -- Slam (Viq'Goth)\n    \n    -- The Dawnbreaker\n    [453212] = 15,  -- Obsidian Beam (Speaker Shadowcrown)\n    [425264] = 15,  -- Obsidian Blast (Speaker Shadowcrown)\n    [426860] = 12,  -- Dark Orb (Anub'ikkaj)\n    [434089] = 15,  -- Spinneret's Strands (Rasha'nan)\n    \n    -- City of Threads\n    [434829] = 15,  -- Vociferous Indoctrination (Orator Krix'vizk)\n    [439692] = 15,  -- Duskbringer (Fangs of the Queen)\n    [441216] = 15,  -- Viscous Darkness (The Coaglamation)\n    [439341] = 15,  -- Splice (Izo)\n    [437700] = 15,  -- Tremor Slam (Izo)\n    [447271] = 15,  -- Tremor Slam (Trash Mobs)\n}\n\n-- Show at x Health remaining\naura_env.percents = {    \n    \n    -- The Azure Vault (Dragonflight)\n    [2584] = {  -- Umbrelskul\n        [186738] = {\n            77,\n            52,\n            27,\n        },\n    },\n}",
