{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["events"] = "PLAYER_ENTERING_WORLD, CHARACTER_POINTS_CHANGED, UNIT_LEVEL, UNIT_STATS, UNIT_RANGEDDAMAGE, UNIT_ATTACK_POWER, UNIT_RANGED_ATTACK_POWER, UNIT_ATTACK, UNIT_SPELL_HASTE, COMBAT_RATING_UPDATE, MASTERY_UPDATE, SPEED_UPDATE, LIFESTEAL_UPDATE, AVOIDANCE_UPDATE, PLAYER_TALENT_UPDATE, PLAYER_EQUIPMENT_CHANGED, PLAYER_AVG_ITEM_LEVEL_UPDATE, ACTIVE_TALENT_GROUP_CHANGED, UNIT_DAMAGE, UNIT_ATTACK_SPEED, UNIT_MAXHEALTH, UNIT_MAXPOWER, SPELL_POWER_CHANGED, CHARACTER_ITEM_FIXUP_NOTIFICATION, CCS_STATS",
["check"] = "event",
["custom_type"] = "status",
["custom"] = "function(event, arg1, arg2)\n    local throttle = 0\n    if (event == \"UNIT_DAMAGE\" or event == \"UNIT_ATTACK_SPEED\" or event == \"UNIT_MAXHEALTH\") and arg1 ~= \"player\" then return end\n    if not CharacterFrame:IsVisible() and event ~= \"CCS_STATS\" then return end\n    \n    if CharacterStatsPaneilvl then \n        throttle = CharacterStatsPaneilvl.throttle\n    end\n    \n    if (GetTime() - throttle) >= .5 or event == \"PLAYER_EQUIPMENT_CHANGED\" or event == \"CCS_STATS\" then\n        aura_env.sortAndOffset()\n    end\n    \n    if CharacterStatsPaneilvl then \n        CharacterStatsPaneilvl.throttle = GetTime()\n    end\n    \nend",
["customVariables"] = "",
},
["untrigger"] = {
},
},
{
["trigger"] = {
["unit"] = "player",
["type"] = "custom",
["events"] = "PLAYER_STARTED_LOOKING, PLAYER_STARTED_MOVING, PLAYER_STARTED_TURNING, PLAYER_STOPPED_LOOKING, PLAYER_STOPPED_MOVING, PLAYER_STOPPED_TURNING, SPEED_UPDATE",
["custom_type"] = "stateupdate",
["check"] = "event",
["custom_hide"] = "timed",
["custom"] = "function(states, event, ...)\n    if not InCombatLockdown() and CharacterFrame:IsVisible() then\n        aura_env.updatemovespeed()\n    end\nend",
