["custom"] = "function(allstates, event, ...)\n    if event == \"UNIT_SPELLCAST_STOP\" then\n        local unit, _, spellID = ...\n        if spellID == 1230087 then\n            aura_env.counter = aura_env.counter + 1\n            local timer = aura_env.counter % 2 == 0 and 4.25 or 7.7\n            allstates:Update(\"\", {\n                    progressType = \"timed\",\n                    duration = timer,\n                    expirationTime = timer + GetTime(),\n                    count = aura_env.counter,\n                    even = aura_env.counter % 2 == 0,\n                    autoHide = true,\n            })\n        end\n    elseif event == \"ENCOUNTER_START\" then\n        aura_env.counter = 0\n    end\nend",
