["Shortwire - Evens/Odds"] = {
["parent"] = "Shortwire - Manaforge Omega",
["animation"] = {
["start"] = {
["easeStrength"] = 3,
["type"] = "none",
["duration_type"] = "seconds",
["easeType"] = "none",
},
["main"] = {
["easeStrength"] = 3,
["type"] = "none",
["duration_type"] = "seconds",
["easeType"] = "none",
},
["finish"] = {
["easeStrength"] = 3,
["type"] = "none",
["duration_type"] = "seconds",
["easeType"] = "none",
},
},
["yOffset"] = 0,
["anchorPoint"] = "CENTER",
["authorOptions"] = {
},
["information"] = {
},
["regionType"] = "empty",
["actions"] = {
["start"] = {
},
["finish"] = {
},
["init"] = {
},
},
["triggers"] = {
{
["trigger"] = {
["type"] = "custom",
["subeventSuffix"] = "_CAST_START",
["duration"] = "1",
["event"] = "Health",
["subeventPrefix"] = "SPELL",
["debuffType"] = "HELPFUL",
["unit"] = "player",
["custom"] = "function(event)\n    local function subgroup()\n        if not IsInRaid() then return nil end\n        local i = UnitInRaid(\"player\"); if not i then return nil end\n        local _, _, g = GetRaidRosterInfo(i + 1)\n        return g\n    end\n    \n    local g = subgroup()\n    local isEven = (g and (g % 2 == 0)) or false\n    \n    -- broadcast both a generic & specific event\n    WeakAuras.ScanEvents(\"WA_PARITY\", isEven, g or 0)\n    WeakAuras.ScanEvents(isEven and \"WA_PARITY_EVEN\" or \"WA_PARITY_ODD\", g or 0)\n    \n    -- Controller itself stays hidden\n    return false\nend",
["names"] = {
},
["custom_type"] = "event",
["events"] = "PLAYER_ENTERING_WORLD GROUP_ROSTER_UPDATE ENCOUNTER_START ENCOUNTER_END",
["spellIds"] = {
},
["custom_hide"] = "timed",
},
["untrigger"] = {
},
},
["activeTriggerMode"] = -10,
},
["frameStrata"] = 1,
["internalVersion"] = 85,
["anchorFrameType"] = "SCREEN",
["selfPoint"] = "CENTER",
["id"] = "Shortwire - Evens/Odds",
["thumbnailIcon"] = 237552,
["alpha"] = 1,
["width"] = 200,
["config"] = {
},
["uid"] = "JGKW01FuAlB",
["desc"] = "How to use it in other auras (two easy ways)\nA) Simplest: subscribe to the specific event\n\nEvens\n\nTrigger >> Custom >> Event\n\nEvents: WA_PARITY_EVEN\n\nCustom Trigger:\n\nfunction(event) return true end\n\n\n(That trigger becomes true whenever the helper fires WA_PARITY_EVEN.)\n\nOdds\n\nSame, but Events: WA_PARITY_ODD\n\nThen combine with your DBM/BigWigs triggers via Required for Activation >> Custom:\n\n(trParity) and (trBWtimer or trBWmsg or trDBMtimer or trDBMannounce)\n\nB) Generic event with an argument (flexible)\n\nUse the generic broadcast and read the boolean:\n\nTrigger >> Custom >> Event\n\nEvents: WA_PARITY\n\nCustom Trigger (Evens):\n\nfunction(event, isEven, group)  -- args passed from the helper\n  return isEven == true\nend\n\n\nCustom Trigger (Odds):\n\nfunction(event, isEven, group)\n  return isEven == false\nend\n\n\nYou can also use group if you need exact subgroup logic later.",
["subRegions"] = {
},
["height"] = 200,
