["unit"] = "player",
["custom"] = "function(allstates, event, unit, _, spellID)\n    if event == \"UNIT_SPELLCAST_START\" then\n        if spellID == 1224787 or spellID == 1224812 then\n            aura_env.counter = aura_env.counter + 1\n            if aura_env.counter == 4 then\n                local _, _, _, startC, endC  = UnitCastingInfo(unit)\n                local duration = (endC - startC) / 1000\n                local expirationTime = endC / 1000\n                allstates:Update(\"\", {\n                        progressType = \"timed\",\n                        duration = duration + 16,\n                        expirationTime = expirationTime + 16,\n                        autoHide = true,\n                })\n                aura_env.counter = 0\n            end\n        end\n    elseif event == \"ENCOUNTER_START\" then\n        aura_env.counter = 0\n    end\nend",
