["spellIds"] = {
},
["custom"] = "function()\n    aura_env.smls_wp = 0\n    aura_env.smls_mp = 0\n    return true\nend",
["events"] = "ENCOUNTER_START,ENCOUNTER_END",
["custom_type"] = "event",
["names"] = {
},
["unit"] = "player",
["debuffType"] = "HELPFUL",
