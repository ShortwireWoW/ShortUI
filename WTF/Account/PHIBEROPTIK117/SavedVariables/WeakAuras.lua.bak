["actions"] = {
["start"] = {
["do_custom"] = true,
["custom"] = "function hideThese()\n    \n    local hide = {\n        ObjectiveTrackerFrame:Hide(),\n        BuffFrame:Hide(),\n        MinimapCluster:Hide(),\n        MicroMenuContainer:Hide(),\n        BagsBar:Hide()\n    }\n    \n    for i=1, #hide do\n        ConsoleExec(hide[i],false)       \n    end    \nend\n\nhideThese()",
},
["init"] = {
["do_custom"] = true,
["custom"] = "function showThese()\n    \n    local show = {\n        ObjectiveTrackerFrame:Show(),\n        BuffFrame:Show(),\n        MinimapCluster:Show(),\n        MicroMenuContainer:Show(),\n        BagsBar:Show()\n    }\n    \n    for i=1, #show do\n        ConsoleExec(show[i],false)       \n    end    \nend\n\nshowThese()",
},
["finish"] = {
