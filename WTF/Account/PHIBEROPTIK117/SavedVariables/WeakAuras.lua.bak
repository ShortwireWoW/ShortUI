["useName"] = false,
["spellName"] = {
},
["subeventSuffix"] = "_CAST_SUCCESS",
["type"] = "custom",
["custom_type"] = "stateupdate",
["useExactSpellId"] = false,
["custom"] = "function(allstates, event, ...)\n    if event == \"TRIGGER\" then\n        local _, info = ...\n        if info and next(info) then\n            local guid = info[\"\"].sourceGUID\n            if guid then\n                local unit = UnitTokenFromGUID(guid)    \n                if unit and UnitThreatSituation(\"player\", unit) then\n                    for k,v in pairs(allstates) do\n                        v.show = false\n                        v.changed = true\n                    end\n                    C_Timer.After(9.8, function() WeakAuras.ScanEvents(\"CAUSESE_NEKTHARA\", guid) end)\n                    return true\n                end\n            end\n        end\n    elseif event == \"CAUSESE_NEKTHARA\" and ... then\n        local guid = ...\n        local unit = UnitTokenFromGUID(guid)\n        if unit then\n            allstates[\"\"] = {\n                show = true,\n                changed = true,\n                progressType = \"timed\",\n                duration = 6,\n                expirationTime = 6 + GetTime(),\n                autoHide = true,\n            }\n            return true\n        end\n    end\nend",
["spellIds"] = {
},
["event"] = "Boss Mod Timer",
["use_spellName"] = false,
["unit"] = "player",
["use_spellId"] = false,
["events"] = "TRIGGER:1, CAUSESE_NEKTHARA",
["use_sourceUnit"] = false,
["check"] = "event",
