},
["displayText_format_p_time_mod_rate"] = true,
["selfPoint"] = "CENTER",
["rotation"] = 0,
["font"] = "Quazii",
["crop_y"] = 0.41,
["textureWrapMode"] = "CLAMP",
["startAngle"] = 0,
