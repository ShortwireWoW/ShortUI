["customText"] = "function()\n    return format(\"%.0f\", aura_env.health / UnitHealthMax(\"player\") * 100), aura_env.abbreviate(aura_env.health)\nend",
["uid"] = "S(K033p5RnS",
["alpha"] = 1,
