["init"] = {
["custom"] = "AddOnUtil.LoadAddOn(\"Blizzard_ChallengesUI\")\nAddOnUtil.LoadAddOn(\"Blizzard_WeeklyRewards\")\nWeeklyRewards_LoadUI()\nlocal aura_env = aura_env\nlocal c = aura_env.config\nlocal region = WeakAuras.GetRegion(aura_env.id)\nlocal _G = _G\nlocal LSM = LibStub(\"LibSharedMedia-3.0\");\nlocal charsheet = WeakAuras.GetData(\"CCS Character Sheet\")\nlocal nukeit = charsheet.config.nukeit\nlocal WA_Font = LSM:Fetch(\"font\", charsheet.subRegions[2].text_font)\nlocal textoptions = \"THICK OUTLINE\"\nC_MythicPlus.RequestCurrentAffixes();\nC_MythicPlus.RequestMapInfo();\n\naura_env.Dungeon_Teleports = {\n    -- [mapID]= {spellID = xxxxxx}, \n    [2]=   { spellID = 131204},    --  Temple of the Jade Serpent\n    [56]=  { spellID = 131205},    --  Stormstout Brewery\n    [57]=  { spellID = 131225},    --  Gate of the Setting Sun\n    [58]=  { spellID = 131206},    --  Shado-Pan Monastery\n    [59]=  { spellID = 131228},    --  Siege of Niuzao Temple\n    [60]=  { spellID = 131222},    --  Mogu'shan Palace\n    [76]=  { spellID = 131232},    --  Scholomance\n    [77]=  { spellID = 131231},    --  Scarlet Halls\n    [78]=  { spellID = 131229},    --  Scarlet Monastery\n    [161]= { spellID = 159898},    --  Skyreach\n    [163]= { spellID = 159895},    --  Bloodmaul Slag Mines\n    [164]= { spellID = 159897},    --  Auchindoun\n    [165]= { spellID = 159899},    --  Shadowmoon Burial Grounds\n    [166]= { spellID = 159900},    --  Grimrail Depot\n    [167]= { spellID = 159902},    --  Upper Blackrock Spire\n    [168]= { spellID = 159901},    --  The Everbloom\n    [169]= { spellID = 159896},    --  Iron Docks\n    [197]= { spellID = 0},        --  Eye of Azshara\n    [198]= { spellID = 424163},    --  Darkheart Thicket\n    [199]= { spellID = 424153},    --  Black Rook Hold\n    [200]= { spellID = 393764},    --  Halls of Valor\n    [206]= { spellID = 410078},    --  Neltharion's Lair\n    [207]= { spellID = 0},        --  Vault of the Wardens\n    [208]= { spellID = 0},        --  Maw of Souls\n    [209]= { spellID = 0},        --  The Arcway\n    [210]= { spellID = 393766},    --  Court of Stars\n    [227]= { spellID = 373262},    --  Return to Karazhan: Lower\n    [233]= { spellID = 0},        --  Cathedral of Eternal Night\n    [234]= { spellID = 373262},    --  Return to Karazhan: Upper\n    [239]= { spellID = 0},        --  Seat of the Triumvirate\n    -- Battle for Azeroth\n    [244]= { spellID = 424187},    --  Atal'Dazar\n    [245]= { spellID = 410071},    --  Freehold\n    [246]= { spellID = 0},        --  Tol Dagor\n    [247]= { spellID = 467553},        --  The MOTHERLODE!!\n    [247]= { spellID = 467555},        --  The MOTHERLODE!!\n    [248]= { spellID = 424167},    --  Waycrest Manor\n    [249]= { spellID = 0},        --  Kings' Rest\n    [250]= { spellID = 0},        --  Temple of Sethraliss\n    [251]= { spellID = 410074},    --  The Underrot\n    [252]= { spellID = 0},        --  Shrine of the Storm\n    [353]= { spellID = 445418},    --  Siege of Boralus (Alliance)\n    [353]= { spellID = 464256},    --  Siege of Boralus (Horde)\n    [369]= { spellID = 373274},     --  Operation: Mechagon - Junkyard\n    [370]= { spellID = 373274},    --  Operation: Mechagon - Workshop\n    -- Shadowlands\n    [375]= { spellID = 354464},    --  Mists of Tirna Scithe\n    [376]= { spellID = 354462},    --  The Necrotic Wake\n    [377]= { spellID = 354468},    --  De Other Side\n    [378]= { spellID = 354465},    --  Halls of Atonement\n    [379]= { spellID = 354463},    --  Plaguefall\n    [380]= { spellID = 354469},    --  Sanguine Depths\n    [381]= { spellID = 354466},    --  Spires of Ascension\n    [382]= { spellID = 354467},    --  Theater of Pain\n    [391]= { spellID = 367416},    --  Tazavesh: Streets of Wonder\n    [392]= { spellID = 367416},    --  Tazavesh: So'leah's Gambit\n    -- Dragonflight\n    [399]= { spellID = 393256},    --  Ruby Life Pools\n    [400]= { spellID = 393262},    --  The Nokhud Offensive\n    [401]= { spellID = 393279},    --  The Azure Vault\n    [402]= { spellID = 393273},    --  Algeth'ar Academy\n    [403]= { spellID = 393222},    --  Uldaman: Legacy of Tyr\n    [404]= { spellID = 393276},    --  Neltharus\n    [405]= { spellID = 393267},    --  Brackenhide Hollow\n    [406]= { spellID = 393283},    --  Halls of Infusion\n    [438]= { spellID = 410080},    --  The Vortex Pinnacle\n    [456]= { spellID = 424142},    --  Throne of the Tides\n    [463]= { spellID = 424197},    --  Dawn of the Infinite: Galakrond's Fall\n    [464]= { spellID = 424197},    --  Dawn of the Infinite: Murozond's Rise\n    -- The War Within\n    [499]= { spellID = 445444},    --  Priory of the Sacred Flame\n    [500]= { spellID = 445443},    --  The Rookery\n    [501]= { spellID = 445269},    --  The Stonevault\n    [502]= { spellID = 445416},    --  City of Threads\n    [503]= { spellID = 445417},    --  Ara-kara, City of Echoes\n    [504]= { spellID = 445441},    --  Darkflame Cleft\n    [505]= { spellID = 445414},    --  The Dawnbreaker\n    [506]= { spellID = 445440},    --  Cinderbrew Meadery\n    [507]= { spellID = 445424},    --  Grim Batol\n    [525]= { spellID = 1216786},   --  Operation: Floodgate    \n    [542]= { spellID = 1237215},   --  Eco-Dome Al'dani\n}\n\naura_env.display_time = function(timex, spelltimer)\n    local timestring = \"\"\n    \n    if timex < 0 then timex = timex*-1 end\n    \n    local hours = floor(mod(timex, 86400)/3600)\n    local minutes = floor(mod(timex, 3600)/60)\n    local seconds = floor(mod(timex,60))\n    if spelltimer == false then\n        timestring = format(\"%02d:%02d:%02d\", hours, minutes, seconds)\n    else\n        if hours > 0 then timestring = timestring .. hours .. \"h \" end\n        if minutes > 0 then timestring = timestring .. format(\"%02dm \",minutes) end\n        if seconds > 0 and hours <= 0 then timestring = timestring .. format(\"%02ds \", seconds)  end\n    end\n    return timestring\nend\n\naura_env.stars = function(runtime, dungeontime)\n    local text = \"|cFFFFFC33\"..\"|r\"\n    \n    if runtime == 0 then text = \"|cFFFFFC33\"..\"|r\"\n    elseif runtime < (dungeontime * 0.6) then text = \"|cFFFFFC33\"..\"***\"..\"|r\"\n    elseif runtime < (dungeontime * 0.8) then text = \"|cFFFFFC33\"..\"**\"..\"|r\"\n    elseif runtime < dungeontime then text = \"|cFFFFFC33\"..\"*\"..\"|r\"\n    end\n    return text\nend\n\naura_env.RunProgression = function()\n    local tf=C_MythicPlus.GetRunHistory(true, false);\n    local t20s, t15s, t10s, t7s, t5s, t2s=0,0,0,0,0,0\n    local x = 1;\n    local maptable = {C_ChallengeMode.GetMapTable()}\n    \n    while tf[x] do\n        local found = false;\n        for mapID=1,8 do\n            if maptable[1] and maptable[1][mapID] and (tf[x].mapChallengeModeID == maptable[1][mapID]) then\n                found = true\n            end\n        end\n        \n        if tf[x].completed and found then\n            if tf[x].completed and tf[x].level >= 20 then t20s=t20s+1\n            elseif tf[x].completed and tf[x].level >= 15 then t15s=t15s+1\n            elseif tf[x].completed and tf[x].level >= 10 then t10s=t10s+1\n            elseif tf[x].completed and tf[x].level >= 7 then t7s=t7s+1  \n            elseif tf[x].completed and tf[x].level >= 5 then t5s=t5s+1  \n            elseif tf[x].completed and tf[x].level >= 2 then t2s=t2s+1  \n            end\n        end\n        x=x+1\n    end\n    \n    return t20s, t15s, t10s, t7s, t5s, t2s\nend\n\naura_env.ShowIncompleteMythicTooltip = function (t, tframe, mythictt, worldtt, raidtt)\n    GameTooltip:SetOwner(tframe, \"ANCHOR_RIGHT\", -7, -11);\n    GameTooltip_SetTitle(GameTooltip, WEEKLY_REWARDS_UNLOCK_REWARD);\n    if t.info.index == 1 then    -- 1st box in this row\n        if mythictt then GameTooltip_AddNormalLine(GameTooltip, GREAT_VAULT_REWARDS_MYTHIC_INCOMPLETE)\n        elseif worldtt then GameTooltip_AddNormalLine(GameTooltip, format(GREAT_VAULT_REWARDS_WORLD_INCOMPLETE, 2))\n        elseif raidtt then GameTooltip_AddNormalLine(GameTooltip, format(t.info.raidString, 2))\n        end\n    else\n        local globalString=\"\";\n        if t.info.index == 2 then    -- 2nd box in this row\n            \n            if mythictt then globalString = GREAT_VAULT_REWARDS_MYTHIC_COMPLETED_FIRST;\n            elseif worldtt then globalString = GREAT_VAULT_REWARDS_WORLD_COMPLETED_FIRST;\n            elseif raidtt then globalString = GREAT_VAULT_REWARDS_MYTHIC_COMPLETED_FIRST\n            end\n            \n        else    -- 3rd box\n            if mythictt then globalString = GREAT_VAULT_REWARDS_MYTHIC_COMPLETED_SECOND;\n            elseif worldtt then globalString = GREAT_VAULT_REWARDS_WORLD_COMPLETED_FIRST;\n            elseif raidtt then globalString = GREAT_VAULT_REWARDS_MYTHIC_COMPLETED_SECOND;\n            end\n        end\n        GameTooltip_AddNormalLine(GameTooltip, globalString:format(t.info.threshold - t.info.progress));\n        if t.info.progress > 0 and not worldtt then\n            GameTooltip_AddBlankLineToTooltip(GameTooltip);\n            local lowestLevel = WeeklyRewardsUtil.GetLowestLevelInTopDungeonRuns(t.info.threshold);\n            if lowestLevel == WeeklyRewardsUtil.HeroicLevel then\n                GameTooltip_AddNormalLine(GameTooltip, GREAT_VAULT_REWARDS_CURRENT_LEVEL_HEROIC:format(t.info.threshold));\n            else\n                GameTooltip_AddNormalLine(GameTooltip, GREAT_VAULT_REWARDS_CURRENT_LEVEL_MYTHIC:format(t.info.threshold, lowestLevel));\n            end\n        end\n    end\n    if mythictt then aura_env.AddTopRunsToTooltip(t); end\n    GameTooltip:Show();\nend\n\naura_env.AddTopRunsToTooltip = function(t)\n    GameTooltip_AddBlankLineToTooltip(GameTooltip);\n    GameTooltip_AddHighlightLine(GameTooltip, string.format(WEEKLY_REWARDS_MYTHIC_TOP_RUNS, t.info.threshold));\n    \n    local runHistory = C_MythicPlus.GetRunHistory(false, true);\n    if #runHistory > 0 then\n        local comparison = function(entry1, entry2)\n            if ( entry1.level == entry2.level ) then\n                return entry1.mapChallengeModeID < entry2.mapChallengeModeID;\n            else\n                return entry1.level > entry2.level;\n            end\n        end\n        table.sort(runHistory, comparison);\n        for i = 1, t.info.threshold do\n            if runHistory[i] then\n                local runInfo = runHistory[i];\n                local name = C_ChallengeMode.GetMapUIInfo(runInfo.mapChallengeModeID);\n                GameTooltip_AddHighlightLine(GameTooltip, string.format(WEEKLY_REWARDS_MYTHIC_RUN_INFO, runInfo.level, name));\n            end\n        end\n    end\n    \n    local missingRuns = t.info.threshold - #runHistory;\n    if missingRuns > 0 then\n        local numHeroic, numMythic, numMythicPlus = C_WeeklyRewards.GetNumCompletedDungeonRuns();\n        while numMythic > 0 and missingRuns > 0 do\n            GameTooltip_AddHighlightLine(GameTooltip, WEEKLY_REWARDS_MYTHIC:format(WeeklyRewardsUtil.MythicLevel));\n            numMythic = numMythic - 1;\n            missingRuns = missingRuns - 1;\n        end\n        while numHeroic > 0 and missingRuns > 0 do\n            GameTooltip_AddHighlightLine(GameTooltip, WEEKLY_REWARDS_HEROIC);\n            numHeroic = numHeroic - 1;\n            missingRuns = missingRuns - 1;\n        end\n    end\nend\n\naura_env.HandlePreviewMythicRewardTooltip = function(self, itemLevel, upgradeItemLevel, nextLevel)\n    local isHeroicLevel = self:IsCompletedAtHeroicLevel();\n    if isHeroicLevel then        \n        GameTooltip_AddNormalLine(GameTooltip, string.format(WEEKLY_REWARDS_ITEM_LEVEL_HEROIC, itemLevel));\n    else\n        GameTooltip_AddNormalLine(GameTooltip, string.format(WEEKLY_REWARDS_ITEM_LEVEL_MYTHIC, itemLevel, self.info.level));\n    end\n    GameTooltip_AddBlankLineToTooltip(GameTooltip);\n    if upgradeItemLevel then\n        GameTooltip_AddColoredLine(GameTooltip, string.format(WEEKLY_REWARDS_IMPROVE_ITEM_LEVEL, upgradeItemLevel), GREEN_FONT_COLOR);\n        if self.info.threshold == 1 then\n            if isHeroicLevel then\n                GameTooltip_AddHighlightLine(GameTooltip, WEEKLY_REWARDS_COMPLETE_HEROIC_SHORT);\n            else\n                GameTooltip_AddHighlightLine(GameTooltip, string.format(WEEKLY_REWARDS_COMPLETE_MYTHIC_SHORT, nextLevel));\n            end\n        else\n            GameTooltip_AddHighlightLine(GameTooltip, string.format(WEEKLY_REWARDS_COMPLETE_MYTHIC, nextLevel, self.info.threshold));\n        end\n    end\nend\n\naura_env.ShowPreviewItemTooltip = function(t, tframe, mythictt)\n    GameTooltip:SetOwner(tframe, \"ANCHOR_RIGHT\", -7, -11);\n    GameTooltip_SetTitle(GameTooltip, WEEKLY_REWARDS_CURRENT_REWARD);\n    local itemLink, upgradeItemLink = C_WeeklyRewards.GetExampleRewardItemHyperlinks(t.info.id);\n    local itemLevel, upgradeItemLevel;\n    if itemLink then\n        itemLevel = C_Item.GetDetailedItemLevelInfo(itemLink);\n    end\n    if upgradeItemLink then\n        upgradeItemLevel = C_Item.GetDetailedItemLevelInfo(upgradeItemLink);\n    end\n    \n    if not itemLevel then\n        GameTooltip_AddErrorLine(GameTooltip, RETRIEVING_ITEM_INFO);\n        t.UpdateTooltip = t.ShowPreviewItemTooltip;\n    else\n        t.UpdateTooltip = nil;\n        if t.info.type == Enum.WeeklyRewardChestThresholdType.Raid then\n            t:HandlePreviewRaidRewardTooltip(itemLevel, upgradeItemLevel);\n        elseif t.info.type == Enum.WeeklyRewardChestThresholdType.Activities then\n            local hasData, nextActivityTierID, nextLevel, nextItemLevel = C_WeeklyRewards.GetNextActivitiesIncrease(t.info.activityTierID, t.info.level);\n            if hasData then\n                upgradeItemLevel = nextItemLevel;\n            else\n                nextLevel = WeeklyRewardsUtil.GetNextMythicLevel(t.info.level);\n            end\n            aura_env.HandlePreviewMythicRewardTooltip(t,itemLevel, upgradeItemLevel, nextLevel)\n        elseif t.info.type == Enum.WeeklyRewardChestThresholdType.RankedPvP then\n            t:HandlePreviewPvPRewardTooltip(itemLevel, upgradeItemLevel);\n        end\n        if not upgradeItemLevel then\n            GameTooltip_AddColoredLine(GameTooltip, WEEKLY_REWARDS_MAXED_REWARD, GREEN_FONT_COLOR);\n        end\n    end\n    if mythictt then aura_env.AddTopRunsToTooltip(t); end\n    GameTooltip:Show();\nend\n\naura_env.getraiderioscore = function(fBtntxt)\n    local name = UnitName(\"player\")\n    local score=0\n    local returnvalue=\"\"\n    local scorecolor=\"\"\n    \n    if aura_env.config.showmythicplusscore ~= true or nukeit or C_PlayerInfo.GetPlayerMythicPlusRatingSummary(\"player\") == nil then return \"\" end\n    \n    score = C_PlayerInfo.GetPlayerMythicPlusRatingSummary(\"player\").currentSeasonScore\n    local color = C_ChallengeMode.GetDungeonScoreRarityColor(score) or HIGHLIGHT_FONT_COLOR\n    local red = color.r\n    local green = color.g\n    local blue = color.b\n    \n    scorecolor = format(\"|cff%.2x%.2x%.2x\", red*255,green*255,blue*255)\n    \n    if scorecolor ~= nil then\n        if string.len(CHALLENGE_COMPLETE_DUNGEON_SCORE) < 50 or fBtntxt == false then\n            returnvalue = format(CHALLENGE_COMPLETE_DUNGEON_SCORE, format(\"%s\\n\", scorecolor) .. score .. format(\"|r\\n\") )\n        else\n            returnvalue = (\"M+\" .. format(\"%s\\n\", scorecolor) .. score .. format(\"|r\\n\") )        \n        end\n    else\n        returnvalue = \"\"\n    end\n    \n    return returnvalue\nend\n\naura_env.initializescore = function()\n    -- initialize button spacing.\n    local spacing = 3\n    local Width = region:GetWidth()\n    local Height = region:GetHeight()\n    local xDistance = Width + spacing    \n    local xOffset = 0 + (xDistance ) * 0 -- only for single button setups\n    local yOffset = 20\n    local btn = _G[aura_env.id..\"Btn\"] or CreateFrame(\"Button\", aura_env.id..\"Btn\", region)\n    local textstring = aura_env.getraiderioscore(true) or \"\"\n    \n    -- Create the main button\n    btn:SetSize(Width, Height)\n    btn:SetPoint(\"BOTTOMLEFT\", CharacterHeadSlot, \"TOPLEFT\", xOffset, yOffset)\n    btn:SetFrameStrata(\"HIGH\")\n    if (UnitLevel(\"player\") < GetMaxLevelForLatestExpansion()) then\n        btn:Hide()\n    else\n        btn:Show()\n    end\n    \n    btn:SetScript(\"OnEnter\", function(self) \n            GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\", -7, -11);\n            GameTooltip_SetTitle(GameTooltip, format(CHALLENGE_COMPLETE_DUNGEON_SCORE, \"\"));\n            GameTooltip_AddNormalLine(GameTooltip, CLICK_HERE_FOR_MORE_INFO);                    \n            GameTooltip_AddNormalLine(GameTooltip, \" \");                    \n            GameTooltip_AddNormalLine(GameTooltip, \"To enable/disable the M+ side panel showing by default:\");                    \n            GameTooltip_AddNormalLine(GameTooltip, \"1) Go to Custom Options and find the Mythic+ Side Panel Options\");                                \n            GameTooltip_AddNormalLine(GameTooltip, \"2) Select/Deselect Show Mythic+ Score Side Panel\");                                \n            GameTooltip_AddNormalLine(GameTooltip, \"3) /reloadui\");                                            \n            GameTooltip:Show()\n    end)\n    btn:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)\n    \n    -- Create the background\n    local btn_bg = _G[\"ccsm_btn_tex1\"] or btn:CreateTexture(\"ccsm_btn_tex1\", \"BACKGROUND\", nil, 0)\n    \n    btn_bg:SetPoint(\"TOPLEFT\", btn, \"TOPLEFT\", 0, 0)\n    btn_bg:SetSize(225, 50)\n    btn_bg:SetTexture(\"Interface\\\\LFGFRAME\\\\UI-LFG-BlueBG.blp\")\n    btn_bg:Show()\n    \n    local btn_bgtex = _G[\"btn_bgtex\"] or btn:CreateTexture(\"btn_bgtex\", \"BACKGROUND\", nil, 1)\n    btn_bgtex:SetPoint(\"TOPLEFT\", btn, \"TOPLEFT\", 5, -5)\n    btn_bgtex:SetPoint(\"BOTTOMRIGHT\", btn, \"BOTTOMRIGHT\", -10, 5)\n    btn_bgtex:SetTexture(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n    btn_bgtex:SetGradient(\"Vertical\", CreateColor(0, 0, 0, 0), CreateColor(0.64, 0.21, 0.93, .2))\n    btn_bgtex:Show()\n    \n    -- Create the title text\n    local btnfont1 = _G[btn:GetName()..\"fs1\"] or btn:CreateFontString(btn:GetName()..\"fs1\")\n    btnfont1:SetPoint(\"LEFT\", btn, \"LEFT\", 0 ,0)\n    btnfont1:SetSize(150, 30)\n    btnfont1:SetFont(LSM:Fetch(\"font\", charsheet.subRegions[2].text_font), (c.fontsize_mplus or 11), textoptions)\n    \n    btnfont1:SetText(textstring)\n    btnfont1:SetJustifyH(\"CENTER\")\n    btnfont1:Show()\n    \n    btn:SetScript(\"OnClick\", function() \n            PlaySound(SOUNDKIT.GS_LOGIN_CHANGE_REALM_OK);\n            if not InCombatLockdown() then\n                if _G[\"ccsm_sf\"]:IsShown() then \n                    _G[\"ccsm_sf\"]:Hide()\n                else \n                    _G[\"ccsm_sf\"]:Show() \n                    if _G[\"CCSf\"] then _G[\"CCSf\"]:Hide() end\n                    if _G[\"ccs_sf\"] then _G[\"ccs_sf\"]:Hide() end\n                    if WeeklyRewardsFrame:IsVisible() then WeeklyRewardsFrame:Hide() end\n                end\n            else\n                RaidNotice_AddMessage(RaidBossEmoteFrame, format(\"%s\", ERR_AFFECTING_COMBAT), ChatTypeInfo[\"SYSTEM\"])\n            end\n    end)\n    \nend\n\naura_env.updatesideframe = function()\n    if InCombatLockdown() then C_Timer.After(5, function() aura_env.updatesideframe(); end) return end\n    \n    -- Update the Weekly Rewards Frames\n    WeeklyRewardsFrame:FullRefresh()\n    local tf = {WeeklyRewardsFrame:GetChildren()};\n    local x=1;\n    local x1=1;\n    local x2=1;\n    local tempstring=\"\"\n    \n    for _,t in ipairs(tf) do \n        if t and t.type and t.type == 1 and t.info then \n            -- This is the M+ rewards info\n            local progress = t.info.progress\n            \n            if C_WeeklyRewards.HasGeneratedRewards() and t.ItemFrame and t.ItemFrame.displayedItemDBID ~= nil then\n                local itemLink = C_WeeklyRewards.GetItemHyperlink(t.ItemFrame.displayedItemDBID)\n                local itemName, _, itemRarity, itemiLevel, _, _, _, _, _, _, _, _, _, _, _, _, _ = C_Item.GetItemInfo(itemLink)\n                \n                _G[\"ccms_r\"..x..\"_tex1\"]:Show()\n                _G[\"ccms_r\"..x..\"_tex2\"]:Hide()                    \n                _G[\"ccms_r\"..x..\"_tex3\"]:Show()                    \n                \n                _G[\"ccms_r\"..x..\"_tex4\"]:SetTexture(t.ItemFrame.Icon:GetTexture() or \"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n                _G[\"ccms_r\"..x..\"_tex4\"]:Show()                    \n                \n                _G[\"ccms_r\"..x..\"_fs1\"]:SetText(CreateColor(1, 1, 1, 1):WrapTextInColorCode(format(WEEKLY_REWARDS_THRESHOLD_DUNGEONS, t.info.threshold))) -- Top String\n                _G[\"ccms_r\"..x..\"_fs1\"]:Show()                    \n                \n                _G[\"ccms_r\"..x..\"_fs2\"]:Hide()                    \n                \n                _G[\"ccms_r\"..x..\"_fs3\"]:SetText(CreateColor(1, 1, 1, .4):WrapTextInColorCode(itemName or \"\")) -- ilvl stuff\n                _G[\"ccms_r\"..x..\"_fs3\"]:SetJustifyH(\"LEFT\")\n                _G[\"ccms_r\"..x..\"_fs3\"]:Show()                    \n                \n                _G[\"ccms_r\"..x..\"_fs4\"]:SetText(CreateColor(0.12, 1, 0, .4):WrapTextInColorCode(t.Progress:GetText() or \"\")) \n                _G[\"ccms_r\"..x..\"_fs4\"]:Show()                    \n                \n                _G[\"ccms_r\"..x]:SetScript(\"OnEnter\", function(self) GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\", -3, -6);\n                        GameTooltip:SetWeeklyReward(t.ItemFrame.displayedItemDBID); end)\n                _G[\"ccms_r\"..x]:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)                \n                \n            elseif progress >= t.info.threshold then \n                local _, _, itemQuality, itemLevel = C_Item.GetItemInfo(C_WeeklyRewards.GetExampleRewardItemHyperlinks(190+x) or \"\")\n                progress = t.info.threshold \n                _G[\"ccms_r\"..x..\"_tex1\"]:Show()\n                _G[\"ccms_r\"..x..\"_tex2\"]:Hide()  -- Key Icon\n                _G[\"ccms_r\"..x..\"_tex3\"]:Show()\n                _G[\"ccms_r\"..x..\"_tex4\"]:Hide()                                        \n                tempstring = format(\"%s/%s %s\", progress, t.info.threshold, COMPLETE)\n                _G[\"ccms_r\"..x..\"_fs4\"]:SetText(CreateColor(0.12, 1, 0, .4):WrapTextInColorCode(tempstring)) \n                _G[\"ccms_r\"..x..\"_fs3\"]:SetText(CreateColor(0.12, 1, 0, .4):WrapTextInColorCode(t.Progress:GetText() or \"\")) \n                _G[\"ccms_r\"..x..\"_fs3\"]:SetJustifyH(\"RIGHT\")                    \n                _G[\"ccms_r\"..x..\"_fs2\"]:SetText(CreateColor(1, 1, 1, 1):WrapTextInColorCode(itemLevel or \" \"))\n                _G[\"ccms_r\"..x..\"_fs2\"]:Show()\n                _G[\"ccms_r\"..x..\"_fs1\"]:SetText(CreateColor(1, 1, 1, 1):WrapTextInColorCode(format(WEEKLY_REWARDS_THRESHOLD_DUNGEONS, t.info.threshold)))\n                \n                _G[\"ccms_r\"..x]:SetScript(\"OnEnter\", function(self) aura_env.ShowPreviewItemTooltip(t, self, true) end)\n                _G[\"ccms_r\"..x]:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)                \n                \n            else\n                _G[\"ccms_r\"..x..\"_tex1\"]:Hide()\n                _G[\"ccms_r\"..x..\"_tex2\"]:Show()  -- Key Icon\n                _G[\"ccms_r\"..x..\"_tex3\"]:Hide()\n                _G[\"ccms_r\"..x..\"_tex4\"]:Hide()                                        \n                _G[\"ccms_r\"..x]:SetScript(\"OnEnter\", function(self) aura_env.ShowIncompleteMythicTooltip(t, self, true, false, false) end)\n                _G[\"ccms_r\"..x]:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)\n                _G[\"ccms_r\"..x..\"_fs3\"]:SetJustifyH(\"RIGHT\")                    \n                _G[\"ccms_r\"..x..\"_fs3\"]:SetText(CreateColor(0.62, 0.62, 0.62, .4):WrapTextInColorCode(\"\"))\n                tempstring = format(\"%s/%s %s\", progress, t.info.threshold, COMPLETE)\n                _G[\"ccms_r\"..x..\"_fs4\"]:SetText(CreateColor(0.62, 0.62, 0.62, .4):WrapTextInColorCode(tempstring)) \n            end\n            x=x+1;\n        elseif t and t.type and t.type == 6 and t.info then \n            local progress = t.info.progress\n            \n            if C_WeeklyRewards.HasGeneratedRewards() and t.ItemFrame and t.ItemFrame.displayedItemDBID ~= nil then\n                local itemLink = C_WeeklyRewards.GetItemHyperlink(t.ItemFrame.displayedItemDBID)\n                local itemName, _, itemRarity, itemiLevel, _, _, _, _, _, _, _, _, _, _, _, _, _ = C_Item.GetItemInfo(itemLink)\n                \n                _G[\"ccms_world\"..x2..\"_tex1\"]:Show()\n                _G[\"ccms_world\"..x2..\"_tex2\"]:Hide()                    \n                _G[\"ccms_world\"..x2..\"_tex3\"]:Show()                    \n                \n                _G[\"ccms_world\"..x2..\"_tex4\"]:SetTexture(t.ItemFrame.Icon:GetTexture() or \"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n                _G[\"ccms_world\"..x2..\"_tex4\"]:Show()                    \n                \n                _G[\"ccms_world\"..x2..\"_fs1\"]:SetText(CreateColor(1, 1, 1, 1):WrapTextInColorCode(format(WEEKLY_REWARDS_THRESHOLD_DUNGEONS, t.info.threshold))) -- Top String\n                _G[\"ccms_world\"..x2..\"_fs1\"]:Show()                    \n                \n                _G[\"ccms_world\"..x2..\"_fs2\"]:Hide()                    \n                \n                _G[\"ccms_world\"..x2..\"_fs3\"]:SetText(CreateColor(1, 1, 1, .4):WrapTextInColorCode(itemName or \"\")) -- ilvl stuff\n                _G[\"ccms_world\"..x2..\"_fs3\"]:SetJustifyH(\"LEFT\")\n                _G[\"ccms_world\"..x2..\"_fs3\"]:Show()                    \n                \n                _G[\"ccms_world\"..x2..\"_fs4\"]:SetText(CreateColor(0.12, 1, 0, .4):WrapTextInColorCode(t.Progress:GetText() or \"\")) \n                _G[\"ccms_world\"..x2..\"_fs4\"]:Show()                    \n                \n                _G[\"ccms_world\"..x2]:SetScript(\"OnEnter\", function(self) GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\", -3, -6);\n                        GameTooltip:SetWeeklyReward(t.ItemFrame.displayedItemDBID); end)\n                _G[\"ccms_world\"..x2]:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)                \n                \n            elseif progress >= t.info.threshold then \n                local _, _, itemQuality, itemLevel = C_Item.GetItemInfo(C_WeeklyRewards.GetExampleRewardItemHyperlinks(184+x2) or \"\")\n                progress = t.info.threshold \n                _G[\"ccms_world\"..x2..\"_tex1\"]:Show()\n                _G[\"ccms_world\"..x2..\"_tex2\"]:Hide()\n                _G[\"ccms_world\"..x2..\"_tex3\"]:Show()\n                _G[\"ccms_world\"..x2..\"_tex4\"]:Hide()                \n                tempstring = format(\"%s/%s %s\", progress, t.info.threshold, COMPLETE)\n                _G[\"ccms_world\"..x2..\"_fs4\"]:SetText(CreateColor(0.12, 1, 0, .4):WrapTextInColorCode(tempstring)) \n                _G[\"ccms_world\"..x2..\"_fs3\"]:SetJustifyH(\"RIGHT\")\n                _G[\"ccms_world\"..x2..\"_fs3\"]:SetText(CreateColor(0.12, 1, 0, .4):WrapTextInColorCode(t.Progress:GetText() or \"\")) \n                _G[\"ccms_world\"..x2..\"_fs2\"]:SetText(CreateColor(1, 1, 1, 1):WrapTextInColorCode(itemLevel or \" \"))\n                _G[\"ccms_world\"..x2..\"_fs2\"]:Show()\n                _G[\"ccms_world\"..x2..\"_fs1\"]:SetText(CreateColor(1, 1, 1, 1):WrapTextInColorCode(format(WEEKLY_REWARDS_THRESHOLD_WORLD, t.info.threshold)))\n                \n                _G[\"ccms_world\"..x2]:SetScript(\"OnEnter\", function(self) aura_env.ShowPreviewItemTooltip(t, self, false) end)\n                _G[\"ccms_world\"..x2]:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)                \n                \n            else\n                _G[\"ccms_world\"..x2..\"_tex1\"]:Hide()\n                _G[\"ccms_world\"..x2..\"_tex2\"]:Show()  -- Key Icon\n                _G[\"ccms_world\"..x2..\"_tex3\"]:Hide()\n                _G[\"ccms_world\"..x2..\"_tex4\"]:Hide() \n                _G[\"ccms_world\"..x2]:SetScript(\"OnEnter\", function(self) aura_env.ShowIncompleteMythicTooltip(t, self, false, true, false) end)\n                _G[\"ccms_world\"..x2]:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)\n                tempstring = format(\"%s/%s %s\", progress, t.info.threshold, COMPLETE)\n                _G[\"ccms_world\"..x2..\"_fs1\"]:SetText(CreateColor(0.62, 0.62, 0.62, .4):WrapTextInColorCode(format(WEEKLY_REWARDS_THRESHOLD_WORLD, t.info.threshold)))\n                _G[\"ccms_world\"..x2..\"_fs3\"]:SetJustifyH(\"RIGHT\")\n                _G[\"ccms_world\"..x2..\"_fs3\"]:SetText(CreateColor(0.62, 0.62, 0.62, .4):WrapTextInColorCode(\"\"))                \n                _G[\"ccms_world\"..x2..\"_fs4\"]:SetText(CreateColor(0.62, 0.62, 0.62, .4):WrapTextInColorCode(tempstring)) \n            end        \n            x2 = x2+1;\n        elseif t and t.type and t.type == 3 and t.info then\n            local progress = t.info.progress\n            \n            if C_WeeklyRewards.HasGeneratedRewards() and t.ItemFrame and t.ItemFrame.displayedItemDBID ~= nil then\n                local itemLink = C_WeeklyRewards.GetItemHyperlink(t.ItemFrame.displayedItemDBID)\n                local itemName, _, itemRarity, itemiLevel, _, _, _, _, _, _, _, _, _, _, _, _, _ = C_Item.GetItemInfo(itemLink)\n                \n                _G[\"ccms_raid\"..x1..\"_tex1\"]:Show()\n                _G[\"ccms_raid\"..x1..\"_tex2\"]:Hide()                    \n                _G[\"ccms_raid\"..x1..\"_tex3\"]:Show()                    \n                \n                _G[\"ccms_raid\"..x1..\"_tex4\"]:SetTexture(t.ItemFrame.Icon:GetTexture() or \"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n                _G[\"ccms_raid\"..x1..\"_tex4\"]:Show()                    \n                \n                _G[\"ccms_raid\"..x1..\"_fs1\"]:SetText(CreateColor(1, 1, 1, 1):WrapTextInColorCode(format(WEEKLY_REWARDS_THRESHOLD_DUNGEONS, t.info.threshold))) -- Top String\n                _G[\"ccms_raid\"..x1..\"_fs1\"]:Show()                    \n                \n                _G[\"ccms_raid\"..x1..\"_fs2\"]:Hide()                    \n                \n                _G[\"ccms_raid\"..x1..\"_fs3\"]:SetText(CreateColor(1, 1, 1, .4):WrapTextInColorCode(itemName or \"\")) -- ilvl stuff\n                _G[\"ccms_raid\"..x1..\"_fs3\"]:SetJustifyH(\"LEFT\")\n                _G[\"ccms_raid\"..x1..\"_fs3\"]:Show()                    \n                \n                _G[\"ccms_raid\"..x1..\"_fs4\"]:SetText(CreateColor(0.12, 1, 0, .4):WrapTextInColorCode(t.Progress:GetText() or \"\")) \n                _G[\"ccms_raid\"..x1..\"_fs4\"]:Show()                    \n                \n                _G[\"ccms_raid\"..x1]:SetScript(\"OnEnter\", function(self) GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\", -3, -6);\n                        GameTooltip:SetWeeklyReward(t.ItemFrame.displayedItemDBID); end)\n                _G[\"ccms_raid\"..x1]:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)                \n                \n            elseif progress >= t.info.threshold then \n                local _, _, itemQuality, itemLevel = C_Item.GetItemInfo(C_WeeklyRewards.GetExampleRewardItemHyperlinks(187+x1) or \"\")\n                progress = t.info.threshold \n                _G[\"ccms_raid\"..x1..\"_tex1\"]:Show()\n                _G[\"ccms_raid\"..x1..\"_tex2\"]:Hide()\n                _G[\"ccms_raid\"..x1..\"_tex3\"]:Show()\n                _G[\"ccms_raid\"..x1..\"_tex4\"]:Hide()                \n                tempstring = format(\"%s/%s %s\", progress, t.info.threshold, COMPLETE)\n                _G[\"ccms_raid\"..x1..\"_fs4\"]:SetText(CreateColor(0.12, 1, 0, .4):WrapTextInColorCode(tempstring)) \n                _G[\"ccms_raid\"..x1..\"_fs3\"]:SetText(CreateColor(0.12, 1, 0, .4):WrapTextInColorCode(t.Progress:GetText() or \"\")) \n                _G[\"ccms_raid\"..x1..\"_fs3\"]:SetJustifyH(\"RIGHT\")                \n                _G[\"ccms_raid\"..x1..\"_fs2\"]:SetText(CreateColor(1, 1, 1, 1):WrapTextInColorCode(itemLevel or \" \"))\n                _G[\"ccms_raid\"..x1..\"_fs2\"]:Show()\n                _G[\"ccms_raid\"..x1..\"_fs1\"]:SetText(CreateColor(1, 1, 1, 1):WrapTextInColorCode(format(t.info.raidString, t.info.threshold)))\n                \n                _G[\"ccms_raid\"..x1]:SetScript(\"OnEnter\", function(self) aura_env.ShowPreviewItemTooltip(t, self, false) end)\n                _G[\"ccms_raid\"..x1]:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)                \n                \n            else\n                _G[\"ccms_raid\"..x1..\"_tex1\"]:Hide()\n                _G[\"ccms_raid\"..x1..\"_tex2\"]:Show()  -- Key Icon\n                _G[\"ccms_raid\"..x1..\"_tex3\"]:Hide()\n                _G[\"ccms_raid\"..x1..\"_tex4\"]:Hide() \n                _G[\"ccms_raid\"..x1]:SetScript(\"OnEnter\", function(self) aura_env.ShowIncompleteMythicTooltip(t, self, false, false) end)\n                _G[\"ccms_raid\"..x1]:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)\n                tempstring = format(\"%s/%s %s\", progress, t.info.threshold, COMPLETE)\n                _G[\"ccms_raid\"..x1..\"_fs1\"]:SetText(CreateColor(0.62, 0.62, 0.62, .4):WrapTextInColorCode(format(t.info.raidString, t.info.threshold)))\n                _G[\"ccms_raid\"..x1..\"_fs3\"]:SetJustifyH(\"RIGHT\")                                \n                _G[\"ccms_raid\"..x1..\"_fs3\"]:SetText(CreateColor(0.62, 0.62, 0.62, .4):WrapTextInColorCode(\"\"))                                \n                _G[\"ccms_raid\"..x1..\"_fs4\"]:SetText(CreateColor(0.62, 0.62, 0.62, .4):WrapTextInColorCode(tempstring)) \n            end        \n            x1 = x1+1;\n        end \n    end\n    -- Update the Mythic Plus portion\n    if C_MythicPlus.GetCurrentAffixes() == nil or \n    C_MythicPlus.GetCurrentAffixes()[1] == nil or \n    C_MythicPlus.GetCurrentAffixes()[2] == nil or \n    C_MythicPlus.GetCurrentAffixes()[3] == nil then return end \n    \n    _G[\"ccsm_sf\"]:SetScale(c.mplus_sp_scale)\n    \n    if C_WeeklyRewards.HasAvailableRewards() then _G[\"ccsm_fs4\"]:Show() else _G[\"ccsm_fs4\"]:Hide() end\n    \n    local ccsm_fs1 = _G[\"ccsm_fs1\"]\n    if C_MythicPlus.GetOwnedKeystoneLevel() and C_MythicPlus.GetOwnedKeystoneChallengeMapID() then\n        local mapName, _, MaptimeLimit, MapTexture = C_ChallengeMode.GetMapUIInfo(C_MythicPlus.GetOwnedKeystoneChallengeMapID())\n        tempstring = \"(\"..C_MythicPlus.GetOwnedKeystoneLevel()..\") \"..mapName\n    else \n        tempstring = ADDON_MISSING\n    end\n    ccsm_fs1:SetText(\"|cFFFFFC33\"..ITEM_UPGRADE_CURRENT..\"|r \"..tempstring)\n    if C_MythicPlus.GetCurrentAffixes() then\n        if C_MythicPlus.GetCurrentAffixes()[1] then\n            -- Affix 1\n            local aff1_name, aff1_desc, aff1_id = C_ChallengeMode.GetAffixInfo(C_MythicPlus.GetCurrentAffixes()[1].id)\n            \n            ccsm_aff1_btn:SetScript(\"OnEnter\", function(self) GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\", -7, -11);\n                    GameTooltip:SetText(aff1_name, 1, 1, 1, 1);\n                    GameTooltip:AddLine(aff1_desc, nil, nil, nil, 1) \n                    GameTooltip:Show()\n            end)\n            ccsm_aff1_btn:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)\n            ccsm_aff1_tex:SetTexture(aff1_id or \"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n            ccsm_aff1_fs1:Show()\n            ccsm_aff1_btn:Show()\n        end\n        -- Affix 2\n        if C_MythicPlus.GetCurrentAffixes()[2] then\n            local aff2_name, aff2_desc, aff2_id = C_ChallengeMode.GetAffixInfo(C_MythicPlus.GetCurrentAffixes()[2].id)\n            \n            ccsm_aff2_btn:SetScript(\"OnEnter\", function(self) GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\", -7, -11);\n                    GameTooltip:SetText(aff2_name, 1, 1, 1, 1);\n                    GameTooltip:AddLine(aff2_desc, nil, nil, nil, 1) \n                    GameTooltip:Show()\n            end)\n            ccsm_aff2_btn:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)\n            ccsm_aff2_tex:SetTexture(aff2_id or \"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n            ccsm_aff2_fs1:Show()\n            ccsm_aff2_btn:Show()\n        end\n        if C_MythicPlus.GetCurrentAffixes()[3] then\n            -- Affix 3\n            local aff3_name, aff3_desc, aff3_id = C_ChallengeMode.GetAffixInfo(C_MythicPlus.GetCurrentAffixes()[3].id)\n            \n            ccsm_aff3_btn:SetScript(\"OnEnter\", function(self) GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\", -7, -11);\n                    GameTooltip:SetText(aff3_name, 1, 1, 1, 1);\n                    GameTooltip:AddLine(aff3_desc, nil, nil, nil, 1) \n                    GameTooltip:Show()\n            end)\n            ccsm_aff3_btn:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)\n            ccsm_aff3_tex:SetTexture(aff3_id or \"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n            ccsm_aff3_fs1:Show()\n            ccsm_aff3_btn:Show()\n        end\n        if C_MythicPlus.GetCurrentAffixes()[4] then\n            -- Affix 4\n            local aff4_name, aff4_desc, aff4_id = C_ChallengeMode.GetAffixInfo(C_MythicPlus.GetCurrentAffixes()[4].id)\n            \n            ccsm_aff4_btn:SetScript(\"OnEnter\", function(self) GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\", -7, -11);\n                    GameTooltip:SetText(aff4_name, 1, 1, 1, 1);\n                    GameTooltip:AddLine(aff4_desc, nil, nil, nil, 1) \n                    GameTooltip:Show()\n            end)\n            ccsm_aff4_btn:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)\n            ccsm_aff4_tex:SetTexture(aff4_id or \"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n            ccsm_aff4_fs1:Show()\n            ccsm_aff4_btn:Show()\n        end\n        if C_MythicPlus.GetCurrentAffixes()[5] then\n            -- Affix 5\n            local aff5_name, aff5_desc, aff5_id = C_ChallengeMode.GetAffixInfo(C_MythicPlus.GetCurrentAffixes()[5].id)\n            \n            ccsm_aff5_btn:SetScript(\"OnEnter\", function(self) GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\", -7, -11);\n                    GameTooltip:SetText(aff5_name, 1, 1, 1, 1);\n                    GameTooltip:AddLine(aff5_desc, nil, nil, nil, 1) \n                    GameTooltip:Show()\n            end)\n            ccsm_aff5_btn:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)\n            ccsm_aff5_tex:SetTexture(aff5_id or \"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n            ccsm_aff5_fs1:Show()\n            ccsm_aff5_btn:Show()\n        end        \n    end\n    \n    local ccsm_fs2 = _G[\"ccsm_fs2\"]\n    ccsm_fs2:SetText(aura_env.getraiderioscore(false))\n    \n    local ccsm_fs3 = _G[\"ccsm_fs3\"]\n    local t20s, t15s, t10s, t7s, t5s, t2s = aura_env.RunProgression()\n    tempstring = \"\"\n    if t20s > 0 then tempstring = tempstring..string.format(\"%-6.6s%-10.10s: %5.5s\\n\", \"(20+) \",COMPLETE, t20s) end\n    if t15s > 0 then tempstring = tempstring..string.format(\"%-6.6s%-10.10s: %5.5s\\n\", \"(15+) \",COMPLETE, t15s) end\n    if t10s > 0 then tempstring = tempstring..string.format(\"%-6.6s%-10.10s: %5.5s\\n\", \"(10+) \",COMPLETE, t10s) end\n    if t7s > 0 then tempstring = tempstring..string.format(\"%-6.6s%-10.10s: %5.5s\\n\", \"(7+) \",COMPLETE, t7s) end\n    if t5s > 0 then tempstring = tempstring..string.format(\"%-6.6s%-10.10s: %5.5s\\n\", \"(5+) \",COMPLETE, t5s) end\n    if t2s > 0 then tempstring = tempstring..string.format(\"%-6.6s%-10.10s: %5.5s\\n\", \"(2+) \",COMPLETE, t2s) end\n    ccsm_fs3:SetText(tempstring)\n    \n    for x=1,8 do \n        \n        local ccsm_bx = _G[\"ccsm_b\"..x] or CreateFrame(\"Frame\", \"ccsm_b\"..x, _G[\"ccsm_sf\"]);\n        local mapID = C_ChallengeMode.GetMapTable()[x] or 0\n        local mapspellID = 0\n        local mapName, _, MaptimeLimit, MapTexture = C_ChallengeMode.GetMapUIInfo(mapID)\n        local MapTable, MapScore = C_MythicPlus.GetSeasonBestAffixScoreInfoForMap(mapID);\n        local ccsm_bx_btn1 = _G[\"ccsm_b\"..x..\"_btn1\"]\n        local ccsm_bx_btn2 = _G[\"ccsm_b\"..x..\"_btn2\"]\n        local ccsm_bx_tex1 = _G[\"ccsm_b\"..x..\"_tex1\"]\n        local ccsm_bx_tex2 = _G[\"ccsm_b\"..x..\"_tex2\"]\n        local ccsm_bx_fs1 = _G[\"ccsm_b\"..x..\"_fs1\"]\n        local ccsm_bx_fs2 = _G[\"ccsm_b\"..x..\"_fs2\"]\n        local ccsm_bx_fs3 = _G[\"ccsm_b\"..x..\"_fs3\"]\n        local ccsm_bx_fs4 = _G[\"ccsm_b\"..x..\"_fs4\"]\n        local ccsm_bx_fs7 = _G[\"ccsm_b\"..x..\"_fs7\"]\n        local ccsm_bx_btn1_bg = _G[\"ccsm_b\"..x..\"_btn1_bg\"] or ccsm_bx_btn1:CreateTexture(\"ccsm_b\"..x..\"_btn1_bg\", \"BACKGROUND\", nil)\n        local ccsm_bx_btn2_bg = _G[\"ccsm_b\"..x..\"_btn2_bg\"]\n        \n        \n        ccsm_bx_tex2:SetTexture(MapTexture or 5221804)\n        ccsm_bx_fs2:SetText(mapName or \" \");\n        ccsm_bx_btn2_bg:SetTexture(MapTexture or \"Interface\\\\CovenantRenown\\\\DragonflightMajorFactionsNiffen.BLP\")\n        ccsm_bx_btn2_bg:SetTexCoord(0, 1, 0, 1)\n        ccsm_bx_btn2_bg:SetAlpha(1)\n        \n        if ccsm_bx_btn2 then\n            ccsm_bx_btn2:SetScript(\"OnEnter\", function(self) GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\", -7, -11);\n                    GameTooltip:AddDoubleLine(GARRISON_TROPHY_LOCKED_SUBTEXT, \"\", 1, 1, 1, 1, 1, 1) \n                    GameTooltip:Show()\n            end)\n            ccsm_bx_btn2:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)\n            ccsm_bx_btn1:Hide()\n        end\n        if mapID and mapID == 353 then -- Fix because blizzard...\n            if UnitFactionGroup(\"player\") == \"Horde\" then\n                mapspellID =464256\n            else\n                mapspellID =445418\n            end\n        elseif mapID and mapID == 247 then -- Fix because blizzard...\n            mapspellID =467553\n            if IsSpellKnown(467553) then mapspellID =467553 end\n            if IsSpellKnown(467555) then mapspellID =467555 end\n        elseif aura_env.Dungeon_Teleports[mapID] and aura_env.Dungeon_Teleports[mapID].spellID and aura_env.Dungeon_Teleports[mapID].spellID ~= 0 then\n            mapspellID = aura_env.Dungeon_Teleports[mapID].spellID\n        end\n        \n        ccsm_bx_btn1:Show()\n        \n        if mapspellID ~= 0 and IsSpellKnown(mapspellID) then\n            local SpellLink = C_Spell.GetSpellLink(mapspellID)\n            local ccsm_bx_btn2_fs = _G[\"ccsm_b\"..x..\"_btn2_fs\"]\n            local spellCooldownInfo = C_Spell.GetSpellCooldown(mapspellID)\n            local start = spellCooldownInfo.startTime or 0\n            local duration = spellCooldownInfo.duration or 0\n            local enabled = spellCooldownInfo.isEnabled or 0\n            local modRate = spellCooldownInfo.modRate or 0\n            \n            if ccsm_bx_btn2 then\n                ccsm_bx_btn2:SetScript(\"OnEnter\", function(self) GameTooltip:SetOwner(self, \"ANCHOR_RIGHT\", -7, -11);\n                        if SpellLink then\n                            GameTooltip:SetHyperlink(SpellLink)\n                        else\n                            GameTooltip:AddDoubleLine(GARRISON_TROPHY_LOCKED_SUBTEXT, \"\", 1, 1, 1, 1, 1, 1) \n                        end\n                        GameTooltip:Show()\n                end)\n                ccsm_bx_btn2:SetScript(\"OnLeave\", function() GameTooltip:Hide() end)\n                ccsm_bx_btn2:SetAttribute(\"spell\", mapspellID)\n                ccsm_bx_btn2_fs:SetText(\"\")\n                ccsm_bx_btn2:SetScript(\"OnUpdate\", nil)                    \n                if duration > 0 and start > 0 then\n                    ccsm_bx_btn2:SetScript(\"OnUpdate\", function(self) \n                            local spellCooldownInfo = C_Spell.GetSpellCooldown(mapspellID)\n                            local start = spellCooldownInfo.startTime or 0\n                            local duration = spellCooldownInfo.duration or 0\n                            \n                            if duration > 0 and start > 0 then\n                                ccsm_bx_btn2_fs:SetText(aura_env.display_time(start+duration - GetTime(), true))\n                                --  print(\"b\",x, \" \", aura_env.Dungeon_Teleports[mapID].spellID, \" \", GetSpellCooldown(spellID))\n                            else\n                                ccsm_bx_btn2_fs:SetText(\"\")  \n                                ccsm_bx_btn2:SetScript(\"OnUpdate\", nil)\n                            end\n                    end)\n                else\n                    ccsm_bx_btn2_fs:SetText(\"\")  \n                    ccsm_bx_btn2:SetScript(\"OnUpdate\", nil)\n                end\n                \n            end\n            \n            ccsm_bx_btn1_bg:SetTexture(MapTexture or \"Interface\\\\CovenantRenown\\\\DragonflightMajorFactionsNiffen.BLP\")\n            ccsm_bx_btn1_bg:SetTexCoord(0, 1, 0, 1)\n            ccsm_bx_btn1_bg:SetAlpha(1)\n            ccsm_bx_btn1_bg:SetAllPoints(ccsm_bx_btn2_bg)\n            ccsm_bx_btn1_bg:Show()\n            ccsm_bx_btn2_bg:Hide()\n        end        \n        \n        if MapTable ~= nil and MapScore ~= nil then\n            --local MapFort = MapTable[aura_env.GetSeasonBestForDungeon(mapID) or 1]\n            local MapFort = TableUtil.FindMax(MapTable, function(MapTable) return MapTable.score; end) or MapTable[1];\n            local color = C_ChallengeMode.GetSpecificDungeonOverallScoreRarityColor(MapScore) or HIGHLIGHT_FONT_COLOR\n            local red = color.r\n            local green = color.g\n            local blue = color.b\n            local scorecolor = format(\"|cff%.2x%.2x%.2x\", red*255,green*255,blue*255)\n            \n            ccsm_bx_fs1:SetText(format(\"%s\", scorecolor) .. MapScore or \" \" .. format(\"|r\\n\"))\n            \n            --== Fortified Score and Color\n            \n            ccsm_bx_fs3:SetText(aura_env.stars(MapFort and MapFort.durationSec or 0, MaptimeLimit).. (MapFort and MapFort.level or \"0\"));\n            \n            color = C_ChallengeMode.GetSpecificDungeonOverallScoreRarityColor(MapScore) or HIGHLIGHT_FONT_COLOR\n            red = color.r\n            green = color.g\n            blue = color.b\n            scorecolor = format(\"|cff%.2x%.2x%.2x\", red*255,green*255,blue*255)\n            \n            ccsm_bx_fs4:SetText(format(\"%s\", scorecolor) .. format(\"%.f\", MapScore).. format(\"|r\\n\"))\n            \n            if c.showm_overundertime then\n                if (MapFort and MapFort.durationSec or 0) == 0 then\n                    ccsm_bx_fs7:SetText(\"     -\")\n                elseif (MapFort and MapFort.durationSec or 0) - MaptimeLimit < 0 then\n                    ccsm_bx_fs7:SetText(aura_env.display_time(MapFort and MapFort.durationSec or 0, false)..\"  \"..\"(|cFF00AA00-\"..aura_env.display_time((MapFort and MapFort.durationSec or 0) - MaptimeLimit, false)..\"|r)\\n\");            \n                else\n                    ccsm_bx_fs7:SetText(aura_env.display_time(MapFort.durationSec, false)..\"  \"..\"(|cFFAA0000+\"..aura_env.display_time((MapFort and MapFort.durationSec or 0) - MaptimeLimit, false)..\"|r)\\n\");            \n                end\n            else\n                ccsm_bx_fs7:SetText(aura_env.display_time(MapFort and MapFort.durationSec or 0, false)..\"\\n\");            \n            end\n        else\n            ccsm_bx_fs1:SetText(\"-\")\n            ccsm_bx_fs3:SetText(\"-\")\n            ccsm_bx_fs4:SetText(\"-\")\n            ccsm_bx_fs7:SetText(\"     -\")\n        end \n    end\nend\n\naura_env.initializeframes = function()\n    local bgr, bgg, bgb, bgalpha = c.ccsmbgcolor[1], c.ccsmbgcolor[2], c.ccsmbgcolor[3], c.ccsmbgcolor[4];\n    \n    if not _G[\"ccsm_sf\"] then \n        -- Create the basic side frame\n        local ccsm_af = _G[\"ccsm_af\"] or CreateFrame(\"Frame\", \"ccsm_af\", CharacterFrame, \"SecureHandlerBaseTemplate\");\n        local ccsm_sf = _G[\"ccsm_sf\"] or CreateFrame(\"Frame\", \"ccsm_sf\", CharacterFrame, \"SecureHandlerBaseTemplate\");\n        local sf_bg = _G[\"ccsm_sf_bg\"] or ccsm_sf:CreateTexture(\"ccsm_sf_bg\", \"BACKGROUND\", nil, 1)        \n        local sf_topbar = _G[\"ccsm_sf_tb\"] or ccsm_sf:CreateTexture(\"ccsm_sf_tb\", \"BACKGROUND\", nil, 2)\n        local sf_topstreaks = _G[\"ccsm_sf_ts\"] or ccsm_sf:CreateTexture(\"ccsm_sf_ts\", \"BACKGROUND\", nil, 2)\n        local sf_bottombar = _G[\"ccsm_sf_bb\"] or ccsm_sf:CreateTexture(\"ccsm_sf_bb\", \"BACKGROUND\", nil, 2)\n        \n        ccsm_af:ClearAllPoints()\n        ccsm_af:SetPoint(\"TOPLEFT\", CharacterFrame, \"TOPRIGHT\", 60+charsheet.config.hpad, 0);\n        ccsm_af:SetPoint(\"BOTTOMLEFT\", CharacterFrame, \"BOTTOMRIGHT\", 60+charsheet.config.hpad, 0);\n        ccsm_sf:SetSize(1, 1)\n        \n        ccsm_sf:ClearAllPoints()\n        ccsm_sf:SetPoint(\"TOPLEFT\", ccsm_af, \"TOPRIGHT\", 0, 0); \n        ccsm_sf:SetPoint(\"BOTTOMLEFT\", ccsm_af, \"BOTTOMRIGHT\", 0, 0); \n        ccsm_sf:SetSize(660, 640)\n        ccsm_sf.throttle = 0;\n        \n        if c.showm_sp and (UnitLevel(\"player\") == GetMaxLevelForLatestExpansion()) and (C_MythicPlus.GetCurrentAffixes() and C_MythicPlus.GetCurrentAffixes()[1]) then\n            ccsm_sf:Show()\n        else\n            ccsm_sf:Hide()\n        end\n        \n        sf_bg:ClearAllPoints()\n        sf_bg:SetAllPoints()\n        sf_bg:SetTexture(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n        sf_bg:SetColorTexture(bgr,bgg,bgb,bgalpha)\n        \n        sf_topbar:ClearAllPoints()\n        sf_topbar:SetPoint(\"TOPLEFT\", ccsm_sf, \"TOPLEFT\")\n        sf_topbar:SetPoint(\"TOPRIGHT\", ccsm_sf, \"TOPRIGHT\")\n        sf_topbar:SetHeight(16)\n        sf_topbar:SetTexture(\"1723833\")\n        sf_topbar:SetTexCoord(0, 1, 0.586, .734)\n        \n        sf_topstreaks:ClearAllPoints()\n        sf_topstreaks:SetPoint(\"TOPLEFT\", sf_topbar, \"BOTTOMLEFT\")\n        sf_topstreaks:SetPoint(\"TOPRIGHT\", sf_topbar, \"BOTTOMRIGHT\")\n        sf_topstreaks:SetHeight(43)\n        sf_topstreaks:SetTexture(\"1723833\")\n        sf_topstreaks:SetTexCoord(0, 1, 0, .328)\n        \n        sf_bottombar:ClearAllPoints()\n        sf_bottombar:SetPoint(\"BOTTOMLEFT\", ccsm_sf, \"BOTTOMLEFT\")\n        sf_bottombar:SetPoint(\"BOTTOMRIGHT\", ccsm_sf, \"BOTTOMRIGHT\")\n        \n        local rewardcount = 1\n        \n        if c.showm_worldrewards then rewardcount = rewardcount+1 end\n        if c.showm_raidrewards then rewardcount = rewardcount+1 end\n        \n        sf_bottombar:SetHeight(85*rewardcount)\n        sf_bottombar:SetTexture(\"4556093\")\n        sf_bottombar:SetTexCoord(0, .75, 0, .082) \n        \n        -- Create the Header fields\n        local ccsm_fs1 = _G[\"ccsm_fs1\"] or  ccsm_sf:CreateFontString(\"ccsm_fs1\")\n        local tempstring = \"\"\n        \n        ccsm_fs1:SetPoint(\"TOPLEFT\", sf_topbar, \"BOTTOMLEFT\", 10 ,-4);\n        ccsm_fs1:SetFont(WA_Font, (c.fontsize or 11), textoptions);\n        ccsm_fs1:SetJustifyH(\"LEFT\")\n        ccsm_fs1:SetText(\"\")\n        ccsm_fs1:Show()\n        \n        local ccsm_aff1_btn = _G[\"ccsm_aff1_btn\"] or CreateFrame(\"Button\", \"ccsm_aff1_btn\", ccsm_sf)\n        ccsm_aff1_btn:SetPoint(\"TOPLEFT\", sf_topbar, \"TOPLEFT\", 10, -45)\n        ccsm_aff1_btn:SetSize(32, 32)\n        ccsm_aff1_btn:SetFrameStrata(\"DIALOG\")\n        ccsm_aff1_btn:Hide()\n        \n        local ccsm_fs4 = _G[\"ccsm_fs4\"] or ccsm_aff1_btn:CreateFontString(\"ccsm_fs4\")\n        ccsm_fs4:SetPoint(\"TOP\", sf_bottombar, \"TOP\", 0, 0);\n        ccsm_fs4:SetFont(WA_Font, (c.fontsize or 11)*1.5, textoptions);\n        ccsm_fs4:SetJustifyH(\"CENTER\")\n        ccsm_fs4:SetText(\"|cFFFFFF00\" .. WEEKLY_REWARDS_RETURN_TO_CLAIM .. \"|r\")\n        ccsm_fs4:Show()               \n        \n        local ccsm_aff1_fs1 = _G[\"ccsm_aff1_fs1\"] or  ccsm_aff1_btn:CreateFontString(\"ccsm_aff1_fs1\")\n        ccsm_aff1_fs1:SetPoint(\"TOP\", ccsm_aff1_btn, \"BOTTOM\", 0, -3)\n        ccsm_aff1_fs1:SetFont(LSM:Fetch(\"font\", charsheet.subRegions[2].text_font), (c.fontsize_mplus or 11), textoptions)\n        ccsm_aff1_fs1:SetText(\"4\")\n        ccsm_aff1_fs1:Hide()       \n        \n        local ccsm_aff1_tex = _G[\"ccsm_aff1_tex\"] or ccsm_aff1_btn:CreateTexture(\"ccsm_aff1_tex\", \"BACKGROUND\", nil)\n        ccsm_aff1_tex:SetAllPoints()\n        ccsm_aff1_tex:SetSize(32, 32)\n        ccsm_aff1_tex:SetTexture(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n        ccsm_aff1_tex:Show()\n        \n        local ccsm_aff2_btn = _G[\"ccsm_aff2_btn\"] or CreateFrame(\"Button\", \"ccsm_aff2_btn\",  ccsm_sf)\n        ccsm_aff2_btn:SetPoint(\"LEFT\", ccsm_aff1_btn, \"RIGHT\", 10, 0)\n        ccsm_aff2_btn:SetSize(32, 32)\n        ccsm_aff2_btn:Hide()\n        \n        local ccsm_aff2_fs1 = _G[\"ccsm_aff2_fs1\"] or  ccsm_aff2_btn:CreateFontString(\"ccsm_aff2_fs1\")\n        ccsm_aff2_fs1:SetPoint(\"TOP\", ccsm_aff2_btn, \"BOTTOM\", 0, -3)\n        ccsm_aff2_fs1:SetFont(LSM:Fetch(\"font\", charsheet.subRegions[2].text_font), (c.fontsize_mplus or 11), textoptions)\n        ccsm_aff2_fs1:SetText(\"7\")\n        ccsm_aff2_fs1:Hide()       \n        \n        local ccsm_aff2_tex = _G[\"ccsm_aff2_tex\"] or ccsm_aff2_btn:CreateTexture(\"ccsm_aff2_tex\", \"BACKGROUND\", nil)\n        ccsm_aff2_tex:SetAllPoints()\n        ccsm_aff2_tex:SetSize(32, 32)\n        ccsm_aff2_tex:SetTexture(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n        ccsm_aff2_tex:Show()\n        \n        local ccsm_aff3_btn = _G[\"ccsm_aff3_btn\"] or CreateFrame(\"Button\", \"ccsm_aff3_btn\",  ccsm_sf)\n        ccsm_aff3_btn:SetPoint(\"LEFT\", ccsm_aff2_btn, \"RIGHT\", 10, 0)\n        ccsm_aff3_btn:SetSize(32, 32)\n        ccsm_aff3_btn:Hide()\n        \n        local ccsm_aff3_fs1 = _G[\"ccsm_aff3_fs1\"] or  ccsm_aff3_btn:CreateFontString(\"ccsm_aff3_fs1\")\n        ccsm_aff3_fs1:SetPoint(\"TOP\", ccsm_aff3_btn, \"BOTTOM\", 0, -3)\n        ccsm_aff3_fs1:SetFont(LSM:Fetch(\"font\", charsheet.subRegions[2].text_font), (c.fontsize_mplus or 11), textoptions)\n        ccsm_aff3_fs1:SetText(\"10\")\n        ccsm_aff3_fs1:Hide()   \n        \n        local ccsm_aff3_tex = _G[\"ccsm_aff3_tex\"] or ccsm_aff3_btn:CreateTexture(\"ccsm_aff3_tex\", \"BACKGROUND\", nil)\n        ccsm_aff3_tex:SetAllPoints()\n        ccsm_aff3_tex:SetSize(32, 32)\n        ccsm_aff3_tex:SetTexture(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n        ccsm_aff3_tex:Show()\n        \n        local ccsm_aff4_btn = _G[\"ccsm_aff4_btn\"] or CreateFrame(\"Button\", \"ccsm_aff4_btn\",  ccsm_sf)\n        ccsm_aff4_btn:SetPoint(\"LEFT\", ccsm_aff3_btn, \"RIGHT\", 10, 0)\n        ccsm_aff4_btn:SetSize(32, 32)\n        ccsm_aff4_btn:Hide()\n        \n        local ccsm_aff4_fs1 = _G[\"ccsm_aff4_fs1\"] or  ccsm_aff4_btn:CreateFontString(\"ccsm_aff4_fs1\")\n        ccsm_aff4_fs1:SetPoint(\"TOP\", ccsm_aff4_btn, \"BOTTOM\", 0, -3)\n        ccsm_aff4_fs1:SetFont(LSM:Fetch(\"font\", charsheet.subRegions[2].text_font), (c.fontsize_mplus or 11), textoptions)\n        ccsm_aff4_fs1:SetText(\"12\")\n        ccsm_aff4_fs1:Hide()   \n        \n        local ccsm_aff4_tex = _G[\"ccsm_aff4_tex\"] or ccsm_aff4_btn:CreateTexture(\"ccsm_aff4_tex\", \"BACKGROUND\", nil)\n        ccsm_aff4_tex:SetAllPoints()\n        ccsm_aff4_tex:SetSize(32, 32)\n        ccsm_aff4_tex:SetTexture(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n        ccsm_aff4_tex:Show()\n        \n        local ccsm_aff5_btn = _G[\"ccsm_aff5_btn\"] or CreateFrame(\"Button\", \"ccsm_aff5_btn\",  ccsm_sf)\n        ccsm_aff5_btn:SetPoint(\"LEFT\", ccsm_aff4_btn, \"RIGHT\", 10, 0)\n        ccsm_aff5_btn:SetSize(32, 32)\n        ccsm_aff5_btn:Hide()\n        \n        local ccsm_aff5_fs1 = _G[\"ccsm_aff5_fs1\"] or  ccsm_aff5_btn:CreateFontString(\"ccsm_aff5_fs1\")\n        ccsm_aff5_fs1:SetPoint(\"TOP\", ccsm_aff5_btn, \"BOTTOM\", 0, -3)\n        ccsm_aff5_fs1:SetFont(LSM:Fetch(\"font\", charsheet.subRegions[2].text_font), (c.fontsize_mplus or 11), textoptions)\n        ccsm_aff5_fs1:SetText(\"15\")\n        ccsm_aff5_fs1:Hide()   \n        \n        local ccsm_aff5_tex = _G[\"ccsm_aff5_tex\"] or ccsm_aff5_btn:CreateTexture(\"ccsm_aff5_tex\", \"BACKGROUND\", nil)\n        ccsm_aff5_tex:SetAllPoints()\n        ccsm_aff5_tex:SetSize(32, 32)\n        ccsm_aff5_tex:SetTexture(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n        ccsm_aff5_tex:Show()\n        \n        local ccsm_fs2 = _G[\"ccsm_fs2\"] or  ccsm_sf:CreateFontString(\"ccsm_fs2\")\n        ccsm_fs2:SetPoint(\"TOP\", sf_topbar, \"BOTTOM\", 0, -35);\n        ccsm_fs2:SetFont(WA_Font, (c.fontsize or 16), textoptions);\n        ccsm_fs2:SetJustifyH(\"CENTER\")\n        ccsm_fs2:SetText(aura_env.getraiderioscore(false))\n        ccsm_fs2:Show()        \n        \n        local ccsm_fs3 = _G[\"ccsm_fs3\"] or  ccsm_sf:CreateFontString(\"ccsm_fs3\")\n        ccsm_fs3:SetPoint(\"TOPRIGHT\", sf_topbar, \"BOTTOMRIGHT\", -10, -4);\n        ccsm_fs3:SetFont(WA_Font, (c.fontsize or 12), textoptions);\n        ccsm_fs3:SetJustifyH(\"RIGHT\")\n        ccsm_fs3:SetText(\"\")\n        ccsm_fs3:Show()       \n        \n        -- Create the Footer fields\n        --=== world Rewards Frame 1  \n        local ccms_world1 = _G[\"ccms_world1\"] or CreateFrame(\"Frame\", \"ccms_world1\", _G[\"ccsm_sf\"] )\n        ccms_world1:SetPoint(\"BOTTOMLEFT\", ccsm_sf, \"BOTTOMLEFT\",28 ,3);\n        ccms_world1:SetSize(200, 75)\n        ccms_world1:SetFrameStrata(\"HIGH\")\n        ccms_world1:SetFrameLevel(10)\n        if c.showm_worldrewards then ccms_world1:Show() else ccms_world1:Hide() end\n        \n        local ccms_world1_bg = _G[\"ccms_world1_bg\"] or ccms_world1:CreateTexture(\"ccms_world1_bg\", \"BACKGROUND\", nil, 0)\n        ccms_world1_bg:SetPoint(\"TOPLEFT\", ccms_world1, \"TOPLEFT\", 0, 0)\n        ccms_world1_bg:SetSize(300, 107)\n        ccms_world1_bg:SetTexture(\"Interface\\\\LFGFRAME\\\\UI-LFG-BlueBG.blp\")\n        ccms_world1_bg:Show()\n        \n        local ccms_world1_bgtex = _G[\"ccms_world1_bgtex\"] or ccms_world1:CreateTexture(\"ccms_world1_bgtex\", \"BACKGROUND\", nil, 1)\n        ccms_world1_bgtex:SetPoint(\"TOPLEFT\", ccms_world1, \"TOPLEFT\", 5, -5)\n        ccms_world1_bgtex:SetPoint(\"BOTTOMRIGHT\", ccms_world1, \"BOTTOMRIGHT\", -10, 5)\n        ccms_world1_bgtex:SetTexture(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n        ccms_world1_bgtex:SetGradient(\"Vertical\", CreateColor(0, 0, 0, 0), CreateColor(0.64, 0.21, 0.93, .2))\n        ccms_world1_bgtex:Show()\n        \n        local ccms_world1_tex1 = _G[\"ccms_world1_tex1\"] or ccms_world1:CreateTexture(\"ccms_world1_tex1\", \"ARTWORK\", nil)\n        ccms_world1_tex1:SetPoint(\"TOPLEFT\", ccms_world1, \"TOPLEFT\",0 ,0);\n        ccms_world1_tex1:SetAtlas(\"weeklyrewards-icon-unlocked\", true);\n        ccms_world1_tex1:SetScale(.8)\n        ccms_world1_tex1:Hide()\n        \n        local ccms_world1_tex2 = _G[\"ccms_world1_tex2\"] or ccms_world1:CreateTexture(\"ccms_world1_tex2\", \"ARTWORK\", nil)\n        ccms_world1_tex2:SetPoint(\"BOTTOMLEFT\", ccms_world1, \"BOTTOMLEFT\",60 ,3);\n        ccms_world1_tex2:SetAtlas(\"weeklyrewards-orb-locked\", true);\n        ccms_world1_tex2:SetScale(.5)\n        ccms_world1_tex2:Show()    \n        \n        local ccms_world1_tex3 = _G[\"ccms_world1_tex3\"] or ccms_world1:CreateTexture(\"ccms_world1_tex3\", \"ARTWORK\", nil, 0)\n        ccms_world1_tex3:SetPoint(\"BOTTOMLEFT\", ccms_world1, \"BOTTOMLEFT\",4,10);\n        ccms_world1_tex3:SetTexture(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_AlphaGradient.tga\")\n        ccms_world1_tex3:SetGradient(\"Horizontal\", CreateColor(0.64, 0.21, 0.93, .5), CreateColor(0, 0, 0, 1)) -- Purple (Epic)\n        ccms_world1_tex3:SetSize(140,32)\n        ccms_world1_tex3:Hide()  \n        \n        local ccms_world1_tex4 = _G[\"ccms_world1_tex4\"] or ccms_world1:CreateTexture(\"ccms_world1_tex4\", \"ARTWORK\", nil, 2)\n        ccms_world1_tex4:SetPoint(\"BOTTOMLEFT\", ccms_world1, \"BOTTOMLEFT\",28,10);\n        ccms_world1_tex4:SetTexture(\"Interface\\\\AddOns\\\\WeakAuras\\\\Media\\\\Textures\\\\Square_FullWhite.tga\")\n        ccms_world1_tex4:SetSize(32,32)\n        ccms_world1_tex4:Hide()        \n        \n        local ccms_world1_fs1 = _G[\"ccms_world1_fs1\"] or  ccms_world1:CreateFontString(\"ccms_world1_fs1\")\n        ccms_world1_fs1:SetPoint(\"TOPRIGHT\", ccms_world1, \"TOPRIGHT\",-8 ,-7);\n        ccms_world1_fs1:SetSize(165, 20)\n        ccms_world1_fs1:SetFont(WA_Font, (c.fontsize or 10), textoptions);\n        ccms_world1_fs1:SetJustifyH(\"LEFT\")\n        ccms_world1_fs1:SetText(format(WEEKLY_REWARDS_THRESHOLD_WORLD, 2))\n        ccms_world1_fs1:SetText(CreateColor(0.62, 0.62, 0.62, .4):WrapTextInColorCode(format(WEEKLY_REWARDS_THRESHOLD_WORLD, 2))) \n        ccms_world1_fs1:Show()\n      